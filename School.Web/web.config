<?xml version="1.0" encoding="utf-8"?>
<!--
  Puts School.Web and School.API behind ONE hostname and ONE port.

  Why this file exists
  ────────────────────
  The browser reaches the API through /api on the same origin as the page
  (see API_BASE in wwwroot/js/common.js). That is not a preference: Cloudflare
  only proxies a fixed set of ports and 5266 is not one of them, and a page
  served over https may not call an http address at all. Routing /api through
  this site is what gives one certificate, one open port, and no CORS.

  Without the rule below, a request for /api/... falls through to School.Web
  itself, where the session guard in Program.cs redirects it to /EasySchool/login.
  The browser then receives HTML where it expected JSON, and every screen
  reports "API not available".

  REQUIRED on the server before deploying this file
  ─────────────────────────────────────────────────
    1. URL Rewrite 2.1                (iis.net)
    2. Application Request Routing 3.0 (iis.net)
    3. IIS Manager -> server node -> Application Request Routing Cache
       -> Server Proxy Settings -> tick "Enable proxy"

  Step 3 is easy to miss: without it the rewrite is accepted but every /api
  call returns 404, because IIS refuses to forward to another address.

  If URL Rewrite is NOT installed, IIS rejects the whole file with
  HTTP 500.19 ("unrecognized configuration section rewrite") and the entire
  site goes down — not just /api. Install the modules first.

  The <aspNetCore> handler is added automatically during publish; it is
  deliberately not written here so the SDK stays in charge of it.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>

        <!--
          /api/anything  ->  http://localhost:5266/api/anything

          localhost on purpose: School.API should be bound to 127.0.0.1 only,
          so it cannot be reached from outside except through this site.

          stopProcessing stops any later rule from touching an API call.
        -->
        <rule name="ProxyToSchoolApi" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:5266/api/{R:1}" />
        </rule>

      </rules>
    </rewrite>
  </system.webServer>
</configuration>
