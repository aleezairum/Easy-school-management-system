@{
    Layout = null;
    var voucherId = ViewData["VoucherId"];
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8" />
    <title>Fee Receipt Voucher</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #e0e0e0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 20px;
        }

        .print-container {
            background: white;
            border-radius: 12px;
            padding: 30px 40px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
            text-align: center;
            max-width: 450px;
            width: 100%;
        }

        .print-container h2 {
            font-size: 20px;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 6px;
        }

        .print-container p {
            font-size: 13px;
            color: #64748b;
            margin-bottom: 24px;
        }

        .voucher-id {
            font-size: 14px;
            color: #334155;
            margin-bottom: 20px;
            font-weight: 600;
        }

        .btn-group {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .btn-group button {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            transition: opacity 0.2s;
        }

        .btn-group button:hover {
            opacity: 0.85;
        }

        .btn-group button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .btn-thermal {
            background: #008649;
            color: white;
        }

        .btn-a4 {
            background: #1d4ed8;
            color: white;
        }

        .btn-close-page {
            background: #64748b;
            color: white;
        }

        .icon {
            font-size: 18px;
        }

        .status-msg {
            font-size: 12px;
            color: #64748b;
            margin-top: 16px;
            min-height: 18px;
        }

        .spinner {
            display: inline-block;
            width: 14px;
            height: 14px;
            border: 2px solid #94a3b8;
            border-top-color: transparent;
            border-radius: 50%;
            animation: spin 0.6s linear infinite;
            vertical-align: middle;
            margin-right: 6px;
        }

        @@keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    <div class="print-container">
        <h2>Fee Receipt Voucher</h2>
        <p>Select format to print on default printer</p>
        <div class="voucher-id" id="voucherInfo">Voucher #<span id="vid">@voucherId</span></div>
        <div class="btn-group">
            <button class="btn-thermal" id="btnThermal" onclick="printDirect('thermal')">
                <span class="icon">&#x1F5A8;</span> Thermal Print (80mm)
            </button>
            <button class="btn-a4" id="btnA4" onclick="printDirect('a4')">
                <span class="icon">&#x1F4C4;</span> A4 Print
            </button>
            <button class="btn-close-page" onclick="window.close()">Close</button>
        </div>
        <div class="status-msg" id="statusMsg"></div>
    </div>

    <!-- Hidden iframe for printing -->
    <iframe id="printFrame" style="position:absolute;left:-9999px;width:0;height:0;border:none;"></iframe>

    <script src="~/js/common.js"></script>
    <script>
        const pathParts = window.location.pathname.split('/').filter(Boolean);
        const voucherId = parseInt(pathParts[pathParts.length - 1]) || @(voucherId ?? 0);

        async function printDirect(type) {
            const btnThermal = document.getElementById('btnThermal');
            const btnA4 = document.getElementById('btnA4');
            const statusMsg = document.getElementById('statusMsg');

            // Disable buttons while loading
            btnThermal.disabled = true;
            btnA4.disabled = true;
            statusMsg.innerHTML = '<span class="spinner"></span> Loading receipt...';

            try {
                const response = await fetch(`${API_BASE}/FeeVoucher/ReceiptPdf/${voucherId}?type=${type}`);
                if (!response.ok) {
                    statusMsg.textContent = 'Error: Could not load receipt.';
                    btnThermal.disabled = false;
                    btnA4.disabled = false;
                    return;
                }

                const blob = await response.blob();
                const blobUrl = URL.createObjectURL(blob);
                const printFrame = document.getElementById('printFrame');

                printFrame.onload = function () {
                    statusMsg.innerHTML = '<span class="spinner"></span> Sending to printer...';
                    // Small delay to ensure PDF is fully rendered in the iframe
                    setTimeout(function () {
                        try {
                            printFrame.contentWindow.focus();
                            printFrame.contentWindow.print();
                        } catch (e) {
                            // Fallback: open in new window for printing
                            const w = window.open(blobUrl);
                            if (w) {
                                w.onload = function () { w.print(); };
                            }
                        }
                        statusMsg.textContent = 'Print dialog opened.';
                        btnThermal.disabled = false;
                        btnA4.disabled = false;
                    }, 500);
                };

                printFrame.src = blobUrl;

            } catch (err) {
                console.error(err);
                statusMsg.textContent = 'Error: ' + err.message;
                btnThermal.disabled = false;
                btnA4.disabled = false;
            }
        }

        // Auto-print if printer param is passed
        const urlParams = new URLSearchParams(window.location.search);
        const printerArg = urlParams.get('printer');
        if (printerArg === 'thermal') {
            printDirect('thermal');
        } else if (printerArg === 'normal') {
            printDirect('a4');
        }
    </script>
</body>
</html>
