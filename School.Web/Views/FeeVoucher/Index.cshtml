@{
    ViewData["Title"] = "Fee Vouchers";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@section Styles {
    <style>
        .main-card {
            border: none;
            border-radius: 10px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.08);
            overflow: hidden;
        }

        .top-bar {
            background: linear-gradient(135deg, #008649 0%, #005f33 100%);
            color: white;
        }

        .page-icon {
            width: 34px;
            height: 34px;
            background: rgba(255,255,255,0.2);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .page-title {
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 0.3px;
        }

        .page-subtitle {
            font-size: 10.5px;
            opacity: 0.8;
            margin-top: 2px;
        }

        .btn-add {
            background: rgba(255,255,255,0.15);
            color: white;
            border: 1px solid rgba(255,255,255,0.3);
            border-radius: 6px;
            font-size: 11.5px;
            font-weight: 600;
            padding: 5px 12px;
            white-space: nowrap;
        }

            .btn-add:hover {
                background: rgba(255,255,255,0.25);
                color: white;
            }

        .section-card {
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            overflow: hidden;
            margin-top: 10px;
        }

        .section-header {
            background: #f8fafc;
            padding: 6px 12px;
            font-size: 11.5px;
            font-weight: 600;
            color: #475569;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }

        .filter-label-group {
            font-size: 10.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 8px;
        }

        .server-label {
            color: #008649;
        }

        .btn-search {
            background: linear-gradient(135deg, #008649, #005f33);
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 11.5px;
            font-weight: 600;
            padding: 4px 12px;
            white-space: nowrap;
        }

            .btn-search:hover {
                opacity: 0.9;
                color: white;
            }

        .btn-clear-f {
            background: #f1f5f9;
            border: 1px solid #e2e8f0;
            color: #64748b;
            border-radius: 5px;
            font-size: 11.5px;
            font-weight: 600;
            padding: 4px 10px;
            white-space: nowrap;
        }

            .btn-clear-f:hover {
                background: #e2e8f0;
            }

        /* ════ Grid top bar — wraps if needed, NO horizontal scroll ════ */
        .grid-top-bar {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px 12px;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            flex-wrap: wrap;
        }

        /* LEFT — title + count badge */
        .grid-top-left {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 11.5px;
            font-weight: 600;
            color: #475569;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            flex-shrink: 0;
        }

        /* CENTER — summary cards */
        .grid-top-center {
            display: none;
            align-items: center;
            justify-content: center;
            gap: 10px;
            flex-shrink: 0; /* never compress */
        }

        .summary-item {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-radius: 7px;
            padding: 3px 10px;
            text-align: center;
            min-width: 80px;
        }

            .summary-item .s-label {
                font-size: 9px;
                font-weight: 600;
                color: #64748b;
                text-transform: uppercase;
                letter-spacing: 0.3px;
            }

            .summary-item .s-val {
                font-size: 12.5px;
                font-weight: 700;
                color: #166534;
                line-height: 1.3;
                white-space: nowrap;
            }

        /* RIGHT — client filters, pushed to end */
        .grid-top-right {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-left: auto;
            flex-wrap: wrap;
        }

        .grid-filter-input {
            border: 1px solid #e2e8f0;
            border-radius: 5px;
            font-size: 11px;
            padding: 3px 8px;
            transition: all 0.2s;
            background: white;
            min-width: 0;
        }

            .grid-filter-input:focus {
                border-color: #008649;
                box-shadow: 0 0 0 2px rgba(0,134,73,0.1);
                outline: none;
            }

        /* ════ Table ════ */
        .voucher-table thead th {
            background: #f8fafc;
            font-size: 10.5px;
            font-weight: 600;
            color: #64748b;
            padding: 5px 8px;
            border-bottom: 2px solid #e2e8f0;
            white-space: nowrap;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .voucher-table tbody td {
            font-size: 11px;
            padding: 4px 8px;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
        }

        .voucher-table tbody tr:hover {
            background: #f0fdf4;
        }

        .vno-badge {
            background: #f0fdf4;
            color: #008649;
            font-weight: 700;
            font-size: 10.5px;
            padding: 1px 7px;
            border-radius: 5px;
            border: 1px solid #bbf7d0;
            display: inline-block;
        }

        .pm-badge {
            background: #eff6ff;
            color: #1d4ed8;
            font-size: 10px;
            font-weight: 600;
            padding: 1px 7px;
            border-radius: 20px;
            white-space: nowrap;
        }

        /* Received By badge */
        .user-badge {
            background: #fef3c7;
            color: #92400e;
            font-size: 10px;
            font-weight: 600;
            padding: 1px 7px;
            border-radius: 20px;
            white-space: nowrap;
            border: 1px solid #fde68a;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        /* ════ Action buttons ════ */
        .actions-cell {
            display: flex;
            align-items: center;
            gap: 4px;
            flex-wrap: nowrap;
        }

        .btn-action {
            border: none;
            border-radius: 5px;
            padding: 3px 7px;
            font-size: 10.5px;
            font-weight: 600;
            color: white;
            transition: all 0.15s;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .btn-action:hover {
                transform: translateY(-1px);
                color: white;
            }

        .btn-print {
            background: linear-gradient(135deg, #008649, #005f33);
        }

        .btn-delete {
            background: linear-gradient(135deg, #dc2626, #b91c1c);
        }

        .btn-print:hover {
            box-shadow: 0 3px 8px rgba(0,134,73,0.3);
        }

        .btn-delete:hover {
            box-shadow: 0 3px 8px rgba(220,38,38,0.3);
        }

        .badge-count {
            background: #008649;
            color: white;
            font-size: 10px;
            padding: 1px 7px;
            border-radius: 20px;
            font-weight: 600;
        }
    </style>
}

<div class="container-fluid px-0">
    <div id="alertContainer"></div>

    <div class="card main-card">
        <div class="card-body p-0">

            <!-- ════ TOP BAR ════ -->
            <div class="top-bar d-flex justify-content-between align-items-center px-4 py-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="page-icon"><i class="bi bi-receipt"></i></div>
                    <div>
                        <div class="page-title">Fee Vouchers</div>
                        <div class="page-subtitle">Payment Records</div>
                    </div>
                </div>
                <a href="/feevoucher/form" class="btn btn-add">
                    <i class="bi bi-plus-lg me-1"></i> Receive Payment
                </a>
            </div>

            <div class="px-4 pb-4">

                <!-- ════ FILTER CARD ════ -->
                <div class="section-card">
                    <div class="section-header">
                        <i class="bi bi-funnel me-2"></i>Filters
                    </div>
                    <div class="p-3">
                        <div class="filter-label-group server-label">
                            <i class="bi bi-server"></i> Server Filters
                            <span style="font-weight:400; color:#94a3b8; font-size:10px;">
                                (Search button press karo)
                            </span>
                        </div>
                        <div class="row g-2 align-items-end">
                            <div class="col-lg-2 col-md-4 col-sm-6">
                                <label class="form-label">Date From</label>
                                <input type="date" class="form-control" id="dateFrom" />
                            </div>
                            <div class="col-lg-2 col-md-4 col-sm-6">
                                <label class="form-label">Date To</label>
                                <input type="date" class="form-control" id="dateTo" />
                            </div>
                            <div class="col-lg-2 col-md-4 col-sm-6">
                                <label class="form-label">Class</label>
                                <select class="form-select" id="filterClass"
                                        onchange="onFilterClassChange()">
                                    <option value="">All Classes</option>
                                </select>
                            </div>
                            <div class="col-lg-2 col-md-4 col-sm-6">
                                <label class="form-label">Section</label>
                                <select class="form-select" id="filterSection" disabled>
                                    <option value="">All Sections</option>
                                </select>
                            </div>
                            <div class="col-lg-2 col-md-4 col-sm-6">
                                <label class="form-label">Student</label>
                                <select class="form-select" id="filterStudent">
                                    <option value="">All Students</option>
                                </select>
                            </div>
                            <div class="col-lg-2 col-md-4 col-sm-6">
                                <div class="d-flex gap-2">
                                    <button class="btn btn-search flex-fill"
                                            onclick="loadVouchers()">
                                        <i class="bi bi-search me-1"></i> Search
                                    </button>
                                    <button class="btn btn-clear-f"
                                            onclick="clearServerFilters()" title="Clear">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ════ GRID CARD ════ -->
                <div class="section-card">

                    <!-- Grid top bar: LEFT | CENTER | RIGHT — all on one row -->
                    <div class="grid-top-bar">

                        <!-- LEFT: title + badge -->
                        <div class="grid-top-left">
                            <i class="bi bi-table"></i>
                            Payment Records
                            <span id="gridCount" class="badge-count"></span>
                        </div>

                        <!-- CENTER: summary cards (shown after data loads) -->
                        <div class="grid-top-center" id="summaryBar">
                            <div class="summary-item">
                                <div class="s-label">Records</div>
                                <div class="s-val" id="summaryCount">0</div>
                            </div>
                            <div class="summary-item"
                                 style="background:#ecfdf5; border-color:#6ee7b7;">
                                <div class="s-label">Total Paid</div>
                                <div class="s-val" id="summaryAmount">Rs. 0.00</div>
                            </div>
                        </div>

                        <!-- RIGHT: search + method + user + clear — single row always -->
                        <div class="grid-top-right">

                            <!-- Search -->
                            <div style="position:relative; flex-shrink:0;">
                                <i class="bi bi-search"
                                   style="position:absolute; left:8px; top:50%;
                                          transform:translateY(-50%);
                                          color:#94a3b8; font-size:12px;
                                          pointer-events:none;"></i>
                                <input type="text" class="grid-filter-input"
                                       id="clientSearch"
                                       placeholder="Voucher#, Student, Father..."
                                       style="width:195px; padding-left:26px;"
                                       oninput="applyClientFilters()" />
                            </div>

                            <!-- Payment Method -->
                            <select class="grid-filter-input" id="clientPaymentMethod"
                                    style="width:130px;"
                                    onchange="applyClientFilters()">
                                <option value="">All Methods</option>
                            </select>

                            <!-- User / Received By -->
                            <select class="grid-filter-input" id="clientUser"
                                    style="width:130px;"
                                    onchange="applyClientFilters()">
                                <option value="">All Users</option>
                            </select>

                            <!-- Clear -->
                            <button class="btn btn-clear-f"
                                    style="padding:5px 10px; font-size:12px; flex-shrink:0;"
                                    onclick="clearClientFilters()" title="Clear filters">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Table -->
                    <div class="table-responsive">
                        <table class="table voucher-table mb-0">
                            <thead>
                                <tr>
                                    <th style="width:45px;">SR#</th>
                                    <th>Voucher #</th>
                                    <th>Date</th>
                                    <th>Student</th>
                                    <th>Class / Section</th>
                                    <th>Father Name</th>
                                    <th>Payment Method</th>
                                    <th class="text-end">Balance</th>
                                    <th class="text-end">Amount Paid</th>
                                    <th>Remarks</th>
                                    <th>Received By</th>
                                    <th style="width:90px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="voucherBody">
                                <tr>
                                    <td colspan="12" class="text-center text-muted py-5">
                                        <i class="bi bi-search me-2"></i>
                                        Select filters and click Search
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        /* ════════════════════════════════════════════
           STATE
        ════════════════════════════════════════════ */
        let allVouchers = [];
        let filtered    = [];

        /* ════════════════════════════════════════════
           INIT
        ════════════════════════════════════════════ */
        $(document).ready(function () {
            const now = new Date();
            const y   = now.getFullYear();
            const m   = String(now.getMonth() + 1).padStart(2, '0');
            const d   = String(now.getDate()).padStart(2, '0');
            $('#dateFrom').val(`${y}-${m}-${d}`);
            $('#dateTo').val(`${y}-${m}-${d}`);
            loadFilterDropdowns().then(() => loadVouchers());
        });

        /* ════════════════════════════════════════════
           LOAD DROPDOWNS — Classes, Payment Methods, Users
        ════════════════════════════════════════════ */
        async function loadFilterDropdowns() {
            try {
                const [classes, paymentMethods, users] = await Promise.all([
                    fetch(`${API_BASE}/class`).then(r => r.ok ? r.json() : []),
                    fetch(`${API_BASE}/PaymentMethod`).then(r => r.ok ? r.json() : []),
                    fetch(`${API_BASE}/SecUser`).then(r => r.ok ? r.json() : [])
                ]);

                classes.forEach(c =>
                    $('#filterClass').append(`<option value="${c.vid}">${c.vName}</option>`)
                );

                paymentMethods.forEach(p =>
                    $('#clientPaymentMethod').append(
                        `<option value="${p.vid}"
                                 data-name="${(p.vName || '').toLowerCase()}">
                            ${p.vName}
                        </option>`
                    )
                );

                users.forEach(u => {
                    const name = u.userFullName|| '-';
                    $('#clientUser').append(
                        `<option value="${u.vid}"
                                 data-name="${name.toLowerCase()}">
                            ${name}
                        </option>`
                    );
                });

                // Select logged-in user by default
                if (USER_ID) {
                    $('#clientUser').val(String(USER_ID)).trigger('change');
                }

            } catch (err) { console.error(err); }
        }

        /* ════════════════════════════════════════════
           CLASS → SECTION → STUDENT
        ════════════════════════════════════════════ */
        async function onFilterClassChange() {
            const classId = $('#filterClass').val();
            const secSel  = $('#filterSection');
            const stuSel  = $('#filterStudent');
            secSel.find('option:not(:first)').remove().end().prop('disabled', true);
            stuSel.find('option:not(:first)').remove();
            if (!classId) return;
            try {
                const [sections, students] = await Promise.all([
                    fetch(`${API_BASE}/section/byClass/${classId}`).then(r => r.ok ? r.json() : []),
                    fetch(`${API_BASE}/Student/students?classId=${classId}&sectionId=0`)
                        .then(r => r.ok ? r.json() : [])
                ]);
                sections.forEach(s =>
                    secSel.append(`<option value="${s.vid}">${s.vName}</option>`)
                );
                secSel.prop('disabled', false);
                students.forEach(s => {
                    const roll  = s.classRollNo || s.rollNo || '';
                    const label = `${s.name || '-'}${roll ? ' (' + roll + ')' : ''}`;
                    stuSel.append(`<option value="${s.vid}">${label}</option>`);
                });
            } catch (err) { console.error(err); }
        }

        /* ════════════════════════════════════════════
           LOAD VOUCHERS — SERVER
        ════════════════════════════════════════════ */
        async function loadVouchers() {
            const dateFrom  = $('#dateFrom').val();
            const dateTo    = $('#dateTo').val();
            const classId   = $('#filterClass').val();
            const sectionId = $('#filterSection').val();
            const studentId = $('#filterStudent').val();

            if (!dateFrom || !dateTo) {
                toastWarning('Please select Date From and Date To'); return;
            }

            $('#voucherBody').html(
                '<tr><td colspan="12" class="text-center text-muted py-4">' +
                '<span class="spinner-border spinner-border-sm me-2"></span>' +
                'Loading...</td></tr>'
            );

            const params = new URLSearchParams({ dateFrom, dateTo });
            if (classId)   params.append('classId',   classId);
            if (sectionId) params.append('sectionId', sectionId);
            if (studentId) params.append('studentId', studentId);

            try {
                const response = await fetch(`${API_BASE}/FeeVoucher?${params}`);
                if (!response.ok) { showGridError(); return; }
                allVouchers = await response.json();
                $('#clientSearch').val('');
                $('#clientPaymentMethod').val('');
                applyClientFilters();
            } catch (err) {
                console.error(err); showGridError();
            }
        }

        /* ════════════════════════════════════════════
           CLIENT FILTERS — search + method + user
        ════════════════════════════════════════════ */
        function applyClientFilters() {
            const searchVal = ($('#clientSearch').val()        || '').toLowerCase().trim();
            const pmVal     = ($('#clientPaymentMethod').val() || '').trim();
            const pmName    = ($('#clientPaymentMethod option:selected').attr('data-name') || '').trim();
            const userVal   = ($('#clientUser').val()          || '').trim();
            const userName  = ($('#clientUser option:selected').attr('data-name') || '').trim();

            filtered = allVouchers.filter(v => {

                const matchSearch = !searchVal || [
                    v.vNo, v.studentName, v.parentName,
                    v.sectionName, v.remarks, v.userFullName
                ].some(f => (f || '').toLowerCase().includes(searchVal));

                const matchPM = !pmVal ||
                    (v.paymentMethod || '').toLowerCase() === pmName;

                const matchUser = !userVal ||
                    (v.userFullName || '').toLowerCase() === userName;

                return matchSearch && matchPM && matchUser;
            });

            renderGrid(filtered);
            updateSummary(filtered);
        }

        /* ════════════════════════════════════════════
           RENDER GRID
        ════════════════════════════════════════════ */
        function renderGrid(data) {
            $('#gridCount').text(data.length || '');
            if (!data.length) {
                $('#voucherBody').html(
                    '<tr><td colspan="12" class="text-center text-muted py-5">' +
                    '<i class="bi bi-inbox me-2"></i>No payment records found</td></tr>'
                );
                return;
            }

            let rows = '';
            data.forEach((v, i) => {
                const id      = v.vid || v.vID || v.VID || 0;
                const safeVNo = (v.vNo || v.VNo || '').replace(/'/g, "\\'");

                const receivedBy   = v.userFullName || '';
                const receivedCell = receivedBy
                    ? `<span class="user-badge">
                           <i class="bi bi-person-check" style="font-size:10px;"></i>
                           ${receivedBy}
                       </span>`
                    : `<span style="color:#94a3b8; font-size:12px;">—</span>`;

                rows += `
                    <tr>
                        <td style="color:#94a3b8; font-size:12px;">${i + 1}</td>
                        <td><span class="vno-badge">${v.vNo || v.VNo || '-'}</span></td>
                        <td style="white-space:nowrap;">
                            ${fmtDay(v.vDate || v.VDate)}
                            <div style="color:#94a3b8; font-size:11px;">${fmtTime(v.insertedDate || v.InsertedDate)}</div>
                        </td>
                        <td style="font-weight:600;">${v.studentName || v.StudentName || '-'}</td>
                        <td style="color:#64748b; font-size:12px;">${v.sectionName || v.SectionName || '-'}</td>
                        <td>${v.parentName || v.ParentName || '-'}</td>
                        <td><span class="pm-badge">${v.paymentMethod || v.PaymentMethod || '-'}</span></td>
                        <td class="text-end" style="color:#dc2626; font-weight:600;">
                            ${fmt(v.balanceAmount || v.BalanceAmount)}
                        </td>
                        <td class="text-end" style="color:#008649; font-weight:700;">
                            Rs.${fmt(v.paidAmount || v.PaidAmount)}
                        </td>
                        <td style="color:#64748b; font-size:12px;">${v.remarks || v.Remarks || '-'}</td>
                        <td>${receivedCell}</td>
                        <td>
                            <div class="actions-cell">
                                <button class="btn-action btn-print"
                                        onclick="printVoucher(${id})"
                                        title="Print">
                                    <i class="bi bi-printer"></i>
                                </button>
                                <button class="btn-action btn-delete"
                                        onclick="deleteVoucher(${id}, '${safeVNo}')"
                                        title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>`;
            });

            $('#voucherBody').html(rows);
        }

        /* ════════════════════════════════════════════
           SUMMARY
        ════════════════════════════════════════════ */
        function updateSummary(data) {
            const seen = new Set();
            let total  = 0;
            let count  = 0;
            data.forEach(v => {
                const id = v.vid || v.vID || v.VID || 0;
                if (!seen.has(id)) {
                    seen.add(id);
                    total += Number(v.paidAmount || v.PaidAmount || 0);
                    count++;
                }
            });
            $('#summaryCount').text(count);
            $('#summaryAmount').text('Rs. ' + fmt(total));
            $('#summaryBar').css('display', 'flex');
        }

        /* ════════════════════════════════════════════
           DELETE
        ════════════════════════════════════════════ */
        async function deleteVoucher(vid, vno) {
            const confirmed = await confirmDelete({
                title: `Delete ${vno}?`,
                html:  'Student fee balances will be recalculated.'
            });

            if (!confirmed) return;

            try {
                const response = await fetch(`${API_BASE}/FeeVoucher/${vid}`,
                    { method: 'DELETE' });
                const result = await response.json();
                if (result.returnCode === 200) {
                    toastSuccess(result.returnMessage || 'Deleted successfully');
                    loadVouchers();
                } else {
                    toastError(result.returnMessage || 'Delete failed');
                }
            } catch (err) {
                console.error(err);
                toastError('Error deleting voucher');
            }
        }

        /* ════════════════════════════════════════════
           PRINT
        ════════════════════════════════════════════ */
        function printVoucher(vid) {
            window.open(`/feevoucher/print/${vid}?printer=thermal`, '_blank');
        }

        /* ════════════════════════════════════════════
           CLEAR FILTERS
        ════════════════════════════════════════════ */
        function clearServerFilters() {
            const now = new Date();
            const y   = now.getFullYear();
            const m   = String(now.getMonth() + 1).padStart(2, '0');
            const d   = String(now.getDate()).padStart(2, '0');
            $('#dateFrom').val(`${y}-${m}-01`);
            $('#dateTo').val(`${y}-${m}-${d}`);
            $('#filterClass').val('');
            $('#filterSection').val('')
                .prop('disabled', true).find('option:not(:first)').remove();
            $('#filterStudent').val('').find('option:not(:first)').remove();
            loadVouchers();
        }

        function clearClientFilters() {
            $('#clientSearch').val('');
            $('#clientPaymentMethod').val('');
            $('#clientUser').val('');
            applyClientFilters();
        }

        /* ════════════════════════════════════════════
           HELPERS
        ════════════════════════════════════════════ */
        function showGridError() {
            $('#voucherBody').html(
                '<tr><td colspan="12" class="text-center text-danger py-5">' +
                '<i class="bi bi-exclamation-triangle me-2"></i>' +
                'Error loading records</td></tr>'
            );
        }

        function fmt(val) {
            return (val || 0).toLocaleString('en-PK', {
                minimumFractionDigits: 2, maximumFractionDigits: 2
            });
        }

        // Shadowed the shared fmtDate() from common.js; kept only for the "-"
        // this list prints in place of a missing date.
        function fmtDay(dateStr) {
            return dateStr ? (fmtDate(dateStr) || '-') : '-';
        }

        // Time-of-day (e.g. "11:53 AM") taken from the voucher's InsertedDate,
        // since VDate is a date-only value.
        function fmtTime(dateStr) {
            if (!dateStr) return '';
            const d = new Date(dateStr);
            if (isNaN(d)) return '';
            let h = d.getHours();
            const m = d.getMinutes().toString().padStart(2, '0');
            const ampm = h >= 12 ? 'PM' : 'AM';
            h = h % 12; if (h === 0) h = 12;
            return h.toString().padStart(2, '0') + ':' + m + ' ' + ampm;
        }

    </script>
}
