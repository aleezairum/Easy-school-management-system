@{
    ViewData["Title"] = "Receive Payment";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid">
    <div id="alertContainer"></div>

    <div class="card" style="border-radius: 16px; border: none; box-shadow: 0 4px 20px rgba(0,0,0,0.08);">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 style="font-weight:700; color:#1e293b; margin:0;">
                    <i class="bi bi-receipt me-2 text-success"></i>Receive Payment
                    <small id="voucherNoDisplay" class="text-muted ms-2" style="font-size:13px; font-weight:400;">New Voucher</small>
                </h5>
                <a href="/feevoucher" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            </div>

            <!-- FIND STUDENT -->
            <div class="filter-section find-student-section" style="background: #f8fafc; border-radius: 12px; padding: 20px; margin-bottom: 20px;">
                <h6 class="mb-3" style="font-weight:600; color:#475569; font-size:16px;">
                    <i class="bi bi-search me-2"></i>Find Student
                    <span id="loadingBadge" class="ms-2" style="display:none;">
                        <span class="spinner-border spinner-border-sm text-success"></span>
                        <small class="text-muted ms-1">Loading...</small>
                    </span>
                </h6>
                <div class="row g-3 align-items-end">
                    <div class="col-lg-4 col-md-6 col-12">
                        <label for="classId" class="form-label">Class</label>
                        <select class="form-select form-select-lg" id="classId" onchange="loadSections()">
                            <option value="">-- All Classes --</option>
                        </select>
                    </div>
                    <div class="col-lg-4 col-md-6 col-12">
                        <label for="sectionId" class="form-label">Section</label>
                        <select class="form-select form-select-lg" id="sectionId" disabled onchange="loadStudents()">
                            <option value="">-- All Sections --</option>
                        </select>
                    </div>
                    <div class="col-lg-4 col-md-6 col-12">
                        <label for="rollNo" class="form-label">Roll No</label>
                        <select class="form-select form-select-lg" id="rollNo" onchange="selectStudentByRoll()">
                            <option value="">All</option>
                        </select>
                    </div>
                    <div class="col-lg-4 col-md-6 col-12">
                        <label for="studentId" class="form-label">Student Name</label>
                        <select class="form-select form-select-lg" id="studentId" onchange="selectRollByStudent()">
                            <option value="">-- All Students --</option>
                        </select>
                    </div>
                    <div class="col-lg-4 col-md-6 col-12">
                        <label class="form-label">Father Name</label>
                        <select class="form-select form-select-lg" id="filterFatherName" onchange="selectStudentByFather()">
                            <option value="">-- All --</option>
                        </select>
                    </div>
                    <div class="col-lg-4 col-md-6 col-12">
                        <label class="form-label">Father CNIC</label>
                        <select class="form-select form-select-lg" id="filterFatherCNIC" onchange="selectStudentByCNIC()">
                            <option value="">-- All --</option>
                        </select>
                    </div>
                    <div class="col-12 d-flex justify-content-end mt-2">
                        <button type="button" class="btn btn-primary btn-lg px-4" id="btnSearch"
                                onclick="searchStudent()" title="Load Fees">
                            <i class="bi bi-search me-1"></i> Search
                        </button>
                    </div>
                </div>

                <!-- Student Info Bar -->
                <div id="studentInfoRow" style="display:none; margin-top:14px;">
                    <div style="display:flex; flex-wrap:wrap; gap:8px; padding:10px 14px;
                                background:#f0fdf4; border-radius:8px; border:1px solid #bbf7d0;">
                        <span class="info-chip"><i class="bi bi-person me-1"></i><span id="infoStudentName">—</span></span>
                        <span class="info-chip"><i class="bi bi-people me-1"></i>Father: <span id="infoFatherName">—</span></span>
                        <span class="info-chip"><i class="bi bi-hash me-1"></i>Roll: <span id="infoRollNo">—</span></span>
                        <span class="info-chip"><i class="bi bi-building me-1"></i><span id="infoClass">—</span></span>
                        <span class="info-chip"><i class="bi bi-diagram-3 me-1"></i><span id="infoSection">—</span></span>
                        <span class="info-chip" style="background:#166534; color:white; border-color:#166534;">
                            <i class="bi bi-wallet2 me-1"></i>Balance: <span id="infoBalance">0.00</span>
                        </span>
                    </div>
                </div>
            </div>

            <!-- PENDING FEES -->
            <div class="grid-section mb-3">
                <div class="d-flex align-items-center mb-3">
                    <h6 style="font-weight:600; color:#475569; margin:0;">
                        <i class="bi bi-table me-2"></i>Pending Fees
                        <span id="feeGridCount"
                              style="background:#008649; color:white; font-size:11px;
                                     padding:2px 8px; border-radius:20px; font-weight:600;"
                              class="ms-2"></span>
                    </h6>
                    <div class="ms-auto d-flex gap-2">
                        <button class="btn btn-sm btn-outline-primary" onclick="selectAllFees(true)">Select All</button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="selectAllFees(false)">Clear</button>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover" id="feeTable">
                        <thead>
                            <tr style="background:#f8fafc;">
                                <th style="width:40px;">
                                    <input type="checkbox" id="selectAllCheck"
                                           onchange="selectAllFees(this.checked)">
                                </th>
                                <th>Month</th>
                                <th>Student</th>
                                <th>Class</th>
                                <th>Section</th>
                                <th>Grade</th>
                                <th>Fee Type</th>
                                <th class="text-end">Fee Amount</th>
                                <th class="text-end">Cleared</th>
                                <th class="text-end">Pending</th>
                                <th class="text-end" style="min-width:120px;">Paid Amount</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody id="feeGridBody">
                            <tr>
                                <td colspan="12" class="text-center text-muted py-4">
                                    <i class="bi bi-person-x me-2"></i>
                                    Select a student and click Search to load fees
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- PAYMENT DETAILS -->
            <div class="filter-section" style="background: #f8fafc; border-radius: 12px; padding: 20px; margin-bottom: 20px;">
                <h6 class="mb-3" style="font-weight:600; color:#475569;">
                    <i class="bi bi-cash-stack me-2"></i>Payment Details
                </h6>
                <div class="row g-3">
                    <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                        <label class="form-label">Voucher No</label>
                        <input type="text" class="form-control" id="voucherNo"
                               readonly placeholder="Auto generated" />
                    </div>
                    <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                        <label class="form-label">Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="paymentDate" />
                    </div>
                    <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                        <label class="form-label">Payment Method <span class="text-danger">*</span></label>
                        <select class="form-select" id="paymentMethod">
                            <option value="">-- Select --</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                        <label class="form-label">Father's Name</label>
                        <input type="text" class="form-control" id="fatherNameDisplay"
                               readonly placeholder="Auto filled" />
                    </div>
                    <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                        <label class="form-label">Balance</label>
                        <input type="text" class="form-control text-danger fw-bold"
                               id="paymentBalance" readonly value="0.00" />
                    </div>
                    <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                        <label class="form-label">Amount</label>
                        <input type="number" class="form-control fw-bold"
                               id="totalAmount" readonly value="0.00" />
                    </div>
                    <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                        <label class="form-label">Paid Amount <span class="text-danger">*</span></label>
                        <input type="number" class="form-control text-success fw-bold"
                               id="paidAmount" placeholder="0.00"
                               oninput="distributeFromTotal()" />
                    </div>
                    <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                        <label class="form-label">Remaining</label>
                        <input type="text" class="form-control fw-bold"
                               id="remainingAmount" readonly value="0.00" />
                    </div>
                    <div class="col-lg-4 col-md-6 col-12">
                        <label class="form-label">Remarks</label>
                        <input type="text" class="form-control" id="remarks"
                               placeholder="Optional note..." />
                    </div>
                </div>
            </div>

            <!-- ACTION BAR -->
            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                <div class="d-flex gap-3 align-items-center">
                    <label class="form-label mb-0" style="color:#475569; font-size:13px;">Printer:</label>
                    <div class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="radio" name="printerType"
                               id="printerThermal" value="thermal" checked>
                        <label class="form-check-label" for="printerThermal">Thermal</label>
                    </div>
                    <div class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="radio" name="printerType"
                               id="printerNormal" value="normal">
                        <label class="form-check-label" for="printerNormal">Normal</label>
                    </div>
                    <div class="form-check form-check-inline mb-0 ms-2">
                        <input class="form-check-input" type="checkbox" id="sendMessage">
                        <label class="form-check-label" for="sendMessage">Send Message</label>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a href="/feevoucher" class="btn btn-secondary">
                        <i class="bi bi-x-lg me-1"></i> Close
                    </a>
                    <button type="button" class="btn btn-primary" id="btnSave" onclick="saveVoucher(false)">
                        <i class="bi bi-check-lg me-1"></i> Save
                    </button>
                    <button type="button" class="btn btn-info text-white" id="btnSavePrint" onclick="saveVoucher(true)">
                        <i class="bi bi-printer me-1"></i> Save & Print
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

@section Styles {
    <style>
        .find-student-section h6 {
            font-size: 14px !important;
        }

        .find-student-section .form-label {
            font-size: 15px !important;
            font-weight: 600 !important;
            color: #334155 !important;
            margin-bottom: 6px !important;
        }

        .find-student-section .form-select,
        .find-student-section .form-select-lg,
        .find-student-section .form-control,
        .find-student-section .form-control-lg {
            font-size: 16px !important;
            padding: 10px 14px !important;
            height: 48px !important;
            line-height: 1.4 !important;
        }

        /* Select2 rendered dropdowns — layout auto-wraps native <select> */
        .find-student-section .select2-container--bootstrap-5 .select2-selection {
            min-height: 48px !important;
            height: 48px !important;
            padding: 6px 12px !important;
            font-size: 16px !important;
        }

        .find-student-section .select2-container--bootstrap-5 .select2-selection--single .select2-selection__rendered {
            font-size: 16px !important;
            line-height: 34px !important;
            padding-left: 0 !important;
        }

        .find-student-section .select2-container--bootstrap-5 .select2-selection--single .select2-selection__placeholder {
            font-size: 16px !important;
            line-height: 34px !important;
        }

        .find-student-section .select2-container--bootstrap-5 .select2-selection__arrow {
            height: 46px !important;
        }

        /* Select2 dropdown popup (rendered at body level) — bigger list text */
        .find-student-dropdown .select2-results__option {
            font-size: 17px !important;
            padding: 10px 14px !important;
            line-height: 1.4 !important;
        }

        .find-student-dropdown .select2-search--dropdown .select2-search__field {
            font-size: 16px !important;
            padding: 8px 12px !important;
        }

        .find-student-section .btn,
        .find-student-section .btn-lg {
            font-size: 16px !important;
            padding: 10px 24px !important;
        }

        .info-chip {
            font-size: 13px;
            color: #166534;
            background: white;
            padding: 4px 12px;
            border-radius: 20px;
            border: 1px solid #bbf7d0;
            font-weight: 500;
        }

        .selected-row {
            background: #f0fdf4 !important;
        }

        .paid-input {
            border: 1.5px solid #d1fae5;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            color: #16a34a;
            text-align: right;
            padding: 4px 8px;
            width: 110px;
            background: #f0fdf4;
            transition: border-color 0.2s;
        }

            .paid-input:focus {
                outline: none;
                border-color: #008649;
                background: white;
            }

            .paid-input.over-limit {
                border-color: #ef4444 !important;
                color: #ef4444 !important;
                background: #fef2f2 !important;
            }

            .paid-input:disabled {
                background: #f1f5f9;
                color: #94a3b8;
                border-color: #e2e8f0;
            }
    </style>
}

@section Scripts {
    <script>

        /* ════════════════════════════════════════════
           STATE
        ════════════════════════════════════════════ */
        let selectedStudent  = null;
        let selectedFees     = [];     // { vid, pendingAmount, paidAmount }
        let isSyncing        = false;
        let allStudents      = [];
        let isDistributing   = false;
        let isLoadingStudents = false;

        /* ════════════════════════════════════════════
           INIT
        ════════════════════════════════════════════ */
        $(document).ready(function () {
            // Override layout's applySelect2 so selects inside .find-student-section
            // get a custom dropdownCssClass — lets us style the popup list text bigger.
            // Layout's MutationObserver re-applies via window.applySelect2, so this
            // override holds across re-inits when options are loaded dynamically.
            if (typeof window.applySelect2 === 'function') {
                window.applySelect2 = function (el) {
                    const $el = $(el);
                    if ($el.hasClass('select2-hidden-accessible')) return;
                    const inFindStudent = $el.closest('.find-student-section').length > 0;
                    $el.select2({
                        theme: 'bootstrap-5',
                        placeholder: $el.find('option:first').text() || '-- Select --',
                        allowClear: true,
                        width: '100%',
                        dropdownParent: $el.closest('.modal').length ? $el.closest('.modal') : $(document.body),
                        dropdownCssClass: inFindStudent ? 'find-student-dropdown' : ''
                    });
                };
            }

            const d = new Date();
            $('#paymentDate').val(
                d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate())
            );
            loadDropdowns();
            loadStudents();
            loadNextVNo();
        });



                /* ════════════════════════════════════════════
           LOAD NEXT VOUCHER NO — on page load
        ════════════════════════════════════════════ */
        async function loadNextVNo() {
            try {
                const response = await fetch(`${API_BASE}/FeeVoucher/NextVNo`);
                if (response.ok) {
                    const data = await response.json();
                    $('#voucherNo').val(data.vNo || '');
                    $('#voucherNoDisplay').text(data.vNo || 'New Voucher');
                }
            } catch (error) {
                console.error('Error loading voucher no:', error);
            }
        }

        /* ════════════════════════════════════════════
           LOAD DROPDOWNS
        ════════════════════════════════════════════ */
        async function loadDropdowns() {
            try {
                const [classes, paymentMethods] = await Promise.all([
                    fetch(`${API_BASE}/class`).then(r => r.ok ? r.json() : []),
                    fetch(`${API_BASE}/PaymentMethod`).then(r => r.ok ? r.json() : [])
                ]);

                const classSelect = $('#classId');
                classSelect.find('option:not(:first)').remove();
                classes.forEach(c =>
                    classSelect.append(`<option value="${c.vid}">${c.vName}</option>`)
                );

                const pmSelect = $('#paymentMethod');
                pmSelect.find('option:not(:first)').remove();
                paymentMethods.forEach(p =>
                    pmSelect.append(`<option value="${p.vid}">${p.vName}</option>`)
                );
                const cashOption = paymentMethods.find(p =>
                p.vName.toLowerCase().includes('cash')
                );
                if (cashOption) {
                    $('#paymentMethod').val(cashOption.vid).trigger('change');
                }

            } catch (error) {
                console.error('Error loading dropdowns:', error);
            }
        }

        /* ════════════════════════════════════════════
           LOAD SECTIONS
        ════════════════════════════════════════════ */
        async function loadSections() {
            const classId = $('#classId').val();
            const sectionSelect = $('#sectionId');
            sectionSelect.find('option:not(:first)').remove();
            sectionSelect.prop('disabled', true);
            $('#sectionId').val('');
            await loadStudents();

            if (!classId) return;

            try {
                const response = await fetch(`${API_BASE}/section/byClass/${classId}`);
                if (response.ok) {
                    const sections = await response.json();
                    sections.forEach(s =>
                        sectionSelect.append(`<option value="${s.vid}">${s.vName}</option>`)
                    );
                    sectionSelect.prop('disabled', false);
                }
            } catch (error) {
                console.error('Error loading sections:', error);
            }
        }

        /* ════════════════════════════════════════════
           LOAD STUDENTS — fills all 4 find-dropdowns
           guard flag prevents duplicate/chain calls
        ════════════════════════════════════════════ */
        async function loadStudents() {
            if (isLoadingStudents) return;
            isLoadingStudents = true;

            const classId   = $('#classId').val()   || 0;
            const sectionId = $('#sectionId').val() || 0;

            $('#rollNo, #studentId, #filterFatherName, #filterFatherCNIC')
                .find('option:not(:first)').remove();

            try {
                const response = await fetch(
                    `${API_BASE}/Student/students?classId=${classId}&sectionId=${sectionId}`
                );
                if (!response.ok) return;

                allStudents = await response.json();
                if (!allStudents.length) return;

                allStudents.forEach(s => {
                    $('#rollNo').append(
                        `<option value="${s.vid}">${s.classRollNo || s.rollNo || '-'}</option>`
                    );
                    $('#studentId').append(
                        `<option value="${s.vid}">${s.name || '-'}</option>`
                    );
                    $('#filterFatherName').append(
                        `<option value="${s.vid}">${s.fatherName || '-'}</option>`
                    );
                    $('#filterFatherCNIC').append(
                        `<option value="${s.vid}">${s.fatherCNIC || '-'}</option>`
                    );
                });

            } catch (error) {
                console.error('Error loading students:', error);
            } finally {
                isLoadingStudents = false;
            }
        }

        /* ════════════════════════════════════════════
           SYNC ALL 4 DROPDOWNS — no trigger('change')
           to avoid loadStudents chain
        ════════════════════════════════════════════ */
        function syncDropdowns(vid) {
            if (isSyncing) return;
            isSyncing = true;
            $('#rollNo, #studentId, #filterFatherName, #filterFatherCNIC').val(vid).trigger('change');
            isSyncing = false;
        }

        function selectStudentByRoll()   { syncDropdowns($('#rollNo').val()); }
        function selectRollByStudent()   { syncDropdowns($('#studentId').val()); }
        function selectStudentByFather() { syncDropdowns($('#filterFatherName').val()); }
        function selectStudentByCNIC()   { syncDropdowns($('#filterFatherCNIC').val()); }

        /* ════════════════════════════════════════════
           SEARCH — populate info bar + load fees
        ════════════════════════════════════════════ */
        async function searchStudent() {
            const vid = $('#studentId').val();
            if (!vid) { toastWarning('Please select a student first'); return; }

            const s = allStudents.find(x => String(x.vid) === String(vid));
            if (!s)  { toastWarning('Student not found'); return; }

            selectedStudent = s;

            $('#infoStudentName').text(s.name                   || '—');
            $('#infoFatherName').text(s.fatherName              || '—');
            $('#infoRollNo').text(s.classRollNo || s.rollNo     || '—');
            $('#infoClass').text(s.className                    || '—');
            $('#infoSection').text(s.sectionName                || '—');
            $('#fatherNameDisplay').val(s.fatherName            || '');
            $('#studentInfoRow').show();

            await loadPendingFees(s.vid);
        }

        /* ════════════════════════════════════════════
           LOAD PENDING FEES
           API: GET /api/ApplyFee/Pendings?studentId=X
           Returns all pending fees for student
        ════════════════════════════════════════════ */
        async function loadPendingFees(studentId) {
            $('#feeGridBody').html(
                '<tr><td colspan="12" class="text-center text-muted py-3">' +
                '<span class="spinner-border spinner-border-sm me-2"></span>Loading fees...</td></tr>'
            );
            selectedFees = [];
            $('#paidAmount').val('');
            updateBottomTotals();

            try {
                const response = await fetch(
                    `${API_BASE}/ApplyFee/Pendings?studentId=${studentId}`
                );
                if (!response.ok) { resetFeeGrid('Error loading fees'); return; }

                const pending = await response.json();

                if (!pending.length) {
                    $('#feeGridBody').html(
                        '<tr><td colspan="12" class="text-center text-muted py-4">' +
                        '<i class="bi bi-check-circle text-success me-2"></i>No pending fees</td></tr>'
                    );
                    $('#feeGridCount').text('');
                    $('#infoBalance').text('0.00');
                    $('#paymentBalance').val('0.00');
                    return;
                }

                $('#feeGridCount').text(pending.length);

                let rows  = '';
                let total = 0;

                pending.forEach(f => {
                    const month = new Date(f.vDate)
                        .toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
                    total += (f.pendingAmount || 0);
                    rows  += `
                        <tr id="feeRow_${f.vid}" data-vid="${f.vid}" data-pending="${f.pendingAmount || 0}">
                            <td><input type="checkbox" class="fee-check"
                                       value="${f.vid}"
                                       data-pending="${f.pendingAmount || 0}"></td>
                            <td>${month}</td>
                            <td>${f.studentName  || '-'}</td>
                            <td>${f.className    || '-'}</td>
                            <td>${f.sectionName  || '-'}</td>
                            <td>${f.gradeName    || '-'}</td>
                            <td>${f.feeTypeName  || '-'}</td>
                            <td class="text-end">${fmt(f.feeAmount)}</td>
                            <td class="text-end text-success">${fmt(f.clearedAmount)}</td>
                            <td class="text-end text-danger fw-bold">${fmt(f.pendingAmount)}</td>
                            <td class="text-end">
                                <input type="number"
                                       class="paid-input"
                                       id="paid_${f.vid}"
                                       data-vid="${f.vid}"
                                       data-pending="${f.pendingAmount || 0}"
                                       value="0"
                                       min="0"
                                       max="${f.pendingAmount || 0}"
                                       disabled
                                       oninput="onGridPaidChange(this)" />
                            </td>
                            <td>${f.remarks || '-'}</td>
                        </tr>`;
                });

                $('#feeGridBody').html(rows);
                $('#infoBalance').text(fmt(total));
                $('#paymentBalance').val(fmt(total));

            } catch (error) {
                console.error('Error loading fees:', error);
                resetFeeGrid('Error loading fees');
            }
        }

        /* ════════════════════════════════════════════
           CHECKBOX — check / uncheck rows
        ════════════════════════════════════════════ */
        $(document).on('change', '.fee-check', function () {
            if (isDistributing) return;

            const vid     = this.value;
            const pending = parseFloat(this.dataset.pending) || 0;
            const $input  = $(`#paid_${vid}`);

            if (this.checked) {
                $(this).closest('tr').addClass('selected-row');
                $input.prop('disabled', false).val(pending.toFixed(2));
                const existing = selectedFees.find(f => f.vid === vid);
                if (existing) existing.paidAmount = pending;
                else selectedFees.push({ vid, pendingAmount: pending, paidAmount: pending });
            } else {
                $(this).closest('tr').removeClass('selected-row');
                $input.prop('disabled', true).val('0').removeClass('over-limit');
                selectedFees = selectedFees.filter(f => f.vid !== vid);
            }

            syncTotalFromGrid();
        });

        function selectAllFees(checked) {
            $('#selectAllCheck').prop('checked', checked);
            selectedFees = [];

            document.querySelectorAll('.fee-check').forEach(cb => {
                cb.checked    = checked;
                const vid     = cb.value;
                const pending = parseFloat(cb.dataset.pending) || 0;
                const input   = document.getElementById(`paid_${vid}`);
                cb.closest('tr').classList.toggle('selected-row', checked);

                if (checked) {
                    input.disabled = false;
                    input.value    = pending.toFixed(2);
                    selectedFees.push({ vid, pendingAmount: pending, paidAmount: pending });
                } else {
                    input.disabled = true;
                    input.value    = '0';
                    input.classList.remove('over-limit');
                }
            });

            syncTotalFromGrid();
        }

        /* ════════════════════════════════════════════
           GRID PAID INPUT CHANGED
        ════════════════════════════════════════════ */
        function onGridPaidChange(input) {
            if (isDistributing) return;

            const vid     = input.dataset.vid;
            const pending = parseFloat(input.dataset.pending) || 0;
            let   entered = parseFloat(input.value) || 0;

            if (entered > pending) { entered = pending; input.value = pending.toFixed(2); }
            if (entered < 0)       { entered = 0;       input.value = '0'; }
            input.classList.remove('over-limit');

            const entry = selectedFees.find(f => f.vid === vid);
            if (entry) entry.paidAmount = entered;

            syncTotalFromGrid();
        }

        /* ════════════════════════════════════════════
           SYNC BOTTOM paidAmount = SUM of grid rows
        ════════════════════════════════════════════ */
        function syncTotalFromGrid() {
            if (isDistributing) return;
            const sum = selectedFees.reduce((t, f) => t + (f.paidAmount || 0), 0);
            $('#paidAmount').val(sum > 0 ? sum.toFixed(2) : '');
            updateBottomTotals();
        }

        /* ════════════════════════════════════════════
           BOTTOM paidAmount TYPED → distribute to grid
        ════════════════════════════════════════════ */
        function distributeFromTotal() {
            isDistributing = true;

            let budget = parseFloat($('#paidAmount').val()) || 0;

            document.querySelectorAll('.fee-check').forEach(cb => {
                const vid     = cb.value;
                const pending = parseFloat(cb.dataset.pending) || 0;
                const input   = document.getElementById(`paid_${vid}`);
                if (!input) return;

                if (budget > 0 && pending > 0) {
                    const alloc = Math.min(budget, pending);
                    budget = Math.max(0, budget - alloc);

                    if (!cb.checked) {
                        cb.checked = true;
                        cb.closest('tr').classList.add('selected-row');
                        const existing = selectedFees.find(f => f.vid === vid);
                        if (!existing) selectedFees.push({ vid, pendingAmount: pending, paidAmount: alloc });
                        else existing.paidAmount = alloc;
                    } else {
                        const entry = selectedFees.find(f => f.vid === vid);
                        if (entry) entry.paidAmount = alloc;
                    }

                    input.disabled = false;
                    input.value    = alloc.toFixed(2);
                    input.classList.remove('over-limit');

                } else {
                    cb.checked = false;
                    cb.closest('tr').classList.remove('selected-row');
                    input.disabled = true;
                    input.value    = '0';
                    input.classList.remove('over-limit');
                    selectedFees = selectedFees.filter(f => f.vid !== vid);
                }
            });

            const total   = document.querySelectorAll('.fee-check').length;
            const checked = document.querySelectorAll('.fee-check:checked').length;
            $('#selectAllCheck').prop('checked', total > 0 && total === checked);

            isDistributing = false;
            updateBottomTotals();
        }

        /* ════════════════════════════════════════════
           UPDATE AMOUNT + REMAINING
        ════════════════════════════════════════════ */
        function updateBottomTotals() {
            const totalPending = selectedFees.reduce((t, f) => t + f.pendingAmount, 0);
            $('#totalAmount').val(totalPending.toFixed(2));

            const paid = parseFloat($('#paidAmount').val()) || 0;
            const rem  = totalPending - paid;
            $('#remainingAmount').val(rem.toFixed(2));
            $('#remainingAmount')
                .toggleClass('text-danger',  rem > 0)
                .toggleClass('text-success', rem <= 0);
        }

        /* ════════════════════════════════════════════
           SAVE VOUCHER
           SP needs: VNo, VDate, PaymentMethodID,
           ParentID, BalanceAmount, PaidAmount,
           Remarks + Details (StudentFeeID, PendingBalance, PaidAmount)
        ════════════════════════════════════════════ */
        async function saveVoucher(printAfter) {
            if (!selectedStudent)                          { toastWarning('Please select a student and click Search'); return; }
            if (!$('#paymentDate').val())                  { toastWarning('Please select date');                       return; }
            if (!$('#paymentMethod').val())                { toastWarning('Please select payment method');             return; }
            if (!selectedFees.length)                      { toastWarning('Please select at least one fee');           return; }
            if (!(parseFloat($('#paidAmount').val()) > 0)) { toastWarning('Please enter paid amount');                 return; }

            const balanceAmount = parseFloat(
                $('#paymentBalance').val().replace(/,/g, '')
            ) || 0;

            const payload = {
                vID:             0,
                vNo:             '',
                vDate:           $('#paymentDate').val(),
                paymentMethodID: parseInt($('#paymentMethod').val()),
                parentID:        selectedStudent.parentId || selectedStudent.vid,
                balanceAmount:   balanceAmount,
                paidAmount:      parseFloat($('#paidAmount').val()),
                remarks:         $('#remarks').val() || '',
                details:         selectedFees.map(f => ({
                    vID:            0,
                    studentFeeID:   parseInt(f.vid),
                    pendingBalance: f.pendingAmount,
                    paidAmount:     f.paidAmount
                }))
            };

            $('#btnSave, #btnSavePrint').prop('disabled', true);

            try {
                const response = await fetch(`${API_BASE}/FeeVoucher`, {
                    method:  'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body:    JSON.stringify(payload)
                });

                const result = await response.json();

                if (response.ok && result.returnCode === 200) {
                    toastSuccess(result.returnMessage || 'Voucher saved successfully!');
                    if (printAfter) {
                        const printer = $('input[name="printerType"]:checked').val();
                        window.open(`/feevoucher/print/${result.vid}?printer=${printer}`, '_blank');
                    }
                    resetForm();
                    loadNextVNo();
                } else {
                    toastError(result.returnMessage || 'Failed to save voucher');
                    $('#btnSave, #btnSavePrint').prop('disabled', false);
                }

            } catch (error) {
                console.error('Error saving voucher:', error);
                toastError('Error saving voucher');
                $('#btnSave, #btnSavePrint').prop('disabled', false);
            }
        }

                /* ════════════════════════════════════════════
           RESET FORM — save ke bad call karo
           Sab fields clear, grids empty, state reset
        ════════════════════════════════════════════ */
                /* ════════════════════════════════════════════
           RESET FORM — correct element IDs
        ════════════════════════════════════════════ */
        function resetForm() {

            // ── State variables reset ──
            selectedStudent  = null;
            selectedFees     = [];
            isSyncing        = false;
            isDistributing   = false;

            // ── Find Student dropdowns — actual IDs ──
            $('#classId').val('').trigger('change');
            $('#sectionId').val('').trigger('change');
            $('#rollNo').val('').trigger('change');
            $('#studentId').val('').trigger('change');
            $('#filterFatherName').val('').trigger('change');
            $('#filterFatherCNIC').val('').trigger('change');

            // ── Student Info Bar ──
            $('#infoStudentName').text('—');
            $('#infoFatherName').text('—');
            $('#infoRollNo').text('—');
            $('#infoClass').text('—');
            $('#infoSection').text('—');
            $('#infoBalance').text('0.00');
            $('#studentInfoRow').hide();

            // ── Pending Fees Grid ──
            $('#feeGridBody').html(
                '<tr><td colspan="12" class="text-center text-muted py-4">' +
                '<i class="bi bi-person-x me-2"></i>' +
                'Select a student and click Search to load fees' +
                '</td></tr>'
            );
            $('#feeGridCount').text('');
            $('#selectAllCheck').prop('checked', false);

            // ── Payment Details ──
            const cashOption = paymentMethods.find(p =>
            p.vName.toLowerCase().includes('cash')
             );
            if (cashOption) {
                $('#paymentMethod').val(cashOption.vid).trigger('change');
            }
            $('#fatherNameDisplay').val('');
            $('#paymentBalance').val('0.00');
            $('#totalAmount').val('0.00');
            $('#paidAmount').val('');
            $('#remainingAmount').val('0.00')
                .removeClass('text-danger text-success');
            $('#remarks').val('');

            // ── Voucher No + header display ──
            $('#voucherNo').val('');
            $('#voucherNoDisplay').text('New Voucher');

            // ── Date — aaj ki date ──
            const d = new Date();
            $('#paymentDate').val(
                d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate())
            );

            // ── Buttons re-enable ──
            $('#btnSave, #btnSavePrint').prop('disabled', false);


        }
        /* ════════════════════════════════════════════
           HELPERS
        ════════════════════════════════════════════ */
        function resetFeeGrid(msg) {
            $('#feeGridBody').html(
                '<tr><td colspan="12" class="text-center text-muted py-4">' +
                '<i class="bi bi-person-x me-2"></i>' +
                (msg || 'Select a student and click Search to load fees') +
                '</td></tr>'
            );
            $('#feeGridCount').text('');
            selectedFees = [];
            $('#paidAmount').val('');
            updateBottomTotals();
        }

        function fmt(val) {
            return (val || 0).toLocaleString('en-PK', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        function pad(n) { return String(n).padStart(2, '0'); }

    </script>
}