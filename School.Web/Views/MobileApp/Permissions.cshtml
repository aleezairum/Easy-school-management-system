@{
    ViewData["Title"] = "Mobile App Permissions";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@*
    What each role may do in the EasySchool mobile app. Staff logins carry a
    role (App Logins); a feature ticked here appears in that person's app. The
    Admin role always has everything. Parents and students are not roles: they
    see their own children and nothing else.
*@

<style>
    #permTable th, #permTable td { vertical-align: middle; font-size: 13px; }
    #permTable thead th { text-align: center; white-space: nowrap; }
    #permTable td.f { min-width: 260px; }
    #permTable td.f small { display: block; color: #64748b; font-size: 11.5px; }
    #permTable td.c { text-align: center; }
    .hint { font-size: 12px; color: #64748b; }
</style>

<div class="container-fluid">
    <div class="card"><div class="card-body">
        <p class="hint mb-3">Tick what each role can do in the app, then press <b>Save</b> under that role. The <b>Admin</b> role can always do everything. A teacher's classes are the ones allocated to them on <b>Subject Allocation</b>.</p>
        <div class="table-responsive"><table class="table table-bordered" id="permTable">
            <thead id="permHead"></thead><tbody id="permBody"><tr><td class="text-center text-muted py-4">Loading...</td></tr></tbody>
        </table></div>
    </div></div>
</div>

@section Scripts {
<script>
    let _features = [], _roles = [];
    const esc = v => (v ?? '').toString().replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    $(load);
    async function load() {
        [_features, _roles] = await Promise.all([
            fetch(`${API_BASE}/app-admin/features`).then(r => r.ok ? r.json() : []).catch(() => []),
            fetch(`${API_BASE}/app-admin/roles`).then(r => r.ok ? r.json() : []).catch(() => [])
        ]);
        if (!_roles.length) { $('#permBody').html('<tr><td class="text-center text-muted py-4">No roles yet. Add roles on Roles &amp; Permissions.</td></tr>'); return; }
        $('#permHead').html(`<tr><th class="text-start">Feature</th>${_roles.map(r => `<th>${esc(r.roleName)}<div class="hint fw-normal">${r.logins} login(s)</div></th>`).join('')}</tr>`);
        $('#permBody').html(_features.map(f => `<tr><td class="f"><b>${esc(f.title)}</b><small>${esc(f.description)}</small></td>
            ${_roles.map(r => `<td class="c"><input type="checkbox" class="form-check-input" data-role="${r.roleId}" data-key="${f.key}"
                ${r.isAdmin || r.features.includes(f.key) ? 'checked' : ''} ${r.isAdmin ? 'disabled title="Admin can always do everything"' : ''}></td>`).join('')}</tr>`).join('')
            + `<tr><td></td>${_roles.map(r => `<td class="c">${r.isAdmin ? '<span class="hint">everything</span>' : `<button class="btn btn-sm btn-success" onclick="save(${r.roleId})"><i class="bi bi-check-lg"></i> Save</button>`}</td>`).join('')}</tr>`);
    }

    async function save(roleId) {
        const keys = $(`input[data-role="${roleId}"]:checked`).map((_, el) => el.dataset.key).get();
        const res = await fetch(`${API_BASE}/app-admin/roles/${roleId}/features`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(keys) });
        if (res.ok) { toastSuccess('Saved. It applies the next time the app opens.'); load(); } else toastError('Could not save');
    }
</script>
}
