@{
    ViewData["Title"] = "Subject Management";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    .table tbody tr.selected {
        background: #ecfdf5;
        border-left: 3px solid #008649;
    }

    .loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255, 255, 255, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 100;
        border-radius: 16px;
    }

    .spinner-border {
        width: 3rem;
        height: 3rem;
        border-width: 0.3rem;
    }

    .form-section {
        background: #f8fafc;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .form-section-title {
        font-size: 14px;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 2px solid #e2e8f0;
    }

    .grid-section {
        margin-top: 24px;
    }

    .grid-section-title {
        font-size: 14px;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 2px solid #e2e8f0;
    }

    .filter-section {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 20px;
    }
</style>

<div class="container-fluid">
    <!-- Alert Messages -->
    <div id="alertContainer"></div>

    <!-- Subjects Card -->
    <div class="card">
        <div class="card-body position-relative">
            <div id="loadingOverlay" class="loading-overlay" style="display: none;">
                <div class="spinner-border text-success" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>

            <!-- Form Section -->
            <div class="form-section">
                <div class="form-section-title">
                    <i class="bi bi-pencil-square me-2"></i><span id="formTitle">Add New Subject</span>
                </div>
                <form id="subjectForm">
                    <input type="hidden" id="subjectId" value="0" />

                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label for="classId" class="form-label">Class <span class="text-danger">*</span></label>
                            <select class="form-select" id="classId" required>
                                <option value="">-- Select Class --</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="subjectName" class="form-label">Subject Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="subjectName" placeholder="e.g., Mathematics, English" required />
                        </div>
                        <div class="col-md-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="isActive" checked />
                                <label class="form-check-label" for="isActive">Active</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-primary" onclick="saveSubject()">
                                    <i class="bi bi-check-lg me-1"></i> Save
                                </button>
                                <button type="button" class="btn btn-secondary" onclick="resetForm()">
                                    <i class="bi bi-x-lg me-1"></i> Clear
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Filter Section -->
            <div class="filter-section">
                <div class="row align-items-center">
                    <div class="col-md-3">
                        <label for="filterClass" class="form-label mb-0 me-2"><i class="bi bi-funnel me-1"></i>Filter by Class:</label>
                    </div>
                    <div class="col-md-4">
                        <select class="form-select" id="filterClass" onchange="filterSubjects()">
                            <option value="">All Classes</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Grid Section -->
            <div class="grid-section">
                <div class="grid-section-title">
                    <i class="bi bi-table me-2"></i>Subjects List
                </div>
                <div class="table-responsive">
                    <table class="table table-hover" id="subjectsTable">
                        <thead>
                            <tr>
                                <th style="width: 60px;">Sr#</th>
                                <th>Subject Name</th>
                                <th>Class</th>
                                <th class="text-center" style="width: 100px;">Status</th>
                                <th class="text-center" style="width: 150px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="subjectsBody">
                            <!-- Subjects will be loaded dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        let editingSubjectId = 0;
        let allSubjects = [];

        $(document).ready(function () {
            loadClasses();
            loadSubjects();
        });

        // ================================
        // Load Classes
        // ================================
        async function loadClasses() {
            try {
                const response = await fetch(`${API_BASE}/class`);
                if (response.ok) {
                    const classes = await response.json();

                    const formSelect = $('#classId');
                    const filterSelect = $('#filterClass');

                    formSelect.find('option:not(:first)').remove();
                    filterSelect.find('option:not(:first)').remove();

                    classes.forEach(cls => {
                        formSelect.append(`<option value="${cls.vid}">${cls.vName}</option>`);
                        filterSelect.append(`<option value="${cls.vid}">${cls.vName}</option>`);
                    });
                }
            } catch (error) {
                console.error('Error loading classes:', error);
            }
        }

        // ================================
        // Load Subjects (API)
        // ================================
        async function loadSubjects() {
            showLoading();
            try {
                const response = await fetch(`${API_BASE}/subject`);
                if (response.ok) {
                    allSubjects = await response.json();
                    filterSubjects();
                } else {
                    showAlert('Failed to load subjects', 'danger');
                }
            } catch (error) {
                console.error('Error loading subjects:', error);
                showAlert('Error loading subjects: ' + error.message, 'danger');
            } finally {
                hideLoading();
            }
        }

        // ================================
        // Client Side Filter
        // ================================
        function filterSubjects() {
            const filterClass = $('#filterClass').val();
            let filtered = allSubjects;

            if (filterClass) {
                filtered = allSubjects.filter(s =>
                    String(s.classID) === String(filterClass)
                );
            }

            renderSubjectsList(filtered);
        }

        // ================================
        // Render Table
        // ================================
        function renderSubjectsList(subjects) {
            const tbody = $('#subjectsBody');
            tbody.empty();

            if (!subjects || subjects.length === 0) {
                tbody.html(`
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            No subjects found.
                        </td>
                    </tr>
                `);
                return;
            }

            subjects.forEach((subject, index) => {
                const row = `
                    <tr data-id="${subject.vid}"
                        class="${editingSubjectId === subject.vid ? 'selected' : ''}">

                        <td>${index + 1}</td>
                        <td><strong>${subject.vName}</strong></td>
                        <td><span class="badge bg-warning text-dark">${subject.className}</span></td>

                        <td class="text-center">
                            <span class="badge ${subject.isActive ? 'bg-success' : 'bg-secondary'}">
                                ${subject.isActive ? 'Active' : 'Inactive'}
                            </span>
                        </td>

                        <td class="text-center">
                            <button type="button"
                                    class="btn btn-sm btn-info me-1"
                                    onclick="editSubject(${subject.vid})">
                                <i class="bi bi-pencil"></i>
                            </button>
                        </td>
                    </tr>
                `;

                tbody.append(row);
            });
        }

        // ================================
        // Edit Subject
        // ================================
        async function editSubject(subjectId) {
            showLoading();
            try {
                const response = await fetch(`${API_BASE}/subject/${subjectId}`);
                if (response.ok) {
                    const data = await response.json();

                    $('#subjectId').val(data.vid);
                    $('#classId').val(data.classID).trigger('change');
                    $('#subjectName').val(data.vName);
                    $('#isActive').prop('checked', data.isActive);

                    editingSubjectId = subjectId;
                    $('#formTitle').text('Edit Subject');

                    $('#subjectsBody tr').removeClass('selected');
                    $(`#subjectsBody tr[data-id="${subjectId}"]`)
                        .addClass('selected');

                } else {
                    showAlert('Failed to load subject', 'danger');
                }
            } catch (error) {
                console.error(error);
                showAlert('Error loading subject', 'danger');
            } finally {
                hideLoading();
            }
        }

        // ================================
        // Delete Subject
        // ================================
        async function deleteSubject(subjectId, subjectName) {

            if (!await confirmDelete(`Delete subject "${subjectName}"?`)) return;

            showLoading();
            try {
                const response = await fetch(`${API_BASE}/subject/${subjectId}`, {
                    method: 'DELETE'
                });

                if (response.ok) {
                    showAlert('Subject deleted successfully!', 'success');
                    await loadSubjects();
                    resetForm();
                } else {
                    showAlert('Failed to delete subject', 'danger');
                }

            } catch (error) {
                console.error(error);
                showAlert('Error deleting subject', 'danger');
            } finally {
                hideLoading();
            }
        }

        // ================================
        // Save Subject
        // ================================
        async function saveSubject() {

            const subjectId = parseInt($('#subjectId').val()) || 0;
            const classId = parseInt($('#classId').val()) || 0;
            const subjectName = $('#subjectName').val().trim();

            if (!classId) {
                showAlert('Please select a class', 'danger');
                return;
            }

            if (!subjectName) {
                showAlert('Please enter subject name', 'danger');
                return;
            }

            const data = {
                VID: subjectId,
                ClassID: classId,
                VName: subjectName,
                IsActive: $('#isActive').is(':checked')
            };

            showLoading();

            try {
                let response;

                response = await fetch(`${API_BASE}/subject`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    const result = await response.json();

                    if (result && result.returnCode === 200) {
                        showAlert(
                            subjectId === 0
                                ? 'Subject created successfully!'
                                : 'Subject updated successfully!',
                            'success'
                        );
                        resetForm();
                        await loadSubjects();
                    } else {
                        showAlert(result?.returnMessage || 'Failed to save subject', 'danger');
                    }
                } else {
                    showAlert('Failed to save subject', 'danger');
                }

            } catch (error) {
                console.error(error);
                showAlert('Error saving subject', 'danger');
            } finally {
                hideLoading();
            }
        }

        // ================================
        // Reset Form
        // ================================
        function resetForm() {
            $('#subjectId').val(0);
            $('#classId').val('').trigger('change');
            $('#subjectName').val('');
            $('#isActive').prop('checked', true);
            editingSubjectId = 0;
            $('#formTitle').text('Add New Subject');
            $('#subjectsBody tr').removeClass('selected');
        }

        // ================================
        // Helpers
        // ================================
        function showLoading() {
            $('#loadingOverlay').show();
        }

        function hideLoading() {
            $('#loadingOverlay').hide();
        }

        function showAlert(message, type) {
            if (type === 'success') {
                toastSuccess(message);
            } else if (type === 'danger' || type === 'error') {
                toastError(message);
            } else if (type === 'warning') {
                toastWarning(message);
            } else {
                toastInfo(message);
            }
        }

    </script>
}
