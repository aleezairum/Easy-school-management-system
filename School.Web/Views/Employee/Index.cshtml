@{
    ViewData["Title"] = "Employees";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    .loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255, 255, 255, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 100;
        border-radius: 16px;
    }

    .spinner-border {
        width: 3rem;
        height: 3rem;
        border-width: 0.3rem;
    }

    .filter-section {
        background: #f8fafc;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .grid-section-title {
        font-size: 14px;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 2px solid #e2e8f0;
    }

    .employee-photo {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #e2e8f0;
    }

    .employee-photo-placeholder {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #94a3b8;
        font-size: 18px;
    }
</style>

<div class="container-fluid">
    <!-- Alert Messages -->
    <div id="alertContainer"></div>

    <!-- Employees Card -->
    <div class="card">
        <div class="card-body position-relative">
            <div class="d-flex justify-content-end mb-3">
                <a href="/employee/form" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-1"></i> Add New Employee
                </a>
            </div>
            <div id="loadingOverlay" class="loading-overlay" style="display: none;">
                <div class="spinner-border text-success" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>

            <!-- Filter Section -->
            <div class="filter-section">
                <div class="row g-3 align-items-end">
                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                        <label for="searchName" class="form-label">Search</label>
                        <input type="text" class="form-control" id="searchName" placeholder="Search by name, code, CNIC..." />
                    </div>
                    <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                        <label for="filterCampus" class="form-label">Campus</label>
                        <select class="form-select" id="filterCampus">
                            <option value="">All Campuses</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                        <label for="filterDesignation" class="form-label">Designation</label>
                        <select class="form-select" id="filterDesignation">
                            <option value="">All Designations</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                        <label for="filterStatus" class="form-label">Status</label>
                        <select class="form-select" id="filterStatus">
                            <option value="">All Status</option>
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                        <button type="button" class="btn btn-primary" onclick="loadEmployees()">
                            <i class="bi bi-search me-1"></i> Search
                        </button>
                    </div>
                </div>
            </div>

            <!-- Grid Section -->
            <div class="grid-section-title d-flex align-items-center flex-wrap gap-2">
                <span><i class="bi bi-table me-2"></i>Employees List</span>

                @* Categories are set from here, not from the employee form.
                   The form rightly insists on a campus, a designation and a
                   joining date; older staff records have none of those, and
                   nobody should have to invent them to put somebody into a
                   category. This writes that one column. *@
                <div class="ms-auto d-flex align-items-center gap-2" style="text-transform:none;">
                    <span class="text-muted" style="font-size:12px;">
                        <span id="selectedCount">0</span> selected
                    </span>
                    <select class="form-select form-select-sm" id="bulkCategory" style="width:200px;">
                        <option value="">-- Set category to --</option>
                    </select>
                    <button type="button" class="btn btn-sm btn-primary" id="btnApplyCategory"
                            onclick="applyCategory()">
                        <i class="bi bi-tags me-1"></i> Apply
                    </button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover" id="employeesTable">
                    <thead>
                        <tr>
                            <th style="width: 34px;" class="text-center">
                                <input type="checkbox" id="checkAll" title="Select all" />
                            </th>
                            <th style="width: 60px;">Sr#</th>
                            <th style="width: 60px;">Photo</th>
                            <th>Employee Code</th>
                            <th>Full Name</th>
                            <th>Father Name</th>
                            <th>Campus</th>
                            <th>Designation</th>
                            <th>Category</th>
                            <th>Role</th>
                            <th>Phone/Mobile</th>
                            <th>Joining Date</th>
                            <th class="text-center" style="width: 100px;">Status</th>
                            <th class="text-center" style="width: 150px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="employeesBody">
                        <!-- Employees will be loaded dynamically -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        ////const API_BASE = 'http://localhost:5266/api';

        $(document).ready(function () {
            loadDropdowns();
            loadEmployees();

            $('#checkAll').on('change', function () {
                $('.row-check').prop('checked', $(this).is(':checked'));
                updateSelectedCount();
            });
            // Delegated: the rows are drawn after this runs, and again on
            // every search.
            $('#employeesBody').on('change', '.row-check', updateSelectedCount);
        });

        function selectedIds() {
            return $('.row-check:checked').map(function () { return parseInt(this.value); }).get();
        }

        function updateSelectedCount() {
            $('#selectedCount').text(selectedIds().length);
        }

        async function applyCategory() {
            const ids = selectedIds();
            if (!ids.length) { toastWarning('Tick the staff to put into a category first'); return; }

            const choice = $('#bulkCategory').val();
            if (!choice) { toastWarning('Choose a category'); return; }

            const categoryId = choice === 'clear' ? null : parseInt(choice);
            const what = choice === 'clear'
                ? `Clear the category on ${ids.length} member(s) of staff?`
                : `Put ${ids.length} member(s) of staff into "${$('#bulkCategory option:selected').text()}"?`;
            if (!await confirmDelete(what)) return;

            showLoading();
            try {
                const res = await fetch(`${API_BASE}/Employee/category`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ EmployeeIds: ids, StaffCategoryId: categoryId })
                });

                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    toastError(err.message || 'Could not set the category');
                    return;
                }

                const out = await res.json();
                toastSuccess(`Category set on ${out.updated} member(s) of staff`);
                $('#checkAll').prop('checked', false);
                await loadEmployees();
                updateSelectedCount();
            } catch (e) {
                toastError('Error setting the category: ' + e.message);
            } finally { hideLoading(); }
        }

        async function loadDropdowns() {
            try {
                const [designations, campuses, categories] = await Promise.all([
                    fetch(`${API_BASE}/Designation/dropdown`).then(r => r.ok ? r.json() : []).catch(() => []),
                    fetch(`${API_BASE}/campus`).then(r => r.ok ? r.json() : []).catch(() => []),
                    fetch(`${API_BASE}/StaffCategory/dropdown`).then(r => r.ok ? r.json() : []).catch(() => [])
                ]);

                categories.forEach(c =>
                    $('#bulkCategory').append(`<option value="${c.id}">${c.name}</option>`));
                // Taking staff back out of a category has to be possible too.
                $('#bulkCategory').append('<option value="clear">-- Clear category --</option>');

                designations.forEach(d =>
                    $('#filterDesignation').append(`<option value="${d.id}">${d.name}</option>`));

                // Campus uses the SMS naming (vid/vName), not the HR id/name shape.
                campuses.forEach(c =>
                    $('#filterCampus').append(`<option value="${c.vid}">${c.vName}</option>`));
            } catch (error) {
                console.error('Error loading dropdowns:', error);
            }
        }

        async function loadEmployees() {
            showLoading();
            try {
                // Campus is filtered server-side rather than in the browser:
                // it is an indexed column, and the list is what the office
                // works from all day.
                const campus = $('#filterCampus').val();
                const url = campus ? `${API_BASE}/Employee?campusId=${campus}` : `${API_BASE}/Employee`;

                const response = await fetch(url);
                if (response.ok) {
                    let data = await response.json();

                    // Apply filters
                    const search = $('#searchName').val().toLowerCase();
                    const designation = $('#filterDesignation').val();
                    const status = $('#filterStatus').val();

                    if (search) {
                        data = data.filter(e =>
                            (e.fullName && e.fullName.toLowerCase().includes(search)) ||
                            (e.employeeCode && e.employeeCode.toLowerCase().includes(search)) ||
                            (e.cnic && e.cnic.includes(search))
                        );
                    }

                    if (designation) {
                        data = data.filter(e => e.designationId == designation);
                    }

                    if (status !== '') {
                        data = data.filter(e => e.isActive.toString() === status);
                    }

                    renderList(data);
                } else {
                    showAlert('Failed to load employees', 'danger');
                }
            } catch (error) {
                console.error('Error loading employees:', error);
                showAlert('Error loading employees: ' + error.message, 'danger');
            } finally {
                hideLoading();
            }
        }

        function renderList(items) {
            const tbody = $('#employeesBody');
            tbody.empty();

            if (items.length === 0) {
                tbody.html('<tr><td colspan="14" class="text-center text-muted py-4">No employees found.</td></tr>');
                return;
            }

            items.forEach((item, index) => {
                const photoHtml = item.hasPhoto
                    ? `<img src="${apiFileUrl(`${API_BASE}/Employee/${item.id}/photo`)}" class="employee-photo" alt="Photo" loading="lazy" />`
                    : `<div class="employee-photo-placeholder"><i class="bi bi-person"></i></div>`;

                const row = `
                    <tr>
                        <td class="text-center">
                            <input type="checkbox" class="row-check" value="${item.id}" />
                        </td>
                        <td>${index + 1}</td>
                        <td>${photoHtml}</td>
                        <td><strong>${item.employeeCode || '-'}</strong></td>
                        <td>${item.fullName || (item.firstName + ' ' + item.lastName)}</td>
                        <td>${item.fatherName || '-'}</td>
                        <td>${item.campusName || '<span class="text-muted">Not set</span>'}</td>
                        <td>${item.designationName || '-'}</td>
                        <td>${item.staffCategoryName || '<span class="text-muted">Not set</span>'}</td>
                        <td>${item.isTeachingStaff
                                ? '<span class="badge bg-primary">Teaching</span>'
                                : '<span class="badge bg-light text-dark">Non-teaching</span>'}</td>
                        <td>${item.mobile || item.phone || '-'}</td>
                        <td>${formatDate(item.joiningDate)}</td>
                        <td class="text-center">
                            <span class="badge ${item.isActive ? 'bg-success' : 'bg-secondary'}">
                                ${item.isActive ? 'Active' : 'Inactive'}
                            </span>
                        </td>
                        <td class="text-center">
                            <a href="/employee/form/${item.id}" class="btn btn-sm btn-info me-1" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                    </tr>
                `;
                tbody.append(row);
            });
        }

        // dd-MMM-yyyy, same as everywhere else. This printed "Apr 1, 2021" while
        // the Staff Statement printed the same joining date as 01-04-2021.
        function formatDate(dateString) {
            return dateString ? fmtDate(dateString) : '-';
        }

        async function deleteEmployee(id, name) {
            if (!await confirmDelete(`Are you sure you want to delete employee "${name}"?`)) {
                return;
            }

            showLoading();
            try {
                const response = await fetch(`${API_BASE}/Employee/${id}`, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' }
                });

                if (response.ok) {
                    showAlert('Employee deleted successfully!', 'success');
                    await loadEmployees();
                } else {
                    const error = await response.json();
                    showAlert(error.message || 'Failed to delete employee', 'danger');
                }
            } catch (error) {
                console.error('Error deleting employee:', error);
                showAlert('Error deleting employee: ' + error.message, 'danger');
            } finally {
                hideLoading();
            }
        }

        function showLoading() {
            $('#loadingOverlay').show();
        }

        function hideLoading() {
            $('#loadingOverlay').hide();
        }

        function showAlert(message, type) {
            if (type === 'success') {
                toastSuccess(message);
            } else if (type === 'danger' || type === 'error') {
                toastError(message);
            } else if (type === 'warning') {
                toastWarning(message);
            } else {
                toastInfo(message);
            }
        }
    </script>
}
