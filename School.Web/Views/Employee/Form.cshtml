@{
    ViewData["Title"] = ViewData["EmployeeId"] != null ? "Edit Employee" : "Add Employee";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var employeeId = ViewData["EmployeeId"];
}

<style>
    .nav-tabs { border-bottom: 2px solid #e2e8f0; margin-bottom: 16px; }
    .nav-tabs .nav-link { border: none; color: #64748b; font-weight: 500; padding: 8px 14px; margin-bottom: -2px; transition: all 0.2s; }
    .nav-tabs .nav-link:hover { color: #008649; border: none; }
    .nav-tabs .nav-link.active { color: #008649; border: none; border-bottom: 3px solid #008649; background: transparent; }
    .section-title { font-size: 12px; font-weight: 600; color: #008649; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px; padding-bottom: 6px; border-bottom: 2px solid #e2e8f0; }
    .loading-overlay { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(255,255,255,0.8); display: flex; align-items: center; justify-content: center; z-index: 100; border-radius: 10px; }
    .photo-preview { width: 150px; height: 150px; border-radius: 12px; border: 2px dashed #e2e8f0; display: flex; align-items: center; justify-content: center; background: #f8fafc; overflow: hidden; }
    .photo-preview img { max-width: 100%; max-height: 100%; object-fit: cover; }
    .photo-preview i { font-size: 48px; color: #cbd5e1; }
    .pay-history-row { font-size: 13px; }
</style>

<div class="container-fluid">
    <div id="alertContainer"></div>

    <div class="card">
        <div class="card-body position-relative">
            <div class="d-flex justify-content-end mb-3">
                <a href="/employee" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
            </div>
            <div id="loadingOverlay" class="loading-overlay" style="display: none;">
                <div class="spinner-border text-success" role="status"><span class="visually-hidden">Loading...</span></div>
            </div>

            <form id="employeeForm">
                <input type="hidden" id="employeeId" name="Id" value="0" />

                <ul class="nav nav-tabs" id="employeeTabs" role="tablist">
                    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#personal" type="button"><i class="bi bi-person me-1"></i> Personal Info</button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#contact" type="button"><i class="bi bi-telephone me-1"></i> Contact Info</button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#employment" type="button"><i class="bi bi-briefcase me-1"></i> Employment</button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#payroll" type="button"><i class="bi bi-cash-stack me-1"></i> Payroll</button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#emergency" type="button"><i class="bi bi-exclamation-triangle me-1"></i> Emergency Contact</button></li>
                </ul>

                <div class="tab-content" id="employeeTabContent">
                    <!-- Personal Info -->
                    <div class="tab-pane fade show active" id="personal" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-lg-4 col-md-6 col-12">
                                <div class="section-title">Personal Information</div>
                                <div class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label">Employee Code</label>
                                        <input type="text" class="form-control" id="employeeCode" name="EmployeeCode" placeholder="Auto-generated if left blank" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">First Name <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="firstName" required />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Last Name</label>
                                        <input type="text" class="form-control" id="lastName" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Father Name</label>
                                        <input type="text" class="form-control" id="fatherName" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">First Name (Urdu)</label>
                                        <input type="text" class="form-control" id="firstNameUrdu" dir="rtl" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Last Name (Urdu)</label>
                                        <input type="text" class="form-control" id="lastNameUrdu" dir="rtl" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">CNIC</label>
                                        <input type="text" class="form-control" id="cnic" placeholder="00000-0000000-0" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Gender</label>
                                        <select class="form-select" id="gender">
                                            <option value="">Select Gender</option>
                                            <option value="Male">Male</option>
                                            <option value="Female">Female</option>
                                        </select>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Date of Birth</label>
                                        <input type="date" class="form-control" id="dateOfBirth" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-12 col-12 text-center">
                                <div class="section-title">Photo</div>
                                <div class="d-flex flex-column align-items-center">
                                    <div class="photo-preview mb-2" id="photoPreview" style="width: 180px; height: 180px;"><i class="bi bi-person-square"></i></div>
                                    <input type="file" class="form-control" id="photoFile" accept="image/*" onchange="previewPhoto(this)" style="max-width: 200px;" />
                                    <input type="hidden" id="photo" />
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-6 col-12">
                                <div class="section-title">Qualifications</div>
                                <div class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label">Qualification</label>
                                        <input type="text" class="form-control" id="qualification" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Specialization</label>
                                        <input type="text" class="form-control" id="specialization" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Experience</label>
                                        <input type="text" class="form-control" id="experience" placeholder="e.g., 5 years" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Contact Info -->
                    <div class="tab-pane fade" id="contact" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-lg-4 col-md-6 col-12"><label class="form-label">Email</label><input type="email" class="form-control" id="email" /></div>
                            <div class="col-lg-4 col-md-6 col-12"><label class="form-label">Phone</label><input type="text" class="form-control" id="phone" /></div>
                            <div class="col-lg-4 col-md-6 col-12"><label class="form-label">Mobile</label><input type="text" class="form-control" id="mobile" /></div>
                            <div class="col-lg-8 col-md-12 col-12"><label class="form-label">Address</label><textarea class="form-control" id="address" rows="3"></textarea></div>
                            <div class="col-lg-4 col-md-6 col-12"><label class="form-label">City</label><input type="text" class="form-control" id="city" /></div>
                        </div>
                    </div>

                    <!-- Employment -->
                    <div class="tab-pane fade" id="employment" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                <label class="form-label">Designation <span class="text-danger">*</span></label>
                                <select class="form-select" id="designationId" required><option value="">Select Designation</option></select>
                            </div>
                            <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                <label class="form-label">HR Grade</label>
                                <select class="form-select" id="hrGradeId"><option value="">Select HR Grade</option></select>
                            </div>
                            <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                <label class="form-label">Academic Grade</label>
                                <select class="form-select" id="academicGradeId"><option value="">Select Academic Grade</option></select>
                            </div>
                            <div class="col-lg-3 col-md-4 col-sm-6 col-12"><label class="form-label">Department</label><input type="text" class="form-control" id="department" /></div>
                            <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                <label class="form-label">Employee Type</label>
                                <select class="form-select" id="employeeType">
                                    <option value="">Select Type</option>
                                    <option value="Permanent">Permanent</option>
                                    <option value="Contractual">Contractual</option>
                                    <option value="Visiting">Visiting</option>
                                </select>
                            </div>
                            <div class="col-lg-3 col-md-4 col-sm-6 col-12"><label class="form-label">Joining Date <span class="text-danger">*</span></label><input type="date" class="form-control" id="joiningDate" required /></div>
                            <div class="col-lg-3 col-md-4 col-sm-6 col-12"><label class="form-label">Leaving Date</label><input type="date" class="form-control" id="leavingDate" /></div>
                            <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                <label class="form-label">Status</label>
                                <select class="form-select" id="status">
                                    <option value="Active">Active</option>
                                    <option value="Inactive">Inactive</option>
                                    <option value="Resigned">Resigned</option>
                                    <option value="Terminated">Terminated</option>
                                </select>
                            </div>
                            <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                <div class="form-check mt-4"><input class="form-check-input" type="checkbox" id="isActive" checked /><label class="form-check-label" for="isActive">Is Active</label></div>
                            </div>
                        </div>
                    </div>

                    <!-- Payroll -->
                    <div class="tab-pane fade" id="payroll" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-12"><div class="section-title">Attendance &amp; Shift</div></div>
                            <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                <label class="form-label">Shift</label>
                                <select class="form-select" id="shiftId"><option value="">Select Shift</option></select>
                            </div>
                            <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                <label class="form-label">Machine Card No</label>
                                <input type="text" class="form-control" id="machineCardNo" placeholder="Hikvision card / person ID" />
                            </div>
                            <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                <label class="form-label">Weekly Off Day 1</label>
                                <select class="form-select" id="offDay1"><option value="">None</option></select>
                            </div>
                            <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                <label class="form-label">Weekly Off Day 2</label>
                                <select class="form-select" id="offDay2"><option value="">None</option></select>
                            </div>
                            <div class="col-lg-4 col-md-6 col-sm-6 col-12">
                                <label class="form-label">Academic Role</label>
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="isTeachingStaff" />
                                    <label class="form-check-label" for="isTeachingStaff">Teaching staff</label>
                                </div>
                                <div class="form-text">
                                    Makes this person available for subject assignment, timetable and exam
                                    reports. There is no separate teacher record &mdash; those screens use
                                    this same employee.
                                    <span id="teacherLinkNote" class="d-block mt-1"></span>
                                </div>
                            </div>

                            <div class="col-12 mt-4"><div class="section-title">Bank Details</div></div>
                            <div class="col-md-4"><label class="form-label">Bank Name</label><input type="text" class="form-control" id="bankName" /></div>
                            <div class="col-md-4"><label class="form-label">Bank Account No</label><input type="text" class="form-control" id="bankAccountNo" /></div>

                            <div class="col-12 mt-4" id="paySection" style="display:none;">
                                <div class="section-title">Salary Structure</div>
                                <div class="row g-2 align-items-end mb-3">
                                    <div class="col-md-3">
                                        <label class="form-label">New Basic Salary</label>
                                        <input type="number" class="form-control" id="newBasic" step="0.01" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Effective From</label>
                                        <input type="date" class="form-control" id="newBasicEffFrom" />
                                    </div>
                                    <div class="col-md-3">
                                        <button type="button" class="btn btn-outline-success" onclick="saveNewPayStructure()"><i class="bi bi-plus-lg me-1"></i> Add Salary Record</button>
                                    </div>
                                </div>
                                <table class="table table-sm">
                                    <thead><tr><th>Effective From</th><th>Basic</th></tr></thead>
                                    <tbody id="payHistoryBody"><tr><td colspan="2" class="text-muted text-center py-2">No salary history yet.</td></tr></tbody>
                                </table>
                                <div class="form-text">Allowances and deductions are configured under HR Payroll &gt; Setup &gt; Pay Components and applied automatically during payroll generation.</div>
                            </div>
                            <div class="col-12" id="paySectionHint">
                                <div class="alert alert-info mb-0">Save the employee first to manage their salary structure.</div>
                            </div>
                        </div>
                    </div>

                    <!-- Emergency Contact -->
                    <div class="tab-pane fade" id="emergency" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-lg-4 col-md-6 col-12"><label class="form-label">Contact Name</label><input type="text" class="form-control" id="emergencyContactName" /></div>
                            <div class="col-lg-4 col-md-6 col-12"><label class="form-label">Contact Phone</label><input type="text" class="form-control" id="emergencyContactPhone" /></div>
                            <div class="col-lg-4 col-md-6 col-12"><label class="form-label">Relation</label><input type="text" class="form-control" id="emergencyContactRelation" /></div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-4 border-top">
                    <a href="/employee" class="btn btn-secondary"><i class="bi bi-x-lg me-1"></i> Cancel</a>
                    <button type="button" class="btn btn-primary" onclick="saveEmployee()"><i class="bi bi-check-lg me-1"></i> Save Employee</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
<style>
    @@media (max-width: 767px) {
        .nav-tabs { flex-wrap: nowrap !important; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
        .nav-tabs::-webkit-scrollbar { display: none; }
        .nav-tabs .nav-link { padding: 8px 12px; font-size: 12px; white-space: nowrap; }
        .photo-preview { width: 140px !important; height: 140px !important; }
    }
</style>
}

@section Scripts {
    <script>
        const employeeId = @(employeeId != null ? employeeId.ToString() : "0");
        const WEEKDAYS = [{v:1,n:'Sunday'},{v:2,n:'Monday'},{v:3,n:'Tuesday'},{v:4,n:'Wednesday'},{v:5,n:'Thursday'},{v:6,n:'Friday'},{v:7,n:'Saturday'}];

        $(document).ready(function () {
            populateWeekdayDropdowns();
            loadDropdowns();
            if (employeeId > 0) {
                loadEmployee(employeeId);
                loadPayHistory(employeeId);
                $('#paySection').show();
                $('#paySectionHint').hide();
                $('#newBasicEffFrom').val(toInputDate());
            }
        });

        function populateWeekdayDropdowns() {
            WEEKDAYS.forEach(d => {
                $('#offDay1').append(`<option value="${d.v}">${d.n}</option>`);
                $('#offDay2').append(`<option value="${d.v}">${d.n}</option>`);
            });
        }

        function previewPhoto(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    $('#photoPreview').html(`<img src="${e.target.result}" />`);
                    $('#photo').val(e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        async function loadDropdowns() {
            try {
                const [designations, hrGrades, academicGrades, shifts] = await Promise.all([
                    fetch(`${API_BASE}/Designation/dropdown`).then(r => r.ok ? r.json() : []).catch(() => []),
                    fetch(`${API_BASE}/HRGrade/dropdown`).then(r => r.ok ? r.json() : []).catch(() => []),
                    fetch(`${API_BASE}/AcademicGrade/dropdown`).then(r => r.ok ? r.json() : []).catch(() => []),
                    fetch(`${API_BASE}/hr/shifts/dropdown`).then(r => r.ok ? r.json() : []).catch(() => [])
                ]);

                designations.forEach(d => $('#designationId').append(`<option value="${d.id}">${d.name}</option>`));
                hrGrades.forEach(g => $('#hrGradeId').append(`<option value="${g.id}">${g.name}</option>`));
                academicGrades.forEach(g => $('#academicGradeId').append(`<option value="${g.id}">${g.name}</option>`));
                shifts.forEach(s => $('#shiftId').append(`<option value="${s.id}">${s.name}</option>`));
            } catch (error) {
                console.error('Error loading dropdowns:', error);
            }
        }

        async function loadEmployee(id) {
            showLoading();
            try {
                const response = await fetch(`${API_BASE}/Employee/${id}`);
                if (response.ok) {
                    populateForm(await response.json());
                } else {
                    showAlert('Failed to load employee', 'danger');
                }
            } catch (error) {
                showAlert('Error loading employee: ' + error.message, 'danger');
            } finally {
                hideLoading();
            }
        }

        function populateForm(data) {
            $('#employeeId').val(data.id);
            $('#employeeCode').val(data.employeeCode);
            $('#firstName').val(data.firstName);
            $('#lastName').val(data.lastName);
            $('#firstNameUrdu').val(data.firstNameUrdu);
            $('#lastNameUrdu').val(data.lastNameUrdu);
            $('#fatherName').val(data.fatherName);
            $('#cnic').val(data.cnic);
            $('#gender').val(data.gender);
            $('#dateOfBirth').val(formatDateForInput(data.dateOfBirth));
            $('#qualification').val(data.qualification);
            $('#specialization').val(data.specialization);
            $('#experience').val(data.experience);

            $('#email').val(data.email);
            $('#phone').val(data.phone);
            $('#mobile').val(data.mobile);
            $('#address').val(data.address);
            $('#city').val(data.city);

            $('#designationId').val(data.designationId);
            $('#hrGradeId').val(data.hrGradeId);
            $('#academicGradeId').val(data.academicGradeId);
            $('#department').val(data.department);
            $('#employeeType').val(data.employeeType);
            $('#joiningDate').val(formatDateForInput(data.joiningDate));
            $('#leavingDate').val(formatDateForInput(data.leavingDate));
            $('#status').val(data.status);
            $('#isActive').prop('checked', data.isActive);

            $('#shiftId').val(data.shiftId);
            $('#machineCardNo').val(data.machineCardNo);
            $('#offDay1').val(data.offDay1);
            $('#offDay2').val(data.offDay2);
            $('#isTeachingStaff').prop('checked', !!data.isTeachingStaff);
            // Staff and teacher are one record now, so the academic id is simply
            // this employee's id — show it, it is what the reports join on.
            $('#teacherLinkNote').text(data.isTeachingStaff ? `Academic ID #${data.id}` : '');
            $('#bankName').val(data.bankName);
            $('#bankAccountNo').val(data.bankAccountNo);

            $('#emergencyContactName').val(data.emergencyContactName);
            $('#emergencyContactPhone').val(data.emergencyContactPhone);
            $('#emergencyContactRelation').val(data.emergencyContactRelation);

            if (data.photo) {
                $('#photoPreview').html(`<img src="${data.photo}" />`);
                $('#photo').val(data.photo);
            }
        }

        async function loadPayHistory(id) {
            try {
                const response = await fetch(`${API_BASE}/hr/employee-pay/${id}`);
                if (!response.ok) return;
                const rows = await response.json();
                const body = $('#payHistoryBody');
                body.empty();
                if (!rows.length) {
                    body.html('<tr><td colspan="2" class="text-muted text-center py-2">No salary history yet.</td></tr>');
                    return;
                }
                rows.forEach(r => {
                    body.append(`<tr class="pay-history-row"><td>${fmtDate(r.effectiveFrom)}</td><td>${Number(r.basic).toLocaleString()}</td></tr>`);
                });
            } catch (error) {
                console.error('Error loading pay history:', error);
            }
        }

        async function saveNewPayStructure() {
            const basic = parseFloat($('#newBasic').val());
            const effFrom = $('#newBasicEffFrom').val();
            if (!basic || basic <= 0 || !effFrom) {
                showAlert('Enter a basic salary and effective date', 'danger');
                return;
            }
            try {
                const response = await fetch(`${API_BASE}/hr/employee-pay`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ EmployeeId: employeeId, EffectiveFrom: effFrom, Basic: basic, Components: [] })
                });
                if (response.ok) {
                    showAlert('Salary record added', 'success');
                    $('#newBasic').val('');
                    loadPayHistory(employeeId);
                } else {
                    showAlert('Failed to add salary record', 'danger');
                }
            } catch (error) {
                showAlert('Error: ' + error.message, 'danger');
            }
        }

        function formatDateForInput(dateString) {
            if (!dateString) return '';
            const date = parseCalendarDate(dateString);
            if (!date || isNaN(date.getTime())) return '';
            return toInputDate(date);
        }

        async function saveEmployee() {
            const firstName = $('#firstName').val().trim();
            const joiningDate = $('#joiningDate').val();
            const designationId = $('#designationId').val();

            if (!firstName) { showAlert('Please enter first name', 'danger'); return; }
            if (!joiningDate) { showAlert('Please enter joining date', 'danger'); return; }
            if (!designationId) { showAlert('Please select a designation', 'danger'); return; }

            const id = parseInt($('#employeeId').val()) || 0;
            const data = {
                Id: id,
                EmployeeCode: $('#employeeCode').val().trim(),
                FirstName: firstName,
                LastName: $('#lastName').val().trim(),
                FirstNameUrdu: $('#firstNameUrdu').val().trim(),
                LastNameUrdu: $('#lastNameUrdu').val().trim(),
                FatherName: $('#fatherName').val().trim(),
                CNIC: $('#cnic').val().trim(),
                Email: $('#email').val().trim(),
                Phone: $('#phone').val().trim(),
                Mobile: $('#mobile').val().trim(),
                Gender: $('#gender').val(),
                DateOfBirth: $('#dateOfBirth').val() || null,
                JoiningDate: joiningDate,
                LeavingDate: $('#leavingDate').val() || null,
                Address: $('#address').val().trim(),
                City: $('#city').val().trim(),
                Photo: $('#photo').val(),
                Qualification: $('#qualification').val().trim(),
                Specialization: $('#specialization').val().trim(),
                Experience: $('#experience').val().trim(),
                Department: $('#department').val().trim(),
                DesignationId: parseInt(designationId),
                HRGradeId: $('#hrGradeId').val() ? parseInt($('#hrGradeId').val()) : null,
                AcademicGradeId: $('#academicGradeId').val() ? parseInt($('#academicGradeId').val()) : null,
                ShiftId: $('#shiftId').val() ? parseInt($('#shiftId').val()) : null,
                MachineCardNo: $('#machineCardNo').val().trim(),
                OffDay1: $('#offDay1').val() ? parseInt($('#offDay1').val()) : null,
                OffDay2: $('#offDay2').val() ? parseInt($('#offDay2').val()) : null,
                IsTeachingStaff: $('#isTeachingStaff').is(':checked'),
                BankName: $('#bankName').val().trim(),
                BankAccountNo: $('#bankAccountNo').val().trim(),
                EmergencyContactName: $('#emergencyContactName').val().trim(),
                EmergencyContactPhone: $('#emergencyContactPhone').val().trim(),
                EmergencyContactRelation: $('#emergencyContactRelation').val().trim(),
                EmployeeType: $('#employeeType').val(),
                Status: $('#status').val(),
                IsActive: $('#isActive').is(':checked')
            };

            showLoading();
            try {
                let response;
                if (id === 0) {
                    response = await fetch(`${API_BASE}/Employee`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
                } else {
                    response = await fetch(`${API_BASE}/Employee/${id}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
                }

                if (response.ok) {
                    showAlert('Employee saved successfully!', 'success');
                    setTimeout(() => { window.location.href = '/employee'; }, 1200);
                } else {
                    const error = await response.json();
                    showAlert(error.message || 'Failed to save employee', 'danger');
                }
            } catch (error) {
                showAlert('Error saving employee: ' + error.message, 'danger');
            } finally {
                hideLoading();
            }
        }

        function showLoading() { $('#loadingOverlay').show(); }
        function hideLoading() { $('#loadingOverlay').hide(); }
        function showAlert(message, type) {
            if (type === 'success') toastSuccess(message);
            else if (type === 'danger' || type === 'error') toastError(message);
            else if (type === 'warning') toastWarning(message);
            else toastInfo(message);
        }
    </script>
}
