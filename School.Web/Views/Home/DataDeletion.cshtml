@{
    ViewData["Title"] = "Data Deletion";
    // Layout = null for the same reason as Privacy.cshtml: Meta requires this
    // page to be reachable without logging in.
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Data Deletion - Sir Syed Model High School</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root { --brand: #008649; --ink: #1f2937; --muted: #6b7280; --line: #e5e7eb; }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', Arial, sans-serif;
            color: var(--ink);
            background: #f8fafc;
            line-height: 1.7;
            font-size: 15px;
        }
        .wrap { max-width: 820px; margin: 0 auto; padding: 0 20px 60px; }
        header {
            background: var(--brand);
            color: #fff;
            padding: 34px 20px;
            text-align: center;
            margin-bottom: 30px;
        }
        header h1 { font-size: 24px; font-weight: 700; }
        header .sub { font-size: 14px; opacity: .9; margin-top: 4px; }
        .card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 28px 30px;
        }
        h2 { font-size: 17px; font-weight: 700; color: var(--brand); margin: 28px 0 10px; }
        h2:first-of-type { margin-top: 0; }
        p { margin-bottom: 12px; }
        ol, ul { margin: 0 0 14px 20px; }
        li { margin-bottom: 8px; }
        .updated { color: var(--muted); font-size: 13px; margin-bottom: 22px; }
        .contact {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-radius: 10px;
            padding: 16px 18px;
            margin-top: 8px;
        }
        .note {
            background: #fffbeb;
            border: 1px solid #fde68a;
            border-radius: 10px;
            padding: 14px 16px;
            margin: 14px 0;
            font-size: 14px;
        }
        a { color: var(--brand); }
        footer { text-align: center; color: var(--muted); font-size: 13px; margin-top: 26px; }
        @@media (max-width: 600px) { .card { padding: 20px 18px; } }
    </style>
</head>
<body>
    <header>
        <h1>Sir Syed Model High School (Boys &amp; Girls)</h1>
        <div class="sub">Chhonawala Road, Hasilpur</div>
    </header>

    <div class="wrap">
        <div class="card">
            <h1 style="font-size:22px;margin-bottom:6px;">Data Deletion Request</h1>
            <div class="updated">Last updated: 6 September 2026</div>

            <p>
                Parents and guardians may ask the School to delete the information it holds about
                them or their child. This page explains how to make that request and what happens next.
            </p>

            <h2>How to request deletion</h2>
            <p>Contact the School office by any of these means and state that you are requesting deletion of your data:</p>
            <ol>
                <li>Email <a href="mailto:ssmhschools@gmail.com">ssmhschools@gmail.com</a> with the subject &ldquo;Data Deletion Request&rdquo;.</li>
                <li>Phone the School on 0333-6335634 or 0301-7330101.</li>
                <li>Visit the School office in person during working hours.</li>
            </ol>
            <p>Please include the student&rsquo;s name, class and roll number so we can identify the correct record.</p>

            <h2>What we delete</h2>
            <ul>
                <li>The WhatsApp conversation history between you and the School.</li>
                <li>Your mobile number, so no further WhatsApp notifications are sent.</li>
                <li>Personal contact details held for the parent or guardian.</li>
                <li>The student&rsquo;s photograph and personal details, where retention is not required by law.</li>
            </ul>

            <h2>What we may have to keep</h2>
            <div class="note">
                Some records cannot be deleted on request. Academic records &mdash; enrolment,
                attendance, examination results and certificates &mdash; and financial records of
                fees paid form part of the School&rsquo;s permanent register and of its accounts,
                and are kept for as long as school regulations and Pakistani law require. We will
                tell you clearly which items fall into this category when we respond.
            </div>

            <h2>How long it takes</h2>
            <p>
                We acknowledge requests within 7 working days and complete them within 30 days.
                If your request only concerns WhatsApp messaging, we can usually stop messages
                the same day.
            </p>

            <h2>Stopping WhatsApp messages only</h2>
            <p>
                If you simply want to stop receiving WhatsApp notifications and do not want
                anything else deleted, tell the School office and we will remove your number from
                the messaging list. This does not affect your child&rsquo;s enrolment or any school service.
            </p>

            <h2>Contact us</h2>
            <div class="contact">
                <strong>Sir Syed Model High School (Boys &amp; Girls)</strong><br />
                Chhonawala Road, Hasilpur, Pakistan<br />
                Phone: 0333-6335634 &nbsp;|&nbsp; 0301-7330101<br />
                Email: <a href="mailto:ssmhschools@gmail.com">ssmhschools@gmail.com</a>
            </div>

            <p style="margin-top:18px;">
                See also our <a href="/privacy">Privacy Policy</a>.
            </p>
        </div>

        <footer>&copy; @DateTime.Now.Year Sir Syed Model High School</footer>
    </div>
</body>
</html>
