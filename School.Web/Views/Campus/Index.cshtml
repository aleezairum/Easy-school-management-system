@{
    ViewData["Title"] = "Campus Management";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    .table tbody tr.selected {
        background: #ecfdf5;
        border-left: 3px solid #008649;
    }

    .loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255, 255, 255, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 100;
        border-radius: 16px;
    }

    .spinner-border {
        width: 3rem;
        height: 3rem;
        border-width: 0.3rem;
    }

    .form-section {
        background: #f8fafc;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .form-section-title {
        font-size: 14px;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 2px solid #e2e8f0;
    }

    .grid-section {
        margin-top: 24px;
    }

    .grid-section-title {
        font-size: 14px;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 2px solid #e2e8f0;
    }
</style>

<div class="container-fluid">
    <!-- Alert Messages -->
    <div id="alertContainer"></div>

    <!-- Campus Card -->
    <div class="card">
        <div class="card-body position-relative">
            <div id="loadingOverlay" class="loading-overlay" style="display: none;">
                <div class="spinner-border text-success" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>

            <!-- Form Section -->
            <div class="form-section">
                <div class="form-section-title">
                    <i class="bi bi-pencil-square me-2"></i><span id="formTitle">Add New Campus</span>
                </div>
                <form id="campusForm">
                    <input type="hidden" id="campusId" value="0" />

                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label for="campusName" class="form-label">Campus Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="campusName" placeholder="e.g., Main Campus, City Campus" required />
                        </div>
                        <div class="col-md-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="isActive" checked />
                                <label class="form-check-label" for="isActive">Active</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-primary" onclick="saveCampus()">
                                    <i class="bi bi-check-lg me-1"></i> Save
                                </button>
                                <button type="button" class="btn btn-secondary" onclick="resetForm()">
                                    <i class="bi bi-x-lg me-1"></i> Clear
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Grid Section -->
            <div class="grid-section">
                <div class="grid-section-title">
                    <i class="bi bi-table me-2"></i>Campus List
                </div>
                <div class="table-responsive">
                    <table class="table table-hover" id="campusTable">
                        <thead>
                            <tr>
                                <th style="width: 60px;">Sr#</th>
                                <th>Campus Name</th>
                                <th class="text-center" style="width: 100px;">Status</th>
                                <th class="text-center" style="width: 150px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="campusBody">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let editingCampusId = 0;

        $(document).ready(function () {
            loadCampuses();
        });

        async function loadCampuses() {
            showLoading();
            try {
                const response = await fetch(`${API_BASE}/campus`);
                if (response.ok) {
                    const campuses = await response.json();
                    renderCampusList(campuses);
                } else {
                    showAlert('Failed to load campuses', 'danger');
                }
            } catch (error) {
                console.error('Error loading campuses:', error);
                showAlert('Error loading campuses: ' + error.message, 'danger');
            } finally {
                hideLoading();
            }
        }

        function renderCampusList(campuses) {
            const tbody = $('#campusBody');
            tbody.empty();

            if (campuses.length === 0) {
                tbody.html('<tr><td colspan="4" class="text-center text-muted py-4">No campuses found. Add a new campus using the form above.</td></tr>');
                return;
            }

            campuses.forEach((item, index) => {
                const row = `
                    <tr data-id="${item.viD}" class="${editingCampusId === item.viD ? 'selected' : ''}">
                        <td>${index + 1}</td>
                        <td><strong>${item.vName}</strong></td>
                        <td class="text-center">
                            <span class="badge ${item.isActive ? 'bg-success' : 'bg-secondary'}">
                                ${item.isActive ? 'Active' : 'Inactive'}
                            </span>
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-info me-1" onclick="editCampus(${item.vid})" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </button>
                        </td>
                    </tr>
                `;
                tbody.append(row);
            });
        }

        async function editCampus(campusId) {
            showLoading();
            try {
                const response = await fetch(`${API_BASE}/campus/${campusId}`);
                if (response.ok) {
                    const data = await response.json();
                    populateForm(data);
                    editingCampusId = campusId;
                    $('#formTitle').text('Edit Campus');

                    $('#campusBody tr').removeClass('selected');
                    $(`#campusBody tr[data-id="${campusId}"]`).addClass('selected');

                    $('html, body').animate({
                        scrollTop: $('.form-section').offset().top - 100
                    }, 300);
                } else {
                    showAlert('Failed to load campus', 'danger');
                }
            } catch (error) {
                console.error('Error loading campus:', error);
                showAlert('Error loading campus: ' + error.message, 'danger');
            } finally {
                hideLoading();
            }
        }

        async function deleteCampus(campusId, campusName) {
            if (!await confirmDelete(`Delete the campus <b>${campusName}</b>?`)) {
                return;
            }

            showLoading();
            try {
                const response = await fetch(`${API_BASE}/campus/${campusId}`, {
                    method: 'DELETE'
                });

                if (response.ok) {
                    showAlert('Campus deleted successfully!', 'success');
                    if (editingCampusId === campusId) {
                        resetForm();
                    }
                    await loadCampuses();
                } else {
                    const error = await response.json();
                    showAlert(error.message || 'Failed to delete campus', 'danger');
                }
            } catch (error) {
                console.error('Error deleting campus:', error);
                showAlert('Error deleting campus: ' + error.message, 'danger');
            } finally {
                hideLoading();
            }
        }

        function populateForm(data) {
            $('#campusId').val(data.vid);
            $('#campusName').val(data.vName);
            $('#isActive').prop('checked', data.isActive);
        }

        function resetForm() {
            $('#campusId').val('0');
            $('#campusName').val('');
            $('#isActive').prop('checked', true);
            $('#formTitle').text('Add New Campus');
            editingCampusId = 0;

            $('#campusBody tr').removeClass('selected');
        }

        async function saveCampus() {
            const campusName = $('#campusName').val().trim();

            if (!campusName) {
                showAlert('Please enter a campus name', 'danger');
                $('#campusName').focus();
                return;
            }

            const campusId = parseInt($('#campusId').val()) || 0;
            const data = {
                VID: campusId,
                VName: campusName,
                IsActive: $('#isActive').is(':checked')
            };

            showLoading();
            try {
                let response;

                response = await fetch(`${API_BASE}/campus`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });

                if (response.ok) {
                    showAlert(campusId === 0 ? 'Campus created successfully!' : 'Campus updated successfully!', 'success');
                    resetForm();
                    await loadCampuses();
                } else {
                    const error = await response.json();
                    showAlert(error.message || 'Failed to save campus', 'danger');
                }
            } catch (error) {
                console.error('Error saving campus:', error);
                showAlert('Error saving campus: ' + error.message, 'danger');
            } finally {
                hideLoading();
            }
        }

        function showLoading() {
            $('#loadingOverlay').show();
        }

        function hideLoading() {
            $('#loadingOverlay').hide();
        }

        function showAlert(message, type) {
            if (type === 'success') {
                toastSuccess(message);
            } else if (type === 'danger' || type === 'error') {
                toastError(message);
            } else if (type === 'warning') {
                toastWarning(message);
            } else {
                toastInfo(message);
            }
        }
    </script>
}
