<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - School Management System</title>
    <partial name="_PwaHead" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            font-family: 'Inter', sans-serif;
        }

        :root {
            --primary-color: #008649;
            --primary-dark: #006d3b;
            --primary-light: #00a65a;
        }

        html, body {
            height: 100%;
        }

        body {
            margin: 0;
            padding: 0;
            height: 100vh;
            overflow: hidden;
            background: #f0f4f8;
        }

        .login-wrapper {
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        .login-left {
            flex: 1.1;
            background: linear-gradient(135deg, #008649 0%, #006d3b 55%, #00502b 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 40px 32px;
            position: relative;
            overflow: hidden;
        }

        /* Decorative pattern overlay */
        .login-left::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(circle at 20% 30%, rgba(255,255,255,0.08) 0%, transparent 50%),
                              radial-gradient(circle at 80% 70%, rgba(255,255,255,0.06) 0%, transparent 50%);
            pointer-events: none;
        }

        /* Decorative blobs */
        .login-blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(60px);
            z-index: 0;
            pointer-events: none;
        }

        .login-blob-1 {
            width: 340px;
            height: 340px;
            background: #10b981;
            top: -90px;
            left: -100px;
            opacity: 0.45;
        }

        .login-blob-2 {
            width: 300px;
            height: 300px;
            background: #22d3ee;
            bottom: -80px;
            right: -80px;
            opacity: 0.3;
        }

        .login-blob-3 {
            width: 220px;
            height: 220px;
            background: #fbbf24;
            top: 45%;
            left: 55%;
            opacity: 0.22;
        }

        .login-blob-4 {
            position: absolute;
            width: 160px;
            height: 160px;
            border-radius: 50%;
            filter: blur(50px);
            background: #a78bfa;
            top: 15%;
            right: 10%;
            opacity: 0.25;
            z-index: 0;
            pointer-events: none;
        }

        .login-left-content {
            position: relative;
            z-index: 1;
            text-align: center;
            color: #ffffff;
            max-width: 430px;
        }

        .logo-card {
            width: 170px;
            height: 170px;
            background: #ffffff;
            border-radius: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 26px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25),
                        0 8px 20px rgba(0, 0, 0, 0.12),
                        inset 0 0 0 1px rgba(255, 255, 255, 0.6);
            padding: 20px;
            transition: transform 0.3s ease;
            position: relative;
        }

            .logo-card::after {
                content: '';
                position: absolute;
                inset: -6px;
                border-radius: 36px;
                background: linear-gradient(135deg, rgba(255,255,255,0.35), rgba(255,255,255,0));
                z-index: -1;
                filter: blur(8px);
            }

            .logo-card:hover {
                transform: translateY(-4px) scale(1.03);
            }

            .logo-card img {
                width: 100%;
                height: 100%;
                object-fit: contain;
            }

        .login-left-content h1 {
            font-size: 30px;
            font-weight: 700;
            margin-bottom: 12px;
            color: #ffffff;
            letter-spacing: -0.4px;
            text-shadow: 0 2px 8px rgba(0,0,0,0.15);
        }

        .login-left-content p {
            font-size: 14px;
            color: rgba(255, 255, 255, 0.88);
            max-width: 360px;
            line-height: 1.6;
            margin: 0 auto 28px;
        }

        .features-list {
            margin-top: 8px;
            text-align: left;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            max-width: 400px;
            margin-left: auto;
            margin-right: auto;
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            background: rgba(255, 255, 255, 0.14);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.22);
            transition: all 0.25s ease;
        }

            .feature-item:hover {
                background: rgba(255, 255, 255, 0.22);
                border-color: rgba(255, 255, 255, 0.4);
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
            }

        .feature-icon {
            width: 30px;
            height: 30px;
            min-width: 30px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
        }

            .feature-icon i {
                font-size: 14px;
            }

        /* Distinct accent colors per feature card icon */
        .feature-item:nth-child(1) .feature-icon {
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            box-shadow: 0 4px 10px rgba(59, 130, 246, 0.35);
        }

        .feature-item:nth-child(2) .feature-icon {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            box-shadow: 0 4px 10px rgba(245, 158, 11, 0.35);
        }

        .feature-item:nth-child(3) .feature-icon {
            background: linear-gradient(135deg, #ec4899, #db2777);
            box-shadow: 0 4px 10px rgba(236, 72, 153, 0.35);
        }

        .feature-item:nth-child(4) .feature-icon {
            background: linear-gradient(135deg, #8b5cf6, #7c3aed);
            box-shadow: 0 4px 10px rgba(139, 92, 246, 0.35);
        }

        .feature-item span {
            font-size: 12px;
            font-weight: 500;
            color: #ffffff;
            line-height: 1.3;
        }

        .login-right {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            background: white;
            overflow-y: auto;
            position: relative;
        }

        .login-form-container {
            width: 100%;
            max-width: 380px;
        }

        /* Compact logo shown only when left panel hidden (small screens) */
        .login-brand-mobile {
            display: none;
            justify-content: center;
            margin-bottom: 18px;
        }

            .login-brand-mobile img {
                width: 72px;
                height: 72px;
                object-fit: contain;
                padding: 10px;
                background: #ffffff;
                border-radius: 16px;
                box-shadow: 0 4px 16px rgba(0, 134, 73, 0.15);
                border: 1px solid rgba(0, 134, 73, 0.08);
            }

        .login-header {
            margin-bottom: 22px;
            text-align: center;
        }

        .login-header h2 {
            font-size: 22px;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 4px;
            letter-spacing: -0.2px;
        }

        .login-header p {
            color: #64748b;
            font-size: 12.5px;
            margin: 0;
        }

        .form-label {
            font-weight: 500;
            color: #334155;
            font-size: 12px;
            margin-bottom: 5px;
        }

        .form-control, .form-select {
            padding: 8px 12px;
            border: 1.5px solid #e2e8f0;
            border-radius: 7px;
            font-size: 13px;
            transition: all 0.2s;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(0, 134, 73, 0.1);
        }

        .input-group {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            z-index: 10;
            font-size: 14px;
        }

        .input-group .form-control {
            padding-left: 34px;
        }

        .mb-4 {
            margin-bottom: 12px !important;
        }

        .mb-3 {
            margin-bottom: 10px !important;
        }

        .btn-login {
            width: 100%;
            padding: 9px;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
            border: none;
            border-radius: 7px;
            font-size: 13px;
            font-weight: 600;
            color: white;
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 3px 10px rgba(0, 134, 73, 0.25);
        }

        .btn-login:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(0, 134, 73, 0.35);
            background: linear-gradient(135deg, var(--primary-dark) 0%, #005a30 100%);
        }

        .btn-login:active {
            transform: translateY(0);
        }

        .form-check {
            margin: 10px 0;
        }

        .form-check-input {
            width: 14px;
            height: 14px;
        }

        .form-check-input:checked {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
        }

        .form-check-label {
            color: #64748b;
            font-size: 12px;
        }

        .alert {
            border: none;
            border-radius: 7px;
            padding: 8px 12px;
            font-size: 12px;
        }

        .alert-danger {
            background: #fef2f2;
            color: #dc2626;
        }

        .select-wrapper {
            position: relative;
        }

        .select-wrapper .select-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            z-index: 10;
            pointer-events: none;
            font-size: 14px;
        }

        .select-wrapper .form-select {
            padding-left: 34px;
        }

        @@media (max-width: 992px) {
            .login-left {
                display: none;
            }

            .login-brand-mobile {
                display: flex;
            }
        }

        /* Short viewports: shrink features to prevent vertical scroll */
        @@media (max-height: 760px) {
            .logo-card {
                width: 130px;
                height: 130px;
                margin-bottom: 18px;
                padding: 16px;
                border-radius: 26px;
            }

            .login-left-content h1 {
                font-size: 24px;
                margin-bottom: 8px;
            }

            .login-left-content p {
                margin-bottom: 18px;
                font-size: 13px;
            }

            .features-list {
                gap: 8px;
            }

            .feature-item {
                padding: 8px 10px;
            }

            .login-left {
                padding: 24px;
            }
        }

        @@media (max-height: 600px) {
            .features-list {
                display: none;
            }

            .logo-card {
                width: 100px;
                height: 100px;
                padding: 12px;
                border-radius: 20px;
            }
        }
    </style>
</head>
<body>
    @RenderBody()
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/pwa.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
