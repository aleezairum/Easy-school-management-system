@model School.Web.Controllers.ExamController.ExamResultSheetPayload
@{
    Layout = null;
    ViewBag.Title = "Result Sheet";

    var className   = ViewData["ClassName"] as string;
    var sectionName = ViewData["SectionName"] as string;
    var examName    = ViewData["ExamName"] as string;

    var subjects = Model?.Subjects ?? new();
    var students = Model?.Students ?? new();

    var subjectCount = subjects.Count;
    var totalMax  = subjects.Sum(s => s.TotalMarks ?? 0);
    var totalPass = subjects.Sum(s => s.PassMarks ?? 0);

    string Marks(decimal? v) => v.HasValue ? (v.Value == Math.Floor(v.Value) ? ((long)v.Value).ToString() : v.Value.ToString("0.##")) : "-";
    string Pct(decimal? v)   => v.HasValue ? v.Value.ToString("0.00") + "%" : "-";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Result Sheet - Sir Syed Model High School</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
            background: #fff;
            color: #000;
            padding: 0 10px 10px;
        }

        .page-wrapper {
            padding: 0 10px 10px;
            max-width: 1200px;
            margin: 0 auto;
        }

        /* ── Header ── */
        .school-header {
            text-align: center;
            border: 1.5px solid #aaa;
            padding: 4px 4px;
            margin-bottom: 4px;
        }

        .school-name {
            font-size: 18px;
            font-weight: bold;
            letter-spacing: 0.5px;
        }

        .school-address {
            font-size: 13px;
            font-weight: bold;
            margin-top: 1px;
        }

        /* ── Meta row ── */
        .meta-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 4px;
            flex-wrap: wrap;
            gap: 4px;
            background-color: #000;
            color: #fff;
            padding: 4px 12px;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .meta-row span {
            white-space: nowrap;
        }

        .meta-row .title {
            font-size: 18px;
            font-weight: bold;
            letter-spacing: 1px;
        }

        /* ── Table ── */
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11.5px;
        }

        thead tr th,
        tbody tr td {
            border: 1px solid #555;
            text-align: center;
            padding: 1px 3px;
            vertical-align: middle;
        }

        thead tr th {
            background-color: #f0f0f0;
            font-weight: bold;
        }

        /* Narrow numeric / subject columns */
        .col-num   { width: 28px; }
        .col-roll  { width: 46px; }
        .col-pos   { width: 34px; }
        .col-pct   { width: 50px; }
        .col-res   { width: 46px; }
        .col-total { width: 46px; }
        .col-sub   { width: 38px; }

        /* Left-align name columns and let them take the remaining width on one line */
        .col-name {
            text-align: left !important;
            padding-left: 6px !important;
            white-space: nowrap;
            width: 16%;
        }

        /* Max marks / pass marks rows */
        .marks-row td {
            background-color: #f9f9f9;
            font-weight: 600;
            text-align: center;
            border: 1px solid #555;
        }

        /* Pass/Fail colouring */
        .result-pass {
            color: #1a6b1a;
            font-weight: bold;
        }

        .result-fail {
            color: #c00;
            font-weight: bold;
        }

        /* Alternate row shading */
        tbody tr.data-row:nth-child(even) {
            background-color: #fafafa;
        }

        tbody tr.data-row:nth-child(odd) {
            background-color: #fff;
        }

        .empty-msg {
            text-align: center;
            padding: 24px;
            color: #777;
            font-style: italic;
        }

        /* Print toolbar (hidden when printing) */
        .print-toolbar {
            max-width: 1200px;
            margin: 0 auto 8px;
            text-align: right;
        }

        .print-toolbar .btn-print {
            background: #1a7a3e;
            color: #fff;
            border: none;
            padding: 8px 22px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }

        .print-toolbar .btn-close-win {
            background: #555;
            color: #fff;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 13px;
            cursor: pointer;
            margin-left: 8px;
        }

        @@page {
            size: A4 landscape;
            /* margin 0 removes the browser-added date/title header and URL footer */
            margin: 0;
        }

        /* Print styles */
        @@media print {
            /* keep content off the paper edge since the page margin is now 0 */
            body { padding: 3mm 8mm 6mm; }
            .page-wrapper { border: none; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body>
<div class="print-toolbar no-print">
    <button type="button" class="btn-print" onclick="window.print()">
        Print
    </button>
    <button type="button" class="btn-close-win" onclick="window.close()">
        Close
    </button>
</div>

<div class="page-wrapper">

    <!-- School Header -->
    <div class="school-header">
        <div class="school-name">SIR SYED MODEL HIGH SCHOOL (Boys&amp;Girls)</div>
        <div class="school-address">Chhonawala Road, Hasilpur &nbsp; 0333-6335634 , 0301-7330101</div>
    </div>

    <!-- Meta Row -->
    <div class="meta-row">
        <span><strong>Class:</strong> @(string.IsNullOrWhiteSpace(className) ? "-" : className) &nbsp;&nbsp; <strong>Section:</strong> @(string.IsNullOrWhiteSpace(sectionName) ? "-" : sectionName)</span>
        <span><strong>Exam:</strong> @(string.IsNullOrWhiteSpace(examName) ? "-" : examName)</span>
        <span class="title">RESULT SHEET</span>
        <span><strong>Total Marks: @Marks(totalMax)</strong></span>
        <span><strong>Passing Marks: @Marks(totalPass)</strong></span>
    </div>

    @if (students.Count == 0)
    {
        <div class="empty-msg">No results found for the selected Class, Section and Exam.</div>
    }
    else
    {
        <!-- Result Table -->
        <table>
            <thead>
                <tr>
                    <th rowspan="3" class="col-num">Sr#</th>
                    <th rowspan="3" class="col-roll">Roll #</th>
                    <th rowspan="3" class="col-name" style="text-align:left; padding-left:6px;">Student Name</th>
                    <th rowspan="3" class="col-name" style="text-align:left; padding-left:6px;">Father Name</th>
                    <th rowspan="3" class="col-pos">Pos.</th>
                    <th rowspan="3" class="col-pct">Current%</th>
                    <th rowspan="3" class="col-pct">Prev.%</th>
                    <th rowspan="3" class="col-res">Result</th>
                    @foreach (var sub in subjects)
                    {
                        <th class="col-sub">@sub.SubjectName</th>
                    }
                    <th rowspan="3" class="col-total">Total</th>
                </tr>
                <tr class="marks-row">
                    @foreach (var sub in subjects)
                    {
                        <td>@Marks(sub.TotalMarks)</td>
                    }
                </tr>
                <tr class="marks-row">
                    @foreach (var sub in subjects)
                    {
                        <td>@Marks(sub.PassMarks)</td>
                    }
                </tr>
            </thead>
            <tbody>
                @{ var srNo = 0; }
                @foreach (var s in students)
                {
                    srNo++;
                    <tr class="data-row">
                        <td class="col-num">@srNo</td>
                        <td class="col-roll">@s.RollNo</td>
                        <td class="col-name">@s.StudentName</td>
                        <td class="col-name">@s.FatherName</td>
                        <td class="col-pos">@(s.Position.HasValue ? s.Position.Value.ToString() : "-")</td>
                        <td class="col-pct">@Pct(s.CurrentPct)</td>
                        <td class="col-pct">@Pct(s.PrevPct)</td>
                        <td class="col-res @(s.Result == "Pass" ? "result-pass" : "result-fail")">@s.Result</td>
                        @foreach (var sub in subjects)
                        {
                            var key = sub.SubjectName ?? "";
                            var mark = s.Marks != null && s.Marks.ContainsKey(key) ? s.Marks[key] : null;
                            <td class="col-sub">@Marks(mark)</td>
                        }
                        <td class="col-total"><strong>@Marks(s.Total)</strong></td>
                    </tr>
                }
            </tbody>
        </table>
    }

</div>
</body>
</html>
