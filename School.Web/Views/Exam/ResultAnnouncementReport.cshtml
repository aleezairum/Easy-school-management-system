@model School.Web.Controllers.ExamController.AnnouncementPayload
@{
    Layout = null;
    ViewBag.Title = "Result Announcement";

    var examName = ViewData["ExamName"] as string;
    var scopeText = ViewData["ScopeText"] as string;

    var overall   = Model?.Overall ?? new School.Web.Controllers.ExamController.ResultStatRow();
    var campuses  = Model?.Campuses ?? new List<School.Web.Controllers.ExamController.ResultStatRow>();
    var classes   = Model?.Classes ?? new List<School.Web.Controllers.ExamController.ResultStatRow>();
    var positions = Model?.TopPositions ?? new List<School.Web.Controllers.ExamController.AnnouncementTopRow>();

    string Pct(decimal? v) => v.HasValue ? v.Value.ToString("0.00") + "%" : "-";
    string Marks(decimal? v) => v.HasValue ? (v.Value == Math.Floor(v.Value) ? ((long)v.Value).ToString() : v.Value.ToString("0.##")) : "-";

    // Friendly heading per scope shown inside each class block.
    string ScopeLabel(string? s) => s switch
    {
        "Girls" => "Girls Section (1st / 2nd / 3rd)",
        "Boys"  => "Boys Section (1st / 2nd / 3rd)",
        _       => "Overall (1st / 2nd / 3rd)"
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Result Announcement – Sir Syed Model High School</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        /* Force background colors / shading to render when printing */
        html, body, table, th, td, tr {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
            color-adjust: exact !important;
        }

        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
            background: #fff;
            color: #000;
            padding: 12px;
        }

        .page-wrapper {
            border: 2px solid #555;
            max-width: 820px;
            margin: 0 auto;
        }

        /* ── School Header ── */
        .school-header {
            text-align: center;
            border-bottom: 2px solid #555;
            padding: 10px 4px 8px;
        }
        .school-name    { font-size: 21px; font-weight: bold; }
        .school-address { font-size: 14.5px; font-weight: bold; margin-top: 3px; }

        /* ── Title ── */
        .report-title {
            background-color: #d6d6d6;
            text-align: center;
            font-size: 14px;
            font-weight: bold;
            padding: 7px 4px;
            border-bottom: 1px solid #555;
            letter-spacing: 0.5px;
        }

        .exam-row {
            text-align: center;
            font-size: 12.5px;
            font-weight: 600;
            padding: 5px 8px;
            border-bottom: 1px solid #555;
        }

        /* ── Section heading ── */
        .section-heading {
            background-color: #1a1a1a;
            color: #fff;
            text-align: center;
            font-weight: bold;
            font-size: 12.5px;
            padding: 5px 4px;
            border-bottom: 1px solid #555;
        }

        /* ── Tables ── */
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11.5px;
        }

        table th, table td {
            border: 1px solid #555;
            padding: 4px 6px;
            text-align: center;
            vertical-align: middle;
        }

        table th { background-color: #efefef; font-weight: bold; }

        td.col-left, th.col-left { text-align: left; padding-left: 8px; }

        tr.overall-row td { font-weight: bold; background-color: #f4f8ff; }

        /* Class group header (banner) above each positions table */
        tr.class-group td,
        tr.class-group th {
            background-color: #d6d6d6 !important;
            color: #000;
            font-weight: bold;
            text-align: left;
            padding-left: 8px;
            font-size: 12.5px;
        }

        /* Scope sub-heading (Overall / Girls Section / Boys Section) inside a class */
        tr.scope-row td {
            background-color: #eef3ee !important;
            color: #000;
            font-weight: bold;
            text-align: left;
            padding-left: 8px;
            font-size: 11.5px;
        }

        /* One table per class — small gap between them */
        .positions-table { margin-bottom: 6px; }
        .positions-table:last-child { margin-bottom: 0; }

        .empty-msg { text-align: center; padding: 14px; color: #777; font-style: italic; }

        .block { border-bottom: 2px solid #555; }

        /* Print toolbar (hidden when printing) */
        .print-toolbar { max-width: 820px; margin: 0 auto 8px; text-align: right; }
        .print-toolbar .btn-print {
            background: #1a7a3e; color: #fff; border: none;
            padding: 8px 22px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;
        }
        .print-toolbar .btn-close-win {
            background: #555; color: #fff; border: none;
            padding: 8px 16px; border-radius: 6px; font-size: 13px; cursor: pointer; margin-left: 8px;
        }

        /* ── Print ── */
        /* margin:0 removes the browser's auto date/title (top) and URL (bottom) */
        @@page { size: A4 portrait; margin: 0; }

        @@media print {
            * {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
                color-adjust: exact !important;
            }
            body { padding: 6mm 8mm; }
            .no-print { display: none !important; }
            .page-wrapper { border: 2px solid #555; }
        }
    </style>
</head>
<body>

<div class="print-toolbar no-print">
    <button type="button" class="btn-print" onclick="window.print()">Print</button>
    <button type="button" class="btn-close-win" onclick="window.close()">Close</button>
</div>

<div class="page-wrapper">

    <!-- School Header -->
    <div class="school-header">
        <div class="school-name">SIR SYED MODEL HIGH SCHOOL (Boys&amp;Girls)</div>
        <div class="school-address">Chhonawala Road, Hasilpur &nbsp; 0333-6335634 , 0301-7330101</div>
    </div>

    <!-- Title -->
    <div class="report-title">RESULT ANNOUNCEMENT REPORT</div>
    <div class="exam-row">
        <strong>Exam :</strong> @(string.IsNullOrWhiteSpace(examName) ? "-" : examName)
        &nbsp;&nbsp;|&nbsp;&nbsp;
        <strong>Scope :</strong> @(string.IsNullOrWhiteSpace(scopeText) ? "Whole School" : scopeText)
    </div>

    <!-- 1) Overall (whole school) -->
    <div class="block">
        <div class="section-heading">Overall Result (Whole School)</div>
        <table>
            <thead>
                <tr>
                    <th>Total Students</th>
                    <th>Total Pass</th>
                    <th>Total Fail</th>
                    <th>Pass %</th>
                    <th>Fail %</th>
                </tr>
            </thead>
            <tbody>
                <tr class="overall-row">
                    <td>@overall.TotalStudents</td>
                    <td>@overall.TotalPass</td>
                    <td>@overall.TotalFail</td>
                    <td>@Pct(overall.PassPct)</td>
                    <td>@Pct(overall.FailPct)</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- 2) Campus wise -->
    <div class="block">
        <div class="section-heading">Campus Wise Result</div>
        <table>
            <thead>
                <tr>
                    <th class="col-left">Campus</th>
                    <th>Total</th>
                    <th>Pass</th>
                    <th>Fail</th>
                    <th>Pass %</th>
                    <th>Fail %</th>
                </tr>
            </thead>
            <tbody>
                @if (campuses.Count == 0)
                {
                    <tr><td colspan="6" class="empty-msg">No data.</td></tr>
                }
                else
                {
                    @foreach (var c in campuses)
                    {
                        <tr>
                            <td class="col-left">@c.Name</td>
                            <td>@c.TotalStudents</td>
                            <td>@c.TotalPass</td>
                            <td>@c.TotalFail</td>
                            <td>@Pct(c.PassPct)</td>
                            <td>@Pct(c.FailPct)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- 3) Class wise -->
    <div class="block">
        <div class="section-heading">Class Wise Result</div>
        <table>
            <thead>
                <tr>
                    <th class="col-left">Class</th>
                    <th>Total</th>
                    <th>Pass</th>
                    <th>Fail</th>
                    <th>Pass %</th>
                    <th>Fail %</th>
                </tr>
            </thead>
            <tbody>
                @if (classes.Count == 0)
                {
                    <tr><td colspan="6" class="empty-msg">No data.</td></tr>
                }
                else
                {
                    @foreach (var c in classes)
                    {
                        <tr>
                            <td class="col-left">@c.Name</td>
                            <td>@c.TotalStudents</td>
                            <td>@c.TotalPass</td>
                            <td>@c.TotalFail</td>
                            <td>@Pct(c.PassPct)</td>
                            <td>@Pct(c.FailPct)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- 4) Top positions per class -->
    <div>
        <div class="section-heading">Class Positions (1st / 2nd / 3rd)</div>
        @if (positions.Count == 0)
        {
            <div class="empty-msg">No data.</div>
        }
        else
        {
            @foreach (var grp in positions.GroupBy(p => p.ClassName))
            {
                <table class="positions-table">
                    <thead>
                        <tr class="class-group"><th colspan="8">@grp.Key</th></tr>
                        <tr>
                            <th>Position</th>
                            <th>Roll #</th>
                            <th class="col-left">Name</th>
                            <th class="col-left">Father Name</th>
                            <th>Section</th>
                            <th>T.Marks</th>
                            <th>Obt. Marks</th>
                            <th>%age</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* Overall first, then Girls, then Boys (ScopeOrder), each with its own sub-heading *@
                        @foreach (var scope in grp.GroupBy(p => p.Scope).OrderBy(s => s.First().ScopeOrder))
                        {
                            <tr class="scope-row"><td colspan="8">@ScopeLabel(scope.Key)</td></tr>
                            @foreach (var p in scope)
                            {
                                <tr>
                                    <td>@(p.Position.HasValue ? p.Position.Value.ToString() : "-")</td>
                                    <td>@p.RollNo</td>
                                    <td class="col-left">@p.StudentName</td>
                                    <td class="col-left">@p.FatherName</td>
                                    <td>@p.SectionName</td>
                                    <td>@Marks(p.TotalMarks)</td>
                                    <td>@Marks(p.ObtainedMarks)</td>
                                    <td>@Pct(p.Percent)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
        }
    </div>

</div>
</body>
</html>
