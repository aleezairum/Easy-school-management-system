@{
    ViewData["Title"] = "Exams";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    .table tbody tr.selected {
        background: #ecfdf5;
        border-left: 3px solid #008649;
    }

    .loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255, 255, 255, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 100;
        border-radius: 16px;
    }

    .spinner-border {
        width: 3rem;
        height: 3rem;
        border-width: 0.3rem;
    }

    .form-section {
        background: #f8fafc;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .form-section-title {
        font-size: 14px;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 2px solid #e2e8f0;
    }

    .grid-section {
        margin-top: 24px;
    }

    .grid-section-title {
        font-size: 14px;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 2px solid #e2e8f0;
    }
</style>

<div class="container-fluid">
    <!-- Alert Messages -->
    <div id="alertContainer"></div>

    <!-- Exams Card -->
    <div class="card">
        <div class="card-body position-relative">
            <div id="loadingOverlay" class="loading-overlay" style="display: none;">
                <div class="spinner-border text-success" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>

            <!-- Form Section -->
            <div class="form-section">
                <div class="form-section-title">
                    <i class="bi bi-pencil-square me-2"></i><span id="formTitle">Add New Exam</span>
                </div>
                <form id="examForm">
                    <input type="hidden" id="examId" value="0" />

                    <div class="row g-3 align-items-end">
                        <div class="col-md-6">
                            <label for="examName" class="form-label">Exam Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="examName" placeholder="e.g., Mid Term Exam" required />
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-primary" onclick="saveExam()">
                                    <i class="bi bi-check-lg me-1"></i> Save
                                </button>
                                <button type="button" class="btn btn-secondary" onclick="resetForm()">
                                    <i class="bi bi-x-lg me-1"></i> Clear
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Grid Section -->
            <div class="grid-section">
                <div class="grid-section-title">
                    <i class="bi bi-table me-2"></i>Exams List
                </div>
                <div class="table-responsive">
                    <table class="table table-hover" id="examsTable">
                        <thead>
                            <tr>
                                <th style="width: 60px;">Sr#</th>
                                <th>Exam Name</th>
                                <th class="text-center" style="width: 180px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="examsBody">
                            <!-- Exams will be loaded dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        let editingId = 0;
        let allExams = [];

        $(document).ready(function () {
            loadExams();
        });

        async function loadExams() {
            showLoading();
            try {
                const response = await fetch(`${API_BASE}/exam`);
                if (response.ok) {
                    allExams = await response.json();
                    renderList(allExams);
                } else {
                    showAlert('Failed to load exams', 'danger');
                }
            } catch (error) {
                console.error('Error loading exams:', error);
                showAlert('Error loading exams: ' + error.message, 'danger');
            } finally {
                hideLoading();
            }
        }

        function renderList(items) {
            const tbody = $('#examsBody');
            tbody.empty();

            if (!items || items.length === 0) {
                tbody.html('<tr><td colspan="3" class="text-center text-muted py-4">No exams found. Add a new exam using the form above.</td></tr>');
                return;
            }

            items.forEach((item, index) => {
                const row = `
                    <tr data-id="${item.vid}" class="${editingId === item.vid ? 'selected' : ''}">
                        <td>${index + 1}</td>
                        <td><strong>${item.vName}</strong></td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-warning me-1" onclick="viewResults(${item.vid})" title="Results">
                                <i class="bi bi-clipboard-data"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-info me-1" onclick="editExam(${item.vid})" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </button>
                        </td>
                    </tr>
                `;
                tbody.append(row);
            });
        }

        function viewResults(examId) {
            window.location.href = `/exam/results/${examId}`;
        }

        async function editExam(id) {
            showLoading();
            try {
                const response = await fetch(`${API_BASE}/exam/${id}`);
                if (response.ok) {
                    const data = await response.json();
                    populateForm(data);
                    editingId = id;
                    $('#formTitle').text('Edit Exam');

                    $('#examsBody tr').removeClass('selected');
                    $(`#examsBody tr[data-id="${id}"]`).addClass('selected');

                    $('html, body').animate({
                        scrollTop: $('.form-section').offset().top - 100
                    }, 300);
                } else {
                    showAlert('Failed to load exam', 'danger');
                }
            } catch (error) {
                console.error('Error loading exam:', error);
                showAlert('Error loading exam: ' + error.message, 'danger');
            } finally {
                hideLoading();
            }
        }

        async function deleteExam(id, name) {
            if (!await confirmDelete(`Are you sure you want to delete "${name}"?`)) return;

            showLoading();
            try {
                const response = await fetch(`${API_BASE}/exam/${id}`, { method: 'DELETE' });

                if (response.ok) {
                    const result = await response.json();
                    if (result && result.returnCode === 200) {
                        showAlert('Exam deleted successfully!', 'success');
                        if (editingId === id) resetForm();
                        await loadExams();
                    } else {
                        showAlert(result?.returnMessage || 'Failed to delete exam', 'danger');
                    }
                } else {
                    showAlert('Failed to delete exam', 'danger');
                }
            } catch (error) {
                console.error('Error deleting exam:', error);
                showAlert('Error deleting exam: ' + error.message, 'danger');
            } finally {
                hideLoading();
            }
        }

        function populateForm(data) {
            $('#examId').val(data.vid);
            $('#examName').val(data.vName);
        }

        function resetForm() {
            $('#examId').val('0');
            $('#examName').val('');
            $('#formTitle').text('Add New Exam');
            editingId = 0;
            $('#examsBody tr').removeClass('selected');
        }

        async function saveExam() {
            const id       = parseInt($('#examId').val()) || 0;
            const examName = $('#examName').val().trim();

            if (!examName) {
                showAlert('Please enter exam name', 'danger');
                return;
            }

            const data = {
                VID:      id,
                VName:    examName,
                IsActive: true
            };

            showLoading();
            try {
                const response = await fetch(`${API_BASE}/exam`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    const result = await response.json();
                    if (result && result.returnCode === 200) {
                        showAlert(id === 0 ? 'Exam created successfully!' : 'Exam updated successfully!', 'success');
                        resetForm();
                        await loadExams();
                    } else {
                        showAlert(result?.returnMessage || 'Failed to save exam', 'danger');
                    }
                } else {
                    showAlert('Failed to save exam', 'danger');
                }
            } catch (error) {
                console.error('Error saving exam:', error);
                showAlert('Error saving exam: ' + error.message, 'danger');
            } finally {
                hideLoading();
            }
        }

        function showLoading() { $('#loadingOverlay').show(); }
        function hideLoading() { $('#loadingOverlay').hide(); }

        function showAlert(message, type) {
            if (type === 'success') toastSuccess(message);
            else if (type === 'danger' || type === 'error') toastError(message);
            else if (type === 'warning') toastWarning(message);
            else toastInfo(message);
        }
    </script>
}
