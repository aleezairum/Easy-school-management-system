@model School.Web.Controllers.ExamController.SubjectWiseResultViewModel
@{
    Layout = null;
    ViewBag.Title = "Subject Wise Result";

    var sections = Model?.Sections ?? new List<School.Web.Controllers.ExamController.SubjectWiseSection>();

    // Row headings, in the same order as the printed sheet.
    var rows = new (string Label, System.Func<School.Web.Controllers.ExamController.SubjectResult, string> Value)[]
    {
        ("Total Students",                s => s.TotalStudents.ToString()),
        ("Appeared",                      s => s.Appeared.ToString()),
        ("Passed",                        s => s.Passed.ToString()),
        ("Failed",                        s => s.Failed.ToString()),
        ("Pass % w.r.t Pass Marks",       s => s.PassPercentByPassMarks.ToString("0.##") + "%"),
        ("Total Marks",                   s => s.AggregateTotalMarks.ToString("0.##")),
        ("Total Obtained Marks",          s => s.TotalObtainedMarks.ToString("0.##")),
        ("Pass % w.r.t Obtained Marks",   s => s.PassPercentByObtainedMarks.ToString("0.##") + "%"),
        // Average% = average of the two percentages above (Pass% by Pass Marks + Pass% by Obtained Marks) / 2
        ("Average%",                      s => ((s.PassPercentByPassMarks + s.PassPercentByObtainedMarks) / 2m).ToString("0.##") + "%"),
        ("Position",                      s => s.Position),
        ("Name of Teacher",               s => s.TeacherName),
        ("Signature",                     s => s.Signature),
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1100" />
    <title>Subject Wise Result - Sir Syed Model High School</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
            background: #fff;
            color: #000;
            padding: 0 10px 10px;
        }

        .page-wrapper {
            padding: 0 10px 10px;
            max-width: 1200px;
            margin: 0 auto;
        }

        /* ── Each section is a self-contained report; two fit on one page ── */
        .section-block {
            margin-bottom: 14px;
            page-break-inside: avoid;
            break-inside: avoid;
        }
        /* Force a page break after every 2nd section so a page holds exactly two */
        .section-block:nth-of-type(2n) {
            page-break-after: always;
            break-after: page;
        }
        .section-block:last-of-type {
            page-break-after: auto;
            break-after: auto;
            margin-bottom: 0;
        }

        /* ── Header ── */
        .school-header {
            text-align: center;
            border: 1.5px solid #aaa;
            padding: 4px 4px;
            margin-bottom: 4px;
        }

        .school-name {
            font-size: 18px;
            font-weight: bold;
            letter-spacing: 0.5px;
        }

        .school-address {
            font-size: 13px;
            font-weight: bold;
            margin-top: 1px;
        }

        /* ── Meta row ── */
        .meta-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 4px;
            flex-wrap: wrap;
            gap: 4px;
            background-color: #000;
            color: #fff;
            padding: 4px 12px;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .meta-row span { white-space: nowrap; }

        .meta-row .title {
            font-size: 18px;
            font-weight: bold;
            letter-spacing: 1px;
        }

        /* ── Table ── */
        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;          /* keep all columns inside the page so the right border always prints */
            font-size: 11.5px;
        }

        thead tr th,
        tbody tr td {
            border: 1px solid #555;
            text-align: center;
            padding: 3px 5px;
            vertical-align: middle;
            word-wrap: break-word;
            overflow-wrap: break-word;
        }

        thead tr th {
            background-color: #f0f0f0;
            font-weight: bold;
        }

        /* First two columns: serial no. + heading label (subject columns share the rest) */
        th.col-sr, td.col-sr { width: 30px; }
        th.col-heading, td.col-heading {
            width: 165px;
            text-align: left;
            padding-left: 8px;
            background-color: #f9f9f9;
            font-weight: 600;
            white-space: nowrap;
        }

        /* Alternate row shading on data columns */
        tbody tr:nth-child(even) td:not(.col-heading) { background-color: #fafafa; }

        /* Taller rows for the teacher name (a bit) and signature (reduced height) */
        tbody tr.row-teacher td   { height: 34px; }
        tbody tr.row-signature td { height: 48px; }
        /* keep the Sr.No + "Signature" heading centered; only sign cells sit at the bottom */
        tbody tr.row-signature td:not(.col-heading):not(.col-sr) { vertical-align: bottom; }

        .empty-msg {
            text-align: center;
            padding: 24px;
            color: #777;
            font-style: italic;
        }

        /* Print toolbar (hidden when printing) */
        .print-toolbar {
            max-width: 1200px;
            margin: 0 auto 8px;
            text-align: right;
        }

        .print-toolbar .btn-print {
            background: #1a7a3e;
            color: #fff;
            border: none;
            padding: 8px 22px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }

        .print-toolbar .btn-close-win {
            background: #555;
            color: #fff;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 13px;
            cursor: pointer;
            margin-left: 8px;
        }

        @@page {
            size: A4 landscape;
            /* margin 0 removes the browser-added date/title header and URL footer */
            margin: 0;
        }

        /* Print styles */
        @@media print {
            /* keep content off the paper edge since the page margin is now 0 */
            body { padding: 3mm 8mm 6mm; }
            .page-wrapper { border: none; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body>
<div class="print-toolbar no-print">
    <button type="button" class="btn-print" onclick="window.print()">
        Print
    </button>
    <button type="button" class="btn-close-win" onclick="window.close()">
        Close
    </button>
</div>

<div class="page-wrapper" data-fit="landscape">

    @if (sections.Count == 0)
    {
        <div class="empty-msg">No result data found for this Class / Section / Exam.</div>
    }
    else
    {
        foreach (var section in sections)
        {
            var subjects = section.Subjects ?? new List<School.Web.Controllers.ExamController.SubjectResult>();
            <div class="section-block">
                <!-- School Header -->
                <div class="school-header">
                    <div class="school-name">SIR SYED MODEL HIGH SCHOOL (Boys&amp;Girls), Hasilpur</div>
                </div>

                <!-- Meta Row -->
                <div class="meta-row">
                    <span><strong>Class:</strong> @(string.IsNullOrWhiteSpace(section.Class) ? "-" : section.Class)</span>
                    <span class="title">SUBJECT WISE RESULT</span>
                    <span><strong>Exam:</strong> @(string.IsNullOrWhiteSpace(Model?.Examination) ? "-" : Model.Examination)</span>
                </div>

                @if (subjects.Count == 0)
                {
                    <div class="empty-msg">No result data found for this section.</div>
                }
                else
                {
                    <table>
                        <thead>
                            <tr>
                                <th class="col-sr">Sr.</th>
                                <th class="col-heading">Headings</th>
                                @foreach (var subject in subjects)
                                {
                                    var subjName = subject.Name ?? "";
                                    var pIdx = subjName.IndexOf('(');
                                    <th>
                                        @if (pIdx > 0)
                                        {
                                            @subjName.Substring(0, pIdx).Trim()<br />@subjName.Substring(pIdx).Trim()
                                        }
                                        else
                                        {
                                            @subjName
                                        }
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < rows.Length; i++)
                            {
                                var row = rows[i];
                                var rowClass = row.Label == "Name of Teacher" ? "row-teacher"
                                             : row.Label == "Signature"       ? "row-signature" : "";
                                <tr class="@rowClass">
                                    <td class="col-sr">@(i + 1)</td>
                                    <td class="col-heading">@row.Label</td>
                                    @foreach (var subject in subjects)
                                    {
                                        <td>@row.Value(subject)</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
    }

</div>
<script src="~/js/fitPage.js" asp-append-version="true"></script>
</body>
</html>
