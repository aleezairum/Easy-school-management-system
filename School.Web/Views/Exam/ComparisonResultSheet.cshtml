@model School.Web.Controllers.ExamController.ComparisonSheetViewModel
@{
    Layout = null;
    ViewBag.Title = "Comparison Result Sheet";
    var m = Model ?? new School.Web.Controllers.ExamController.ComparisonSheetViewModel();
    string P(decimal? v) => v.HasValue ? Math.Round(v.Value, 2, MidpointRounding.AwayFromZero).ToString("0.00") : "Nill";
    var today = DateTime.Today.ToString("dd-MM-yyyy");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=820" />
    <title>Comparison Result Sheet - Sir Syed Model High School</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: Calibri, Arial, sans-serif; font-size: 14px; background: #fff; color: #000; padding: 0 10px 10px; }
        .page-wrapper { padding: 0 6px 6px; max-width: 820px; margin: 0 auto; }
        .page { break-after: page; page-break-after: always; }
        .page:last-child { break-after: auto; page-break-after: auto; }

        .sheet { border: 1.5px solid #333; margin-bottom: 10px; }
        .sheet-head { text-align: center; border-bottom: 1.5px solid #333; padding: 4px 6px; }
        .school-name { font-size: 21px; font-weight: bold; }
        .sheet-title { font-size: 19px; font-weight: bold; margin-top: 2px; }
        table { width: 100%; border-collapse: collapse; font-size: 14px; }
        th, td { border: 1px solid #333; padding: 5px 6px; text-align: center; }
        thead th { background: #f1f1f1; font-weight: bold; }
        td.class { text-align: center; }
        tr.avg td { font-weight: bold; }
        .nill { color: #555; }
        .empty { text-align: center; padding: 24px; color: #777; font-style: italic; }

        .sign { display: flex; justify-content: space-between; gap: 10px; margin: 26px 2px 6px; font-size: 14px; }
        .sign span { white-space: nowrap; }

        .print-toolbar { max-width: 820px; margin: 0 auto 8px; text-align: right; }
        .print-toolbar button { border: none; padding: 8px 20px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; color: #fff; }
        .btn-print { background: #1a7a3e; } .btn-close-win { background: #555; margin-left: 8px; }

        @@page { size: A4 portrait; margin: 0; }
        @@media print { .no-print { display: none !important; } }
    </style>
</head>
<body>
<div class="print-toolbar no-print">
    <button type="button" class="btn-print" onclick="window.print()">Print</button>
    <button type="button" class="btn-close-win" onclick="window.close()">Close</button>
</div>

<div class="page-wrapper" data-fit="portrait">
@if (m.ExamNames.Count == 0)
{
    <div class="empty">Choose at least one exam of the session.</div>
}
else
{
    var pages = new[] { new[] { m.Girls, m.Boys }, new[] { m.Both } };
    foreach (var page in pages)
    {
        <div class="page">
            @foreach (var t in page)
            {
                <div class="sheet">
                    <div class="sheet-head">
                        @if (t == page[0])
                        {
                            <div class="school-name">Sir Syed Model High School (Boys&amp;Girls) Hasilpur</div>
                        }
                        <div class="sheet-title">@t.Title @m.SessionLabel</div>
                    </div>
                    @if (t.Lines.Count == 0)
                    {
                        <div class="empty">No results for the @(t.Section == "G" ? "girls'" : t.Section == "B" ? "boys'" : "") sections in these exams.</div>
                    }
                    else
                    {
                        <table>
                            <thead>
                                <tr>
                                    <th style="width:52px">Sr.No.</th>
                                    <th>Class</th>
                                    <th style="width:70px">Section</th>
                                    @foreach (var e in m.ExamNames) { <th>@e</th> }
                                    <th>Overall</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < t.Lines.Count; i++)
                                {
                                    var l = t.Lines[i];
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td class="class">@l.ClassName</td>
                                        <td>@t.Section</td>
                                        @foreach (var v in l.Values) { <td class="@(v.HasValue ? "" : "nill")">@P(v)</td> }
                                        <td>@P(l.Overall)</td>
                                    </tr>
                                }
                                <tr class="avg">
                                    <td colspan="3">Average Result</td>
                                    @foreach (var v in t.Average) { <td>@P(v)</td> }
                                    <td>@P(t.OverallAverage)</td>
                                </tr>
                            </tbody>
                        </table>
                    }
                </div>
            }
            <div class="sign">
                <span>Date: @today</span>
                <span>Prepared by: ____________</span>
                <span>Checked by: ____________</span>
                <span>Head of Institution: ____________</span>
            </div>
        </div>
    }
}
</div>
<script src="~/js/fitPage.js" asp-append-version="true"></script>
</body>
</html>
