@model School.Web.Controllers.ExamController.TeacherComparisonViewModel
@{
    Layout = null;
    ViewBag.Title = "Teacher Result Comparison";

    var left  = Model?.Left  ?? new List<School.Web.Controllers.ExamController.TeacherComparisonRowVm>();
    var right = Model?.Right ?? new List<School.Web.Controllers.ExamController.TeacherComparisonRowVm>();
    // Both tables share the same row count so the two grids line up.
    var rowCount = Math.Max(left.Count, right.Count);
    if (rowCount < 13) rowCount = 13;   // match the printed template (≈13 rows)
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Teacher Result Comparison - Sir Syed Model High School</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
            background: #fff;
            color: #000;
            padding: 0 10px 10px;
        }

        .page-wrapper {
            padding: 0 10px 10px;
            max-width: 1100px;
            margin: 0 auto;
        }

        /* ── Header ── */
        .school-header {
            text-align: center;
            border: 1.5px solid #aaa;
            padding: 4px;
            margin-bottom: 4px;
        }

        .school-name { font-size: 18px; font-weight: bold; letter-spacing: 0.5px; }
        .report-sub  { font-size: 13px; font-weight: 600; margin-top: 2px; }

        /* ── Two side-by-side grids ── */
        .grids {
            display: flex;
            gap: 14px;
            align-items: flex-start;
        }
        .grid-col { flex: 1; min-width: 0; }

        .grid-title {
            text-align: center;
            font-size: 13px;
            font-weight: bold;
            background-color: #000;
            color: #fff;
            padding: 4px 6px;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            font-size: 11.5px;
        }

        thead tr th,
        tbody tr td {
            border: 1px solid #555;
            text-align: center;
            padding: 4px 5px;
            vertical-align: middle;
            word-wrap: break-word;
            overflow-wrap: break-word;
            height: 24px;
        }

        thead tr th { background-color: #f0f0f0; font-weight: bold; }

        th.col-sr,  td.col-sr  { width: 34px; }
        th.col-name, td.col-name { text-align: left; padding-left: 8px; }
        th.col-pct, td.col-pct { width: 64px; }
        th.col-pos, td.col-pos {
            width: 64px;
            font-weight: bold;
            background-color: #eef4ff;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
        th.col-sign, td.col-sign { width: 60px; }
        td.col-pct { font-weight: 600; }

        tbody tr:nth-child(even) td:not(.col-pos) { background-color: #fafafa; }

        tfoot .avg-row td {
            font-weight: bold;
            background-color: #eef4ff;
            border-top: 2px solid #333;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
        tfoot .avg-row td.avg-label { text-align: center; }

        /* Print toolbar (hidden when printing) */
        .print-toolbar {
            max-width: 1100px;
            margin: 0 auto 8px;
            text-align: right;
        }
        .print-toolbar .btn-print {
            background: #1a7a3e; color: #fff; border: none;
            padding: 8px 22px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;
        }
        .print-toolbar .btn-close-win {
            background: #555; color: #fff; border: none;
            padding: 8px 16px; border-radius: 6px; font-size: 13px; cursor: pointer; margin-left: 8px;
        }

        @@page { size: A4 portrait; margin: 0; }

        @@media print {
            body { padding: 4mm 8mm 6mm; }
            .page-wrapper { border: none; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body>
<div class="print-toolbar no-print">
    <button type="button" class="btn-print" onclick="window.print()">Print</button>
    <button type="button" class="btn-close-win" onclick="window.close()">Close</button>
</div>

<div class="page-wrapper" data-fit="portrait">

    <!-- School Header -->
    <div class="school-header">
        <div class="school-name">SIR SYED MODEL HIGH SCHOOL (Boys&amp;Girls), Hasilpur</div>
        <div class="report-sub">Teacher's Result @(string.IsNullOrWhiteSpace(Model?.Examination) ? "" : Model.Examination)</div>
    </div>

    <div class="grids">
        @{
            void RenderGrid(string title, List<School.Web.Controllers.ExamController.TeacherComparisonRowVm> rows)
            {
                var avgResult = rows.Count > 0 ? rows.Average(r => r.ResultPercent) : 0;
                <div class="grid-col">
                    <div class="grid-title">@title</div>
                    <table>
                        <thead>
                            <tr>
                                <th class="col-sr">Sr.<br />No.</th>
                                <th class="col-name">Name of Teacher</th>
                                <th class="col-pct">Result %</th>
                                <th class="col-pos">Position</th>
                                <th class="col-sign">Sign.</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < rowCount; i++)
                            {
                                var r = i < rows.Count ? rows[i] : null;
                                <tr>
                                    <td class="col-sr">@(i + 1)</td>
                                    <td class="col-name">@(r?.TeacherName)</td>
                                    <td class="col-pct">@(r != null ? r.ResultPercent.ToString("0.##") : "")</td>
                                    <td class="col-pos">@(r?.Position)</td>
                                    <td class="col-sign">&nbsp;</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="avg-row">
                                <td class="col-name avg-label" colspan="2"><strong>Average Result</strong></td>
                                <td class="col-pct"><strong>@avgResult.ToString("0.##")</strong></td>
                                <td class="col-pos"></td>
                                <td class="col-sign"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        }
        @{ RenderGrid(Model?.LeftTitle  ?? "Left",  left); }
        @{ RenderGrid(Model?.RightTitle ?? "Right", right); }
    </div>

</div>
<script src="~/js/fitPage.js" asp-append-version="true"></script>
</body>
</html>
