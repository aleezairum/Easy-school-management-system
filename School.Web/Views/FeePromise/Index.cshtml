@{
    ViewData["Title"] = "Promise to Pay";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@*
    A parent comes in and says "I will clear the dues by the 20th, please stop
    asking the child." That promise is recorded here.

    While it is in force the student drops off the Unpaid Fee report and gets no
    fee reminders. The day after the promise date, if the dues are still there,
    they are back on the list on their own — nothing runs and nobody has to
    remember to put them back.
*@

<style>
    .form-section { background: #f8fafc; border-radius: 12px; padding: 20px; margin-bottom: 20px; }
    .section-title { font-size: 12px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 16px; padding-bottom: 8px; border-bottom: 2px solid #e2e8f0; }
    .loading-overlay { position: absolute; inset: 0; background: rgba(255,255,255,.8); display: flex; align-items: center; justify-content: center; z-index: 100; border-radius: 16px; }
    .spinner-border { width: 3rem; height: 3rem; border-width: .3rem; }
    #promiseTable td, #promiseTable th { font-size: 13px; vertical-align: middle; }
    .st-chip { border-radius: 999px; padding: 2px 10px; font-size: 12px; font-weight: 600; white-space: nowrap; }
    .st-1 { background: #dcfce7; color: #166534; }   /* in force */
    .st-2 { background: #fee2e2; color: #991b1b; }   /* lapsed, still owing */
    .st-3 { background: #e0f2fe; color: #075985; }   /* settled */
    .due { font-weight: 700; }
    .hint { font-size: 12px; color: #64748b; }
    .find-student-section { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 14px; margin-left: 0; margin-right: 0; }
</style>

<div class="container-fluid">
    <div class="card">
        <div class="card-body position-relative">

            <div id="loadingOverlay" class="loading-overlay" style="display:none;">
                <div class="spinner-border text-success" role="status"><span class="visually-hidden">Loading...</span></div>
            </div>

            <div class="form-section">
                <div class="section-title">
                    <i class="bi bi-hand-thumbs-up me-2"></i><span id="formTitle">Record a Promise</span>
                </div>

                <input type="hidden" id="promiseId" value="0" />

                @* The same finder as the Receive Payment screen, and for the same
                   reason: the office knows the class and the child's name, not a
                   student id, and a promise is only ever taken from somebody who
                   owes. *@
                <div class="find-student-section row g-3 align-items-end mb-3">
                    <div class="col-lg-4 col-md-6 col-12">
                        <label for="classId" class="form-label">Class</label>
                        <select class="form-select" id="classId">
                            <option value="">-- All Classes --</option>
                        </select>
                    </div>
                    <div class="col-lg-4 col-md-6 col-12">
                        <label for="sectionId" class="form-label">Section</label>
                        <select class="form-select" id="sectionId" disabled>
                            <option value="">-- All Sections --</option>
                        </select>
                    </div>
                    <div class="col-lg-4 col-md-6 col-12">
                        <label for="rollNo" class="form-label">Roll No</label>
                        <select class="form-select" id="rollNo">
                            <option value="">All</option>
                        </select>
                    </div>
                    <div class="col-lg-4 col-md-6 col-12">
                        <label for="studentId" class="form-label">Student Name <span class="text-danger">*</span></label>
                        <select class="form-select" id="studentId">
                            <option value="">-- All Students --</option>
                        </select>
                    </div>
                    <div class="col-lg-4 col-md-6 col-12">
                        <label for="filterFatherName" class="form-label">Father Name</label>
                        <select class="form-select" id="filterFatherName">
                            <option value="">-- All --</option>
                        </select>
                    </div>
                    <div class="col-lg-4 col-md-6 col-12">
                        <label for="filterFatherCNIC" class="form-label">Father CNIC</label>
                        <select class="form-select" id="filterFatherCNIC">
                            <option value="">-- All --</option>
                        </select>
                    </div>
                    <div class="col-12 d-flex flex-wrap align-items-center gap-3">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="onlyPending" checked />
                            <label class="form-check-label" for="onlyPending">Only students with dues</label>
                        </div>
                        <span id="studentsHint" class="hint"></span>
                    </div>
                    <div class="col-12">
                        <div class="hint" id="duesHint"></div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-lg-2 col-md-6 col-12">
                        <label for="promiseDate" class="form-label">Promised by <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="promiseDate" />
                        <div class="hint">Dues are chased again the day after.</div>
                    </div>
                    <div class="col-lg-2 col-md-6 col-12">
                        <label for="promisedAmount" class="form-label">Amount</label>
                        <input type="number" step="0.01" min="0" class="form-control" id="promisedAmount" placeholder="All of it" />
                    </div>
                    <div class="col-lg-2 col-md-6 col-12">
                        <label for="promisedBy" class="form-label">Who promised</label>
                        <input type="text" class="form-control" id="promisedBy" placeholder="Father / Mother / Guardian" />
                    </div>
                    <div class="col-lg-2 col-md-6 col-12 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="isActive" checked />
                            <label class="form-check-label" for="isActive">Active</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label for="remarks" class="form-label">Remarks</label>
                        <input type="text" class="form-control" id="remarks" maxlength="500" placeholder="What the parent said" />
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-primary" onclick="savePromise()"><i class="bi bi-check-lg me-1"></i> Save</button>
                    <button class="btn btn-secondary" onclick="clearForm()"><i class="bi bi-x-lg me-1"></i> Clear</button>
                </div>
            </div>

            <div class="row g-2 align-items-end mb-3">
                <div class="col-md-3">
                    <label class="form-label">Show</label>
                    <select class="form-select" id="filterStatus" onchange="loadPromises()">
                        <option value="1" selected>In force</option>
                        <option value="2">Lapsed &mdash; still owing</option>
                        <option value="3">Settled</option>
                        <option value="0">All</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Campus</label>
                    <select class="form-select" id="filterCampus" onchange="loadPromises()">
                        <option value="">All campuses</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Class</label>
                    <select class="form-select" id="filterClass" onchange="loadPromises()">
                        <option value="">All classes</option>
                    </select>
                </div>
                @* Prints what the three filters above are showing, but a row per
                   CHILD rather than per promise - see wwwroot/js/feePromisePrint.js. *@
                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-outline-dark" id="btnPrint" onclick="printPromises()">
                        <i class="bi bi-printer me-1"></i> Print
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover" id="promiseTable">
                    <thead>
                        <tr>
                            <th style="width:50px;">Sr#</th>
                            <th>Student</th>
                            <th>Father</th>
                            <th>Class</th>
                            <th>Contact</th>
                            <th class="text-end">Family Dues</th>
                            <th>Promised by</th>
                            <th class="text-end">Amount</th>
                            <th>Status</th>
                            <th>Remarks</th>
                            <th class="text-center" style="width:120px;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="promiseBody">
                        <tr><td colspan="11" class="text-center text-muted py-4">Loading…</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/feePromisePrint.js" asp-append-version="true"></script>
<script>
    const STATUS = {
        1: { label: 'In force', cls: 'st-1' },
        2: { label: 'Lapsed', cls: 'st-2' },
        3: { label: 'Settled', cls: 'st-3' }
    };

    let allStudents = [];
    let isSyncing = false;
    let isLoadingStudents = false;

    $(document).ready(function () {
        $('#promiseDate').val(toInputDate(new Date()));
        loadDropdowns();
        loadPromises();
        loadStudents();

        $('#classId').on('change', loadSections);
        $('#sectionId').on('change', loadStudents);
        $('#onlyPending').on('change', loadStudents);

        // Any of the four picks the same child; they are four ways into one
        // list, exactly as on the Receive Payment screen.
        $('#rollNo').on('change', function () { pickStudent($(this).val()); });
        $('#studentId').on('change', function () { pickStudent($(this).val()); });
        $('#filterFatherName').on('change', function () { pickStudent($(this).val()); });
        $('#filterFatherCNIC').on('change', function () { pickStudent($(this).val()); });
    });

    async function loadDropdowns() {
        try {
            const [campuses, classes] = await Promise.all([
                fetch(`${API_BASE}/campus`).then(r => r.ok ? r.json() : []),
                fetch(`${API_BASE}/class`).then(r => r.ok ? r.json() : [])
            ]);
            campuses.forEach(c => $('#filterCampus').append(`<option value="${c.vid}">${esc(c.vName)}</option>`));
            classes.forEach(c => {
                $('#filterClass').append(`<option value="${c.vid}">${esc(c.vName)}</option>`);
                $('#classId').append(`<option value="${c.vid}">${esc(c.vName)}</option>`);
            });
        } catch (e) { console.error(e); }
    }

    async function loadSections() {
        const classId = $('#classId').val();
        const sectionSelect = $('#sectionId');
        sectionSelect.find('option:not(:first)').remove();
        sectionSelect.prop('disabled', true).val('');
        await loadStudents();

        if (!classId) return;

        try {
            const res = await fetch(`${API_BASE}/section/byClass/${classId}`);
            if (!res.ok) return;
            (await res.json()).forEach(s =>
                sectionSelect.append(`<option value="${s.vid}">${esc(s.vName)}</option>`));
            sectionSelect.prop('disabled', false);
        } catch (e) { console.error(e); }
    }

    // The same list the Receive Payment screen offers: children who owe
    // something as at today, class and section wise. A promise is only ever
    // taken from somebody who owes, so that is what shows by default.
    async function loadStudents() {
        if (isLoadingStudents) return;
        isLoadingStudents = true;

        const classId = $('#classId').val() || 0;
        const sectionId = $('#sectionId').val() || 0;
        const onlyPending = $('#onlyPending').is(':checked');

        $('#rollNo, #studentId, #filterFatherName, #filterFatherCNIC')
            .find('option:not(:first)').remove();
        $('#studentsHint').text('');
        $('#duesHint').text('');

        try {
            const url = onlyPending
                ? `${API_BASE}/ApplyFee/PendingStudents?classId=${classId}&sectionId=${sectionId}`
                : `${API_BASE}/Student/students?classId=${classId}&sectionId=${sectionId}`;

            const res = await fetch(url);
            if (!res.ok) return;

            allStudents = await res.json();

            if (!allStudents.length) {
                $('#studentsHint').text(onlyPending
                    ? 'Nobody here owes anything today. Untick to list every student.'
                    : 'No students found.');
                return;
            }

            // Say WHOSE money this is. It is the children in this list added
            // up — a class or a section — and not the family of whoever is
            // picked below, which is a different figure and was being read as
            // the same one.
            const owed = allStudents.reduce((t, s) => t + (s.pendingAmount || 0), 0);
            $('#studentsHint').text(onlyPending
                ? `These ${allStudents.length} students owe ${owed.toLocaleString('en-PK')} between them`
                : `${allStudents.length} students in this list`);

            allStudents.forEach(s => {
                const dues = s.pendingAmount ? `  —  ${s.pendingAmount.toLocaleString('en-PK')}` : '';
                $('#rollNo').append(`<option value="${s.vid}">${esc(s.classRollNo || s.rollNo || '-')}</option>`);
                $('#studentId').append(`<option value="${s.vid}">${esc(s.name || '-')}${dues}</option>`);
                $('#filterFatherName').append(`<option value="${s.vid}">${esc(s.fatherName || '-')}</option>`);
                $('#filterFatherCNIC').append(`<option value="${s.vid}">${esc(s.fatherCNIC || '-')}</option>`);
            });
        } catch (e) {
            console.error(e);
        } finally {
            isLoadingStudents = false;
        }
    }

    // Keep the four dropdowns on the same child, then say what the family owes.
    function pickStudent(vid) {
        if (isSyncing) return;
        isSyncing = true;
        $('#rollNo, #studentId, #filterFatherName, #filterFatherCNIC').val(vid).trigger('change');
        isSyncing = false;

        if (vid) showDues(vid); else $('#duesHint').text('');
    }

    // What the FAMILY owes right now, so the promise is taken against a figure
    // rather than a guess — and so the office can see it covers the siblings
    // too. /ApplyFee/Pendings already answers for the whole family: it keys on
    // the parent, which is why one voucher settles every child.
    async function showDues(studentId) {
        $('#duesHint').text('Checking dues…');
        try {
            const res = await fetch(`${API_BASE}/ApplyFee/Pendings?studentId=${studentId}`);
            if (!res.ok) { $('#duesHint').text(''); return; }

            const rows = await res.json();
            const due = rows.filter(r => r.isDue !== false);
            const total = due.reduce((s, r) => s + (r.pendingAmount || 0), 0);
            const children = [...new Set(rows.map(r => (r.studentName || '').trim()).filter(Boolean))];

            if (total <= 0) {
                $('#duesHint').text('Nothing outstanding for this family today.');
                return;
            }

            const covers = children.length > 1
                ? ` The promise covers all ${children.length}: ${children.join(', ')}.`
                : '';

            // "This student's family", so nobody reads it as the total of the
            // list above — that one is a class or section, this one a family,
            // and the two were being taken for the same figure.
            $('#duesHint').text(
                `This student's family owes ${total.toLocaleString('en-PK')} as at today, `
                + `across ${due.length} unpaid item(s)`
                + (children.length > 1 ? ` for ${children.length} children.` : '.')
                + covers);
        } catch { $('#duesHint').text(''); }
    }

    async function loadPromises() {
        showLoading();
        try {
            let url = `${API_BASE}/fee/promise?status=${$('#filterStatus').val() || 0}`;
            const campus = $('#filterCampus').val();
            const cls = $('#filterClass').val();
            if (campus) url += `&campusIds=${campus}`;
            if (cls) url += `&classIds=${cls}`;

            const res = await fetch(url);
            if (!res.ok) { toastError('Failed to load promises'); return; }
            render(await res.json());
        } catch (e) {
            toastError('Error loading promises: ' + e.message);
        } finally { hideLoading(); }
    }

    function render(rows) {
        const body = $('#promiseBody').empty();
        if (!rows.length) {
            body.html('<tr><td colspan="11" class="text-center text-muted py-4">No promises to show.</td></tr>');
            return;
        }

        rows.forEach((p, i) => {
            const st = STATUS[p.promiseStatus] || { label: '-', cls: '' };
            const when = fmtDate(p.promiseDate);
            const days = p.promiseStatus === 1
                ? `<div class="hint">${p.daysLeft === 0 ? 'today' : p.daysLeft + ' day(s) left'}</div>`
                : (p.promiseStatus === 2 ? `<div class="hint text-danger">${Math.abs(p.daysLeft)} day(s) overdue</div>` : '');

            body.append(`
                <tr>
                    <td>${i + 1}</td>
                    <td><strong>${esc(p.studentName)}</strong><div class="hint">${esc(p.rollNo || '')}</div>${
                        p.siblingCount > 1
                            ? `<div class="hint text-success">covers all ${p.siblingCount} children</div>`
                            : ''}</td>
                    <td>${esc(p.fatherName || '-')}</td>
                    <td>${esc(p.className || '-')} ${esc(p.sectionName || '')}<div class="hint">${esc(p.campusName || '')}</div></td>
                    <td>${esc(p.contactNo || '-')}</td>
                    <td class="text-end due">${(p.pendingAmount || 0).toLocaleString('en-PK')}</td>
                    <td>${when}${days}<div class="hint">${esc(p.promisedBy || '')}</div></td>
                    <td class="text-end">${p.promisedAmount ? p.promisedAmount.toLocaleString('en-PK') : '<span class="text-muted">all</span>'}</td>
                    <td><span class="st-chip ${st.cls}">${st.label}</span>${p.isActive ? '' : '<div class="hint">cancelled</div>'}</td>
                    <td>${esc(p.remarks || '')}</td>
                    <td class="text-center">
                        <button class="btn btn-warning btn-sm" onclick="editPromise(${p.vid})" title="Edit"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-danger btn-sm" onclick="deletePromise(${p.vid})" title="Delete"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>`);
        });
    }

    async function savePromise() {
        const studentId = parseInt($('#studentId').val()) || 0;
        if (!studentId) { toastWarning('Pick a student from the list'); $('#studentId').focus(); return; }

        const date = $('#promiseDate').val();
        if (!date) { toastWarning('Enter the date the parent promised to pay by'); return; }

        const body = {
            VID: parseInt($('#promiseId').val()) || 0,
            StudentID: studentId,
            PromiseDate: date,
            PromisedAmount: parseFloat($('#promisedAmount').val()) || null,
            PromisedBy: $('#promisedBy').val().trim() || null,
            Remarks: $('#remarks').val().trim() || null,
            IsActive: $('#isActive').is(':checked')
        };

        showLoading();
        try {
            const res = await fetch(`${API_BASE}/fee/promise`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });

            const result = await res.json().catch(() => ({}));
            if (!res.ok) { toastError(result.message || 'Failed to save'); return; }

            toastSuccess(result.returnMessage || 'Saved');
            clearForm();
            loadPromises();
        } catch (e) {
            toastError('Error saving: ' + e.message);
        } finally { hideLoading(); }
    }

    async function editPromise(id) {
        showLoading();
        try {
            const res = await fetch(`${API_BASE}/fee/promise/${id}`);
            if (!res.ok) { toastError('Could not load that promise'); return; }

            const p = await res.json();
            $('#promiseId').val(p.vid);
            // The child may sit in a class the finder is not showing, or may
            // have paid since and dropped off the list, so the option is put
            // there rather than looked for.
            showStudentInPickers(p);
            $('#promiseDate').val(toInputDate(p.promiseDate));
            $('#promisedAmount').val(p.promisedAmount ?? '');
            $('#promisedBy').val(p.promisedBy ?? '');
            $('#remarks').val(p.remarks ?? '');
            $('#isActive').prop('checked', p.isActive);
            $('#formTitle').text('Edit Promise');
            $('#duesHint').text(
                `Family owes ${(p.pendingAmount || 0).toLocaleString('en-PK')} as at today`
                + (p.siblingCount > 1 ? `, across ${p.siblingCount} children.` : '.'));
            $('html, body').animate({ scrollTop: 0 }, 'slow');
        } finally { hideLoading(); }
    }

    async function deletePromise(id) {
        if (!await confirmDelete('Remove this promise? The student goes back on the pending-fee list straight away.')) return;

        showLoading();
        try {
            const res = await fetch(`${API_BASE}/fee/promise/${id}`, { method: 'DELETE' });
            if (!res.ok) { toastError('Failed to remove'); return; }
            toastSuccess('Promise removed');
            loadPromises();
        } finally { hideLoading(); }
    }

    // Put a student into the four pickers even when the current filter would
    // not have listed them — used when an existing promise is opened.
    function showStudentInPickers(p) {
        isSyncing = true;
        const add = (sel, text) => {
            const $s = $(sel);
            if (!$s.find(`option[value="${p.studentID}"]`).length)
                $s.append(`<option value="${p.studentID}">${esc(text || '-')}</option>`);
            $s.val(String(p.studentID));
        };
        add('#studentId', p.studentName);
        add('#rollNo', p.rollNo);
        add('#filterFatherName', p.fatherName);
        add('#filterFatherCNIC', p.fatherCNIC);
        isSyncing = false;
    }

    function clearForm() {
        $('#promiseId').val('0');
        $('#rollNo, #studentId, #filterFatherName, #filterFatherCNIC').val('');
        $('#promisedAmount').val('');
        $('#promisedBy').val('');
        $('#remarks').val('');
        $('#isActive').prop('checked', true);
        $('#promiseDate').val(toInputDate(new Date()));
        $('#duesHint').text('');
        $('#formTitle').text('Record a Promise');
    }

    function showLoading() { $('#loadingOverlay').css('display', 'flex'); }
    function hideLoading() { $('#loadingOverlay').hide(); }

    // Names and remarks are typed by hand and carry apostrophes and ampersands.
    function esc(v) {
        return (v ?? '').toString()
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
</script>
}
