@{
    ViewData["Title"] = "Certificates";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid">
    <div id="alertContainer"></div>

    <div class="card" style="border-radius: 10px; border: none; box-shadow: 0 2px 12px rgba(0,0,0,0.08);">
        <div class="card-body p-3">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 style="font-weight: 600; color: #475569; margin: 0; font-size: 14px;">
                    <i class="bi bi-award-fill me-1"></i> Print Certificate
                </h6>
            </div>

            <!-- Certificate Type -->
            <div class="filter-section" style="background: #f8fafc; border-radius: 8px; padding: 12px 14px; margin-bottom: 10px;">
                <div class="row g-2 align-items-end">
                    <div class="col-12">
                        <label class="form-label form-label-sm mb-1">Certificate Type</label>
                        <div class="d-flex gap-3">
                            <div class="form-check form-check-sm">
                                <input class="form-check-input" type="radio" name="certType" id="certLeaving" value="leaving" checked onchange="toggleCertFields()">
                                <label class="form-check-label" for="certLeaving">School Leaving Certificate</label>
                            </div>
                            <div class="form-check form-check-sm">
                                <input class="form-check-input" type="radio" name="certType" id="certCharacter" value="character" onchange="toggleCertFields()">
                                <label class="form-check-label" for="certCharacter">Provisional &amp; Character Certificate</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Student Filters: Class / Section / Roll No / Student -->
            <div class="filter-section" style="background: #f8fafc; border-radius: 8px; padding: 12px 14px; margin-bottom: 10px;">
                <div class="row g-2 align-items-end">
                    <div class="col-lg-3 col-md-6 col-sm-6 col-12">
                        <label for="filterClass" class="form-label form-label-sm mb-1">Class</label>
                        <select class="form-select form-select-sm" id="filterClass" onchange="loadFilterSections()">
                            <option value="">-- Select Class --</option>
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-6 col-sm-6 col-12">
                        <label for="filterSection" class="form-label form-label-sm mb-1">Section</label>
                        <select class="form-select form-select-sm" id="filterSection" disabled onchange="loadStudents()">
                            <option value="">-- Select Section --</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                        <label for="filterRollNo" class="form-label form-label-sm mb-1">Roll No</label>
                        <select class="form-select form-select-sm" id="filterRollNo" onchange="selectStudentByRoll()">
                            <option value="">-- Select Roll --</option>
                        </select>
                    </div>
                    <div class="col-lg-4 col-md-8 col-sm-12 col-12">
                        <label for="filterStudent" class="form-label form-label-sm mb-1">Student</label>
                        <select class="form-select form-select-sm" id="filterStudent" onchange="selectRollByStudent()">
                            <option value="">-- Select Student --</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Optional Override Fields: Leaving Certificate -->
            <div class="filter-section optional-section" id="leavingFields"
                 style="background: #f8fafc; border-radius: 8px; padding: 12px 14px; margin-bottom: 10px;">
                <div class="row g-2 align-items-end">
                    <div class="col-12 mb-1">
                        <small class="text-muted">Optional fields (leave blank to use defaults from school record)</small>
                    </div>
                    <div class="col-lg-3 col-md-6 col-12">
                        <label for="leavingDate" class="form-label form-label-sm mb-1">Leaving Date</label>
                        <input type="date" class="form-control form-control-sm" id="leavingDate" />
                    </div>
                    <div class="col-lg-3 col-md-6 col-12">
                        <label for="leavingExamination" class="form-label form-label-sm mb-1">Examination</label>
                        <input type="text" class="form-control form-control-sm" id="leavingExamination" placeholder="e.g. Annual 2025" />
                    </div>
                    <div class="col-lg-3 col-md-6 col-12">
                        <label for="leavingMarks" class="form-label form-label-sm mb-1">Marks Obtained</label>
                        <input type="text" class="form-control form-control-sm" id="leavingMarks" />
                    </div>
                    <div class="col-lg-3 col-md-6 col-12">
                        <label for="leavingTotal" class="form-label form-label-sm mb-1">Total Marks</label>
                        <input type="text" class="form-control form-control-sm" id="leavingTotal" />
                    </div>
                    <div class="col-lg-3 col-md-6 col-12">
                        <label for="leavingClassAdmitted" class="form-label form-label-sm mb-1">Class in which admitted</label>
                        <select class="form-select form-select-sm" id="leavingClassAdmitted">
                            <option value="">-- Select Class --</option>
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-6 col-12">
                        <label for="leavingClassStudying" class="form-label form-label-sm mb-1">Class in which studying / Passed / Failed</label>
                        <select class="form-select form-select-sm" id="leavingClassStudying">
                            <option value="">-- Select Class --</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Optional Override Fields: Character Certificate -->
            <div class="filter-section optional-section" id="characterFields"
                 style="background: #f8fafc; border-radius: 8px; padding: 12px 14px; margin-bottom: 10px; display:none;">
                <div class="row g-2 align-items-end">
                    <div class="col-12 mb-1">
                        <small class="text-muted">Optional fields (leave blank to use defaults from school record)</small>
                    </div>
                    <div class="col-lg-3 col-md-6 col-12">
                        <label for="boardRollNo" class="form-label form-label-sm mb-1">Board Roll No</label>
                        <input type="text" class="form-control form-control-sm" id="boardRollNo" />
                    </div>
                    <div class="col-lg-3 col-md-6 col-12">
                        <label for="examRollNo" class="form-label form-label-sm mb-1">Exam Roll No</label>
                        <input type="text" class="form-control form-control-sm" id="examRollNo" />
                    </div>
                    <div class="col-lg-3 col-md-6 col-12">
                        <label for="charExamination" class="form-label form-label-sm mb-1">Examination</label>
                        <input type="text" class="form-control form-control-sm" id="charExamination" />
                    </div>
                    <div class="col-lg-3 col-md-6 col-12">
                        <label for="charSession" class="form-label form-label-sm mb-1">Session</label>
                        <select class="form-select form-select-sm" id="charSession">
                            <option value="">-- Latest Session --</option>
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-6 col-12">
                        <label for="charMarks" class="form-label form-label-sm mb-1">Marks Obtained</label>
                        <input type="text" class="form-control form-control-sm" id="charMarks" />
                    </div>
                    <div class="col-lg-3 col-md-6 col-12">
                        <label for="charTotal" class="form-label form-label-sm mb-1">Total Marks</label>
                        <input type="text" class="form-control form-control-sm" id="charTotal" />
                    </div>
                    <div class="col-lg-3 col-md-6 col-12">
                        <label for="conduct" class="form-label form-label-sm mb-1">Conduct</label>
                        <input type="text" class="form-control form-control-sm" id="conduct"
                               placeholder="e.g. regular, punctual, obedient" />
                    </div>
                    <div class="col-lg-3 col-md-6 col-12">
                        <label for="moralCharacter" class="form-label form-label-sm mb-1">Moral Character</label>
                        <input type="text" class="form-control form-control-sm" id="moralCharacter" placeholder="e.g. Excellent" />
                    </div>
                    <div class="col-lg-3 col-md-6 col-12">
                        <label for="issueDate" class="form-label form-label-sm mb-1">Issue Date</label>
                        <input type="date" class="form-control form-control-sm" id="issueDate" />
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="filter-section" style="background: #f8fafc; border-radius: 8px; padding: 12px 14px;">
                <div class="row g-2 align-items-end">
                    <div class="col-12 d-flex gap-2 align-items-end justify-content-end">
                        <button type="button" class="btn btn-success btn-sm" onclick="printCertificate()" id="btnPrint">
                            <i class="bi bi-printer me-1"></i> Print Certificate
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="clearFilters()" title="Clear">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Styles {
    <style>
        .form-label-sm { font-size: 12px; }
        .form-check-sm .form-check-label { font-size: 12px; }
    </style>
}

@section Scripts {
    <script>
        let isSyncing = false;

        $(document).ready(function () {
            loadDropdowns();
            toggleCertFields();

            // Leaving Date / Issue Date default to today; still plain date
            // inputs the user can change before printing.
            $('#leavingDate').val(todayIso());
            $('#issueDate').val(todayIso());

            $('#filterStudent').on('change', function () {
                const studentId = parseInt($(this).val()) || 0;
                if (studentId) {
                    fillLeavingClassDefaults(studentId);
                    fillCharacterDefaults(studentId);
                }
            });

            // Re-fetch character defaults when the session changes, since the
            // session scopes which exam's marks are picked up.
            $('#charSession').on('change', function () {
                const studentId = parseInt($('#filterStudent').val()) || 0;
                if (studentId) fillCharacterDefaults(studentId);
            });
        });

        // ── Toggle optional override panels ───────────────────────────────
        function toggleCertFields() {
            const type = $('input[name="certType"]:checked').val();
            $('#leavingFields').toggle(type === 'leaving');
            $('#characterFields').toggle(type === 'character');
        }

        // ── Load Class + Sessions dropdowns ───────────────────────────────
        async function loadDropdowns() {
            try {
                const [classes, sessions] = await Promise.all([
                    fetch(`${API_BASE}/class`).then(r => r.ok ? r.json() : []),
                    fetch(`${API_BASE}/AcademicSessionYear`).then(r => r.ok ? r.json() : [])
                ]);
                classes.forEach(c => {
                    $('#filterClass').append(`<option value="${c.vid}">${c.vName}</option>`);
                    $('#leavingClassAdmitted').append(`<option value="${c.vName}">${c.vName}</option>`);
                    $('#leavingClassStudying').append(`<option value="${c.vName}">${c.vName}</option>`);
                });
                sessions.forEach(s => $('#charSession').append(
                    `<option value="${s.vid}" data-current="${s.isCurrent ? '1' : '0'}">${s.vName}</option>`));
                // Default the Session picker to the current session.
                const current = sessions.find(s => s.isCurrent);
                if (current) $('#charSession').val(current.vid);
                $('#filterClass').trigger('change');
                $('#leavingClassAdmitted').trigger('change');
                $('#leavingClassStudying').trigger('change');
                $('#charSession').trigger('change');
            } catch (err) {
                console.error('Error loading dropdowns:', err);
            }
        }

        // ── Load Sections by Class ────────────────────────────────────────
        async function loadFilterSections() {
            const classId = $('#filterClass').val();
            const sectionSelect = $('#filterSection');
            sectionSelect.find('option:not(:first)').remove();
            sectionSelect.val('').prop('disabled', true);
            $('#filterRollNo').find('option:not(:first)').remove();
            $('#filterStudent').find('option:not(:first)').remove();

            if (!classId) return;

            try {
                const response = await fetch(`${API_BASE}/section/byClass/${classId}`);
                if (response.ok) {
                    const sections = await response.json();
                    sections.forEach(s => {
                        sectionSelect.append(`<option value="${s.vid}">${s.vName}</option>`);
                    });
                    sectionSelect.prop('disabled', false);
                }
            } catch (err) {
                console.error('Error loading sections:', err);
            }

            await loadStudents();
        }

        // ── Load Students ─────────────────────────────────────────────────
        async function loadStudents() {
            const classId = $('#filterClass').val() || 0;
            const sectionId = $('#filterSection').val() || 0;

            $('#filterRollNo').find('option:not(:first)').remove();
            $('#filterStudent').find('option:not(:first)').remove();

            if (!classId) return;

            try {
                const response = await fetch(`${API_BASE}/Student/students?classId=${classId}&sectionId=${sectionId}`);
                if (response.ok) {
                    const students = await response.json();
                    students.forEach(s => {
                        const roll = s.classRollNo || s.rollNo || '-';
                        $('#filterRollNo').append(`<option value="${s.vid}">${roll}</option>`);
                        $('#filterStudent').append(`<option value="${s.vid}">${s.name || '-'}</option>`);
                    });
                }
            } catch (err) {
                console.error('Error loading students:', err);
            }
        }

        // ── Auto-fill Examination / Marks / Class fields from school record ─
        // These are still plain editable inputs, so staff can change any of
        // them before printing — this just pre-fills what the certificate
        // would otherwise fall back to on the server.
        async function fillLeavingClassDefaults(studentId) {
            try {
                const response = await fetch(`${API_BASE}/Certificate/leaving/${studentId}`);
                if (!response.ok) return;
                const data = await response.json();
                setClassSelectValue('#leavingClassAdmitted', data.classAdmitted);
                setClassSelectValue('#leavingClassStudying', data.classStudying);
                $('#leavingExamination').val(data.examination === 'N.A.' ? '' : (data.examination || ''));
                $('#leavingMarks').val(data.marksObtained === 'N.A.' ? '' : (data.marksObtained || ''));
                $('#leavingTotal').val(data.totalMarks === 'N.A.' ? '' : (data.totalMarks || ''));
            } catch (err) {
                console.error('Error loading class defaults:', err);
            }
        }

        // ── Auto-fill Examination / Marks for the Provisional & Character
        // certificate from school record. Still plain editable inputs, so
        // staff can change any of them before printing.
        async function fillCharacterDefaults(studentId) {
            try {
                const sessionId = $('#charSession').val();
                const query = sessionId ? `?sessionId=${sessionId}` : '';
                const response = await fetch(`${API_BASE}/Certificate/provisional/${studentId}${query}`);
                if (!response.ok) return;
                const data = await response.json();
                $('#examRollNo').val(data.examRollNo || '');
                $('#charExamination').val(data.examination === 'N.A.' ? '' : (data.examination || ''));
                $('#charMarks').val(data.marksObtained === 'N.A.' ? '' : (data.marksObtained || ''));
                $('#charTotal').val(data.totalMarks === 'N.A.' ? '' : (data.totalMarks || ''));
            } catch (err) {
                console.error('Error loading character certificate defaults:', err);
            }
        }

        // Today's date as yyyy-MM-dd, in local time (not UTC), for <input type="date">.
        function todayIso() {
            const d = new Date();
            const pad = n => String(n).padStart(2, '0');
            return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
        }

        function setClassSelectValue(selector, className) {
            const $sel = $(selector);
            if (!className) { $sel.val('').trigger('change'); return; }
            const exists = $sel.find('option').toArray().some(o => o.value === className);
            if (!exists) {
                $sel.append(`<option value="${className}">${className}</option>`);
            }
            $sel.val(className).trigger('change');
        }

        // ── Sync Roll / Student selects ───────────────────────────────────
        function selectStudentByRoll() {
            if (isSyncing) return;
            isSyncing = true;
            const val = $('#filterRollNo').val();
            if (val) $('#filterStudent').val(val).trigger('change');
            isSyncing = false;
        }

        function selectRollByStudent() {
            if (isSyncing) return;
            isSyncing = true;
            const val = $('#filterStudent').val();
            if (val) $('#filterRollNo').val(val).trigger('change');
            isSyncing = false;
        }

        // ── Print ─────────────────────────────────────────────────────────
        function printCertificate() {
            const studentId = parseInt($('#filterStudent').val()) || 0;
            if (!studentId) {
                alert('Please select a student.');
                return;
            }

            const type = $('input[name="certType"]:checked').val();
            const params = new URLSearchParams();

            if (type === 'leaving') {
                addParam(params, 'leavingDate',    $('#leavingDate').val());
                addParam(params, 'examination',    $('#leavingExamination').val());
                addParam(params, 'marksObtained',  $('#leavingMarks').val());
                addParam(params, 'totalMarks',     $('#leavingTotal').val());
                addParam(params, 'classAdmitted',  $('#leavingClassAdmitted').val());
                addParam(params, 'classStudying',  $('#leavingClassStudying').val());
            } else {
                addParam(params, 'sessionId',      $('#charSession').val());
                addParam(params, 'boardRollNo',    $('#boardRollNo').val());
                addParam(params, 'examRollNo',     $('#examRollNo').val());
                addParam(params, 'examination',    $('#charExamination').val());
                addParam(params, 'marksObtained',  $('#charMarks').val());
                addParam(params, 'totalMarks',     $('#charTotal').val());
                addParam(params, 'conduct',        $('#conduct').val());
                addParam(params, 'moralCharacter', $('#moralCharacter').val());
                addParam(params, 'issueDate',      $('#issueDate').val());
            }

            const qs = params.toString();
            const url = `/certificates/${type}/${studentId}${qs ? '?' + qs : ''}`;
            window.open(url, '_blank');
        }

        function addParam(params, key, val) {
            if (val !== undefined && val !== null && String(val).trim() !== '') {
                params.append(key, val);
            }
        }

        // ── Clear ─────────────────────────────────────────────────────────
        function clearFilters() {
            $('#filterClass').val('').trigger('change');
            $('#filterSection').val('').prop('disabled', true).trigger('change');
            $('#filterRollNo').find('option:not(:first)').remove();
            $('#filterStudent').find('option:not(:first)').remove();
            $('input[name="certType"][value="leaving"]').prop('checked', true);
            $('#leavingExamination, #leavingMarks, #leavingTotal').val('');
            $('#leavingClassAdmitted, #leavingClassStudying').val('').trigger('change');
            $('#boardRollNo, #examRollNo, #charExamination, #charMarks, #charTotal, #conduct, #moralCharacter').val('');
            $('#leavingDate, #issueDate').val(todayIso());
            const current = $('#charSession option').filter((i, o) => o.dataset.current === '1');
            $('#charSession').val(current.length ? current.val() : '').trigger('change');
            toggleCertFields();
        }
    </script>
}
