@model dynamic
@{
    Layout = null;

    // ---------- helpers ----------
    string FmtDate(object d)
    {
        if (d == null || d == DBNull.Value) return "";
        DateTime dt;
        return DateTime.TryParse(d.ToString(), out dt) ? dt.ToString("dd-MM-yyyy") : "";
    }

    string NumberToWords(int n)
    {
        string[] units = { "", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine",
                           "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen",
                           "Sixteen", "Seventeen", "Eighteen", "Nineteen" };
        string[] tens  = { "", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety" };

        if (n == 0)        return "Zero";
        if (n < 20)        return units[n];
        if (n < 100)       return tens[n / 10] + (n % 10 > 0 ? " " + units[n % 10] : "");
        if (n < 1000)      return units[n / 100] + " Hundred" + (n % 100 > 0 ? " " + NumberToWords(n % 100) : "");
        if (n < 1000000)   return NumberToWords(n / 1000) + " Thousand" + (n % 1000 > 0 ? " " + NumberToWords(n % 1000) : "");
        return n.ToString();
    }

    string DateToWords(object d)
    {
        if (d == null || d == DBNull.Value) return "";
        DateTime dt;
        if (!DateTime.TryParse(d.ToString(), out dt)) return "";
        string[] months = { "", "January", "February", "March", "April", "May", "June",
                            "July", "August", "September", "October", "November", "December" };
        return string.Format("{0} {1} {2}",
            NumberToWords(dt.Day), months[dt.Month], NumberToWords(dt.Year));
    }

    // safe field accessor (works for ExpandoObject / IDictionary)
    Func<string, object> F = key =>
    {
        try { return ((IDictionary<string, object>)Model)[key]; }
        catch
        {
            try { return Model[key]; }
            catch { return ""; }
        }
    };

    var boardRollNo    = F("BoardRollNo");
    var registrationNo = F("RegistrationNo");
    var sessionName    = F("SessionName");
    var studentName    = F("StudentName");
    var fatherName     = F("FatherName");
    var dob            = F("DOB");
    var examination    = F("Examination");
    var examRollNo     = F("ExamRollNo");
    var marksObtained  = F("MarksObtained");
    var totalMarks     = F("TotalMarks");
    var conduct        = F("Conduct");
    var moralCharacter = F("MoralCharacter");
    var issueDate      = F("IssueDate");
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Provisional &amp; Character Certificate</title>
    <style>
        * { box-sizing: border-box; }

        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 14px;
            color: #000;
            background: #fff;
            margin: 0;
            padding: 20px;
        }

        .certificate {
            width: 820px;
            margin: 2.5in auto 20px auto;
            padding: 35px 50px 30px 50px;
            min-height: 720px;
        }

        .title {
            text-align: center;
            font-size: 22px;
            font-weight: bold;
            text-decoration: underline;
            letter-spacing: 1px;
            margin: 5px 0 30px 0;
        }

        /* structured top rows */
        .row {
            display: flex;
            align-items: flex-end;
            margin-bottom: 14px;
        }
        .row.right-align { justify-content: flex-end; }
        .lbl { white-space: nowrap; padding: 0 6px; }

        .val {
            flex: 1;
            border-bottom: 1px dotted #000;
            text-align: center;
            font-weight: bold;
            padding: 0 6px 2px 6px;
            min-height: 20px;
        }
        .val-board {
            flex: 0 0 360px;
            border-bottom: 1px dotted #000;
            text-align: center;
            font-weight: bold;
            padding: 0 6px 2px 6px;
            min-height: 20px;
        }
        .val-fixed {
            width: 140px;
            border-bottom: 1px dotted #000;
            text-align: center;
            font-weight: bold;
            padding: 0 6px 2px 6px;
            min-height: 20px;
        }
        .gap { width: 16px; }
        .spacer { flex: 1; }

        /* flowing paragraph for the long body text */
        .body { margin-top: 6px; }
        .flow {
            margin: 0 0 6px 0;
            text-align: justify;
            line-height: 2.1;
        }

        .ival {
            display: inline-block;
            border-bottom: 1px dotted #000;
            text-align: center;
            font-weight: bold;
            padding: 0 6px;
            margin: 0 2px;
            line-height: 1.3;
            vertical-align: bottom;
        }
        .ival-sm { min-width: 60px; }
        .ival-md { min-width: 140px; }
        .ival-lg { min-width: 230px; }
        .ival-xl { min-width: 360px; }

        .conduct-line {
            text-align: center;
            margin: 4px 0 6px 0;
        }
        .conduct-line .ival { min-width: 380px; }

        /* footer */
        .footer {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-top: 50px;
        }
        .sig-block { text-align: center; min-width: 220px; }
        .sig-line {
            border-bottom: 1px solid #000;
            width: 220px;
            min-height: 32px;
            display: flex;
            align-items: flex-end;
            justify-content: center;
            font-weight: bold;
            padding-bottom: 2px;
        }
        .sig-label {
            font-weight: bold;
            padding-top: 4px;
        }

        @@media print {
            body { padding: 0; background: #fff; }
            .certificate { box-shadow: none; }
        }
    </style>
</head>
<body>

    <div class="certificate">

        <div class="title">PROVISIONAL &amp; CHARACTER CERTIFICATE</div>

        <!-- Board Roll No (right-aligned) -->
        <div class="row right-align">
            <span class="lbl">Board Roll No.</span>
            <span class="val-board">@boardRollNo</span>
        </div>

        <!-- Registration No + Session -->
        <div class="row">
            <span class="lbl" style="padding-left:0;">Registration No.</span>
            <span class="val">@registrationNo</span>
            <span class="gap"></span>
            <span class="lbl">Session</span>
            <span class="val">@sessionName</span>
        </div>

        <!-- It is certified that ... -->
        <div class="row" style="padding-left:30px;">
            <span class="lbl" style="padding-left:0;">It is certified that</span>
            <span class="val">@studentName</span>
        </div>

        <!-- S/D/O ... whose date of birth -->
        <div class="row">
            <span class="lbl" style="padding-left:0;">S/D/O</span>
            <span class="val">@fatherName</span>
            <span class="lbl">whose date of birth</span>
        </div>

        <!-- is (In Figures) ... -->
        <div class="row">
            <span class="lbl" style="padding-left:0;">is (In Figures)</span>
            <span class="val-fixed">@FmtDate(dob)</span>
            <span class="spacer"></span>
        </div>

        <!-- (In Words) ... -->
        <div class="row">
            <span class="lbl" style="padding-left:0;">(In Words)</span>
            <span class="val">@DateToWords(dob)</span>
        </div>

        <!-- Long flowing body paragraph -->
        <div class="body">
            <p class="flow">
                has been regular student of this school. He/She has been declared pass / fail in the Secondary School
                Certificate Annual Examination
                <span class="ival ival-md">@examination</span>
                held by the
                Board of Intermediate and Secondary Education Bahawalpur under Roll No.
                <span class="ival ival-lg">@examRollNo</span>
                securing
                <span class="ival ival-sm">@marksObtained</span>
                /
                <span class="ival ival-sm">@totalMarks</span>
                marks. During his/her studies at this school, I have found him/her
            </p>

            <div class="conduct-line">
                <span class="ival">@conduct</span>
            </div>

            <p class="flow">
                He/She bears
                <span class="ival ival-md">@moralCharacter</span>
                moral character. May he/she succeed in every walk of life.
            </p>
        </div>

        <!-- Footer: Issue Date (left) + Principal (right) -->
        <div class="footer">
            <div class="sig-block">
                <div class="sig-line">@FmtDate(issueDate)</div>
                <div class="sig-label">Issue Date</div>
            </div>
            <div class="sig-block">
                <div class="sig-line"></div>
                <div class="sig-label">Principal</div>
            </div>
        </div>

    </div>

</body>
</html>
