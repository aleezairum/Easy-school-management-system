                                <div class="mb-3" id="excelPreviewSection" style="display:none;"><div class="p-2 border rounded d-flex justify-content-between align-items-center" style="background:#fff;"><span><i class="bi bi-file-earmark-excel text-success me-1"></i><span id="excelFileName"></span></span><span class="badge bg-success" id="excelRowCount">0 rows</span></div></div>
                                <div class="mb-3" id="excelColumnsSection" style="display:none;"><label class="form-label fw-semibold">Map Columns</label><div class="row"><div class="col-md-6 mb-3"><label class="form-label">Phone Column <span class="text-danger">*</span></label><select class="form-select" id="excelPhoneColumn"><option value="">-- Select --</option></select></div><div class="col-md-6 mb-3"><label class="form-label">Message Column <span class="text-danger">*</span></label><select class="form-select" id="excelMessageColumn"><option value="">-- Select --</option></select></div></div></div>
                                <div class="d-flex gap-2"><button type="button" class="btn btn-primary" onclick="sendExcelSMS()"><i class="bi bi-send me-1"></i>Send</button><button type="button" class="btn btn-secondary" onclick="clearExcelForm()"><i class="bi bi-x-lg me-1"></i>Clear</button></div>
