@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script>
        let excelParsedData = [];
        let excelHeaders    = [];

        $(document).ready(function () {
            const today = toInputDate();
            $('#absentDate, #lateDate, #againDate').val(today);
            $('#fromtoFromDate, #fromtoToDate, #historyFromDate, #historyToDate').val(today);
            // Default due date = 10 days from today
            const due = new Date(); due.setDate(due.getDate() + 10);
            $('#feeDueDate').val(toInputDate(due));
            // Till date defaults to today = every current defaulter.
            $('#feeTillDate').val(today);

            loadAllDropdowns();
            toggleGeneralFields(); toggleAbsentFields(); toggleLateFields();
            toggleAgainFields();   toggleFeeFields();    toggleResultFields();
            toggleFromToFields();  toggleRcardFields();

            // Resume any SMS jobs that were running before the last reload.
            resumeActiveSmsJobs();

            // Start global queue-status widget polling.
            startQueueStatusPolling();
            startWahaStatusPolling();

            // Tell the user straight away if the free gateway is down, rather
            // than letting them build a batch and only find out on Send.
            alertIfWahaDisconnectedOnLoad();
        });

        // Load-time check. Only speaks up when WAHA is actually disconnected.
        async function alertIfWahaDisconnectedOnLoad() {
            // Forced: a cached "disconnected" from before the user reconnected
            // would raise a false alarm on every reload.
            const status = await refreshWahaStatus(true);
            if (!status || status.connected) return;

            const unsent = await fetch(`${API_BASE}/Sms/unsent`)
                .then(r => r.ok ? r.json() : null)
                .then(j => (j ? j.unsent || 0 : 0))
                .catch(() => 0);

            const actions = [
                { id: 'recheck', label: 'Check again', icon: 'bi-arrow-clockwise', cls: 'btn-outline-secondary',
                  handler: async () => {
                      const again = await refreshWahaStatus(true);
                      if (again && again.connected) {
                          toastSuccess('WhatsApp (free) is connected.');
                          return true;                 // close — all good
                      }
                      toastWarning(`WAHA is still disconnected${again ? ' — status ' + again.status : ''}.`);
                      $('#wahaGateStatus').text(
                          `WAHA session status: ${(again && again.status) || 'unknown'} (checked ${new Date().toLocaleTimeString()})`);
                      return false;                    // keep the modal open
                  } }
            ];

            // Only worth offering when there is actually something to reject.
            if (unsent > 0) {
                actions.push({ id: 'reject', label: `Reject all (${unsent})`, icon: 'bi-x-octagon',
                               cls: 'btn-outline-danger', handler: () => rejectAllUnsent(null) });
            }

            await openWahaGate({
                title: 'WhatsApp (free) is not connected',
                message: unsent > 0
                    ? `The WAHA session is not connected, and ${unsent} message(s) are already waiting in the queue. ` +
                      'Free-routed messages will be held instead of sent.'
                    : 'The WAHA session is not connected. Anything routed to the free gateway will be held ' +
                      'instead of sent until you connect it.',
                status: status.status,
                cancelLabel: 'Continue anyway',
                actions
            });
        }

