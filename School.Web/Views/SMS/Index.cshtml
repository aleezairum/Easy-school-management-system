                                <div class="mb-3"><label class="form-label">Message</label><textarea class="form-control" id="rcardMessage" rows="4" placeholder="Optional custom message..." onkeyup="updateCharCount('rcardMessage','rcardCharCount')"></textarea><small class="text-muted">Characters: <span id="rcardCharCount">0</span></small></div>
                                <div class="d-flex gap-2"><button type="button" class="btn btn-primary" onclick="sendRcardSMS()"><i class="bi bi-send me-1"></i>Send</button><button type="button" class="btn btn-secondary" onclick="clearRcardForm()"><i class="bi bi-x-lg me-1"></i>Clear</button></div>
                            </div>
                        </div>
                        <div class="col-lg-6 col-12"><div class="p-3" style="background:#f8fafc;border-radius:12px;height:100%;"><h6 class="mb-3 fw-semibold text-secondary">Sending Detail - Message Sent (<span id="rcardSentCount">0</span>)</h6><textarea class="form-control" id="rcardSendingLog" rows="10" readonly style="background:#fff;"></textarea></div></div>
