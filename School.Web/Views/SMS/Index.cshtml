@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script>
        let excelParsedData = [];
        let excelHeaders    = [];

        $(document).ready(function () {
            const today = new Date().toISOString().split('T')[0];
            $('#absentDate, #lateDate, #againDate').val(today);
            $('#fromtoFromDate, #fromtoToDate, #historyFromDate, #historyToDate').val(today);
            // Default due date = 10 days from today
            const due = new Date(); due.setDate(due.getDate() + 10);
            $('#feeDueDate').val(due.toISOString().split('T')[0]);

            loadAllDropdowns();
            toggleGeneralFields(); toggleAbsentFields(); toggleLateFields();
            toggleAgainFields();   toggleFeeFields();    toggleResultFields();
            toggleFromToFields();  toggleRcardFields();

            // Resume any SMS jobs that were running before the last reload.
            resumeActiveSmsJobs();

            // Start global queue-status widget polling.
            startQueueStatusPolling();
            startWahaStatusPolling();
        });

        // ── DROPDOWNS ─────────────────────────────────────────────────
        async function loadAllDropdowns() {
            try {
                const [classes, exams] = await Promise.all([
                    fetch(`${API_BASE}/class`).then(r => r.ok ? r.json() : []),
                    fetch(`${API_BASE}/Exam`).then(r  => r.ok ? r.json() : [])
                ]);
                ['generalClassId','absentClassId','lateClassId','againClassId',
                 'feeClassId','resultClassId','fromtoClassId','rcardClassId'].forEach(id => {
                    const s = $(`#${id}`); s.find('option:not(:first)').remove();
                    classes.forEach(c => s.append(`<option value="${c.vid}">${c.vName}</option>`));
                });
                ['resultExamId','rcardExamId'].forEach(id => {
                    const s = $(`#${id}`); s.find('option:not(:first)').remove();
                    exams.forEach(e => s.append(`<option value="${e.vid}">${e.vName}</option>`));
                });
                // Default-select the latest exam (highest VID = most recently created)
                if (exams && exams.length > 0) {
                    const latest = exams.reduce((a, b) => (a.vid >= b.vid ? a : b));
                    $('#resultExamId, #rcardExamId').val(String(latest.vid));
                }
            } catch (e) { console.error(e); }
        }

        function updateCharCount(t, c) { $(`#${c}`).text($(`#${t}`).val().length); }

        // ── TOGGLE FIELDS ─────────────────────────────────────────────
        function toggleGeneralFields() { const c=$('input[name="generalChoose"]:checked').val(); $('#generalClassField').toggle(c!=='all'); $('#generalSectionField').toggle(c==='section'||c==='student'); $('#generalStudentField').toggle(c==='student'); }
        function toggleAbsentFields()  { const c=$('input[name="absentChoose"]:checked').val();  $('#absentClassField').toggle(c!=='all');  $('#absentSectionField').toggle(c==='section'||c==='student');  $('#absentStudentField').toggle(c==='student'); }
        function toggleLateFields()    { const c=$('input[name="lateChoose"]:checked').val();    $('#lateClassField').toggle(c!=='all');    $('#lateSectionField').toggle(c==='section'||c==='student');    $('#lateStudentField').toggle(c==='student'); }
        function toggleAgainFields()   { const c=$('input[name="againChoose"]:checked').val();   $('#againClassField').toggle(c!=='all');   $('#againSectionField').toggle(c==='section'||c==='student');   $('#againStudentField').toggle(c==='student'); }
        function toggleFeeFields()     { const c=$('input[name="feeChoose"]:checked').val();     $('#feeClassField').toggle(c!=='all');     $('#feeSectionField').toggle(c==='section'||c==='student');     $('#feeStudentField').toggle(c==='student'); }
        function toggleResultFields()  { const c=$('input[name="resultChoose"]:checked').val();  $('#resultClassField').toggle(c!=='all');  $('#resultSectionField').toggle(c==='section'||c==='student');  $('#resultStudentField').toggle(c==='student'); }
        function toggleFromToFields()  { const c=$('input[name="fromtoChoose"]:checked').val();  $('#fromtoClassField').toggle(c!=='all');  $('#fromtoSectionField').toggle(c==='section'||c==='student');  $('#fromtoStudentField').toggle(c==='student'); }
        function toggleRcardFields()   { const c=$('input[name="rcardChoose"]:checked').val();   $('#rcardClassField').toggle(c!=='all');   $('#rcardSectionField').toggle(c==='section'||c==='student');   $('#rcardStudentField').toggle(c==='student'); }

        // ── SECTION / STUDENT LOADERS ─────────────────────────────────
        async function loadSectionsFor(cId, sId) {
            const v=$(`#${cId}`).val(); const s=$(`#${sId}`); s.find('option:not(:first)').remove();
            if (!v) return;
            try { const r=await fetch(`${API_BASE}/section/byClass/${v}`); if(r.ok){const d=await r.json(); d.forEach(x=>s.append(`<option value="${x.vid}">${x.vName}</option>`));} } catch(e){console.error(e);}
        }
        async function loadStudentsFor(cId, sId, stId) {
            const cv=$(`#${cId}`).val(); const sv=$(`#${sId}`).val(); const st=$(`#${stId}`); st.find('option:not(:first)').remove();
            if (!cv||!sv) return;
            try { const r=await fetch(`${API_BASE}/Student/students?classId=${cv}&sectionId=${sv}`); if(r.ok){const d=await r.json(); d.forEach(x=>st.append(`<option value="${x.vid}" data-phone="${x.mobile||''}">${x.name} (${x.rollNo||'-'})</option>`));} } catch(e){console.error(e);}
        }

        async function loadGeneralSections() { await loadSectionsFor('generalClassId','generalSectionId'); }
        async function loadAbsentSections()  { await loadSectionsFor('absentClassId','absentSectionId'); }
        async function loadLateSections()    { await loadSectionsFor('lateClassId','lateSectionId'); }
        async function loadAgainSections()   { await loadSectionsFor('againClassId','againSectionId'); }
        async function loadFeeSections()     { await loadSectionsFor('feeClassId','feeSectionId'); }
        async function loadResultSections()  { await loadSectionsFor('resultClassId','resultSectionId'); }
        async function loadFromToSections()  { await loadSectionsFor('fromtoClassId','fromtoSectionId'); }
        async function loadRcardSections()   { await loadSectionsFor('rcardClassId','rcardSectionId'); }

        async function loadGeneralStudents() { await loadStudentsFor('generalClassId','generalSectionId','generalStudentId'); }
        async function loadAbsentStudents()  { await loadStudentsFor('absentClassId','absentSectionId','absentStudentId'); }
        async function loadLateStudents()    { await loadStudentsFor('lateClassId','lateSectionId','lateStudentId'); }
        async function loadAgainStudents()   { await loadStudentsFor('againClassId','againSectionId','againStudentId'); }
        async function loadFeeStudents()     { await loadStudentsFor('feeClassId','feeSectionId','feeStudentId'); }
        async function loadResultStudents()  { await loadStudentsFor('resultClassId','resultSectionId','resultStudentId'); }
        async function loadFromToStudents()  { await loadStudentsFor('fromtoClassId','fromtoSectionId','fromtoStudentId'); }
        async function loadRcardStudents()   { await loadStudentsFor('rcardClassId','rcardSectionId','rcardStudentId'); }

        async function loadStaffByType() {
            const s=$('#staffTo'); s.find('option:not(:first)').remove();
            if (!$('#staffType').val()) return;
            try { const r=await fetch(`${API_BASE}/Employee`); if(r.ok){const d=await r.json(); d.forEach(x=>s.append(`<option value="${x.id}" data-phone="${x.mobile||x.phone||''}">${x.fullName||x.name}</option>`));} } catch(e){console.error(e);}
        }
        function updateStaffContact() { const p=$('#staffTo option:selected').data('phone'); if(p) $('#staffContactNo').val(p); }

        // ── LOGGING ───────────────────────────────────────────────────
        function logSMS(logId, countId, message) {
            const ts=new Date().toLocaleString(); const log=$(`#${logId}`);
            log.val(log.val()+`[${ts}] ${message}\n`);
            log.scrollTop(log[0].scrollHeight);
            $(`#${countId}`).text(parseInt($(`#${countId}`).text())+1);
        }

        // ── LIVE PROGRESS ─────────────────────────────────────────────
        function newJobId() {
            if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
            return 'job-' + Date.now() + '-' + Math.random().toString(36).slice(2, 10);
        }

        // Active jobs are persisted to localStorage so that closing the
        // browser/tab mid-send doesn't lose the reference. On page reload
        // resumeActiveSmsJobs() picks them back up.
        const SMS_JOBS_KEY = 'sms_active_jobs';
        function getActiveJobs() {
            try { return JSON.parse(localStorage.getItem(SMS_JOBS_KEY) || '{}'); }
            catch (e) { return {}; }
        }
        function saveActiveJob(logId, jobId, label) {
            const jobs = getActiveJobs();
            jobs[logId] = { jobId, label: label || '', startedAt: Date.now() };
            localStorage.setItem(SMS_JOBS_KEY, JSON.stringify(jobs));
        }
        function clearActiveJob(logId) {
            const jobs = getActiveJobs();
            if (jobs[logId]) {
                delete jobs[logId];
                localStorage.setItem(SMS_JOBS_KEY, JSON.stringify(jobs));
            }
        }

        // Global queue widget — polls /Sms/queue-status every 5 sec.
        let queueStatusTimer = null;
        async function refreshQueueStatus() {
            try {
                const r = await fetch(`${API_BASE}/Sms/queue-status`);
                if (!r.ok) return;
                const j = await r.json();
                const pending = j.pending || 0;
                $('#queuePendingBadge').text(pending + ' pending');
                if (pending > 0) {
                    $('#queuePendingBadge').removeClass('bg-success').addClass('bg-warning');
                    $('#queueStatusText').text('processing...');
                } else {
                    $('#queuePendingBadge').removeClass('bg-warning').addClass('bg-success');
                    $('#queueStatusText').text('idle');
                }
            } catch (e) { /* ignore */ }
        }
        function startQueueStatusPolling() {
            refreshQueueStatus();
            if (queueStatusTimer) clearInterval(queueStatusTimer);
            queueStatusTimer = setInterval(refreshQueueStatus, 5000);
        }

        // WAHA connection badge — polls /Sms/waha-status every 15 sec
        // (server-side response is itself cached ~20s, so this stays cheap).
        let wahaStatusTimer = null;
        async function refreshWahaStatus() {
            const badge = $('#wahaStatusBadge');
            try {
                const r = await fetch(`${API_BASE}/Sms/waha-status`);
                if (!r.ok) { badge.text('unknown').removeClass('bg-success bg-danger').addClass('bg-secondary'); return; }
                const j = await r.json();
                if (j.connected) {
                    badge.text('Connected').removeClass('bg-secondary bg-danger').addClass('bg-success');
                    badge.attr('title', 'Absent & Fee notifications are going out free through WAHA');
                } else {
                    badge.text('Disconnected (using paid)').removeClass('bg-secondary bg-success').addClass('bg-danger');
                    badge.attr('title', `WAHA status: ${j.status}${j.error ? ' — ' + j.error : ''}. Absent & Fee notifications are falling back to the paid provider.`);
                }
            } catch (e) {
                badge.text('unknown').removeClass('bg-success bg-danger').addClass('bg-secondary');
            }
        }
        function startWahaStatusPolling() {
            refreshWahaStatus();
            if (wahaStatusTimer) clearInterval(wahaStatusTimer);
            wahaStatusTimer = setInterval(refreshWahaStatus, 15000);
        }

        // Replaces the LAST line of the textarea (or appends one) so the
        // counter updates in place instead of spamming new lines.
        function setStatusLine(logId, message) {
            const log = $(`#${logId}`);
            const lines = (log.val() || '').split('\n');
            // strip trailing empty line
            if (lines.length && lines[lines.length - 1] === '') lines.pop();
            const ts = new Date().toLocaleTimeString();
            const newLine = `[${ts}] ${message}`;
            if (lines.length && /^\[\d{1,2}:\d{2}:\d{2}.*\] ⏳/.test(lines[lines.length - 1])) {
                lines[lines.length - 1] = newLine;
            } else {
                lines.push(newLine);
            }
            log.val(lines.join('\n') + '\n');
            log.scrollTop(log[0].scrollHeight);
        }

        // Polls /Sms/progress/{jobId} every 1500ms until the job reports
        // IsComplete (or the server returns 404 = expired/unknown). On
        // completion it clears localStorage, shows a final toast, and
        // resolves the returned promise. Caller can still call the
        // returned stop() handle to cancel manually.
        function startProgressPoll(jobId, logId, opts) {
            opts = opts || {};
            const showToasts = opts.showToasts !== false;
            const missing404Limit = opts.missing404Limit || 3;
            let stopped = false;
            let missing = 0;
            const run = new Promise((resolve) => {
                const tick = async () => {
                    if (stopped) { resolve(null); return; }
                    try {
                        const r = await fetch(`${API_BASE}/Sms/progress/${jobId}`);
                        if (r.status === 404) {
                            // Not registered yet (first polls) or already purged.
                            if (++missing >= missing404Limit) {
                                stopped = true;
                                clearActiveJob(logId);
                                setStatusLine(logId, `⚠️ Job not found (expired or never started).`);
                                resolve(null);
                                return;
                            }
                        } else if (r.ok) {
                            missing = 0;
                            const p = await r.json();
                            const total = p.total || 0;
                            const processed = p.processed || 0;
                            const sent = p.sent || 0;
                            const failed = p.failed || 0;
                            const totalLabel = total > 0 ? total : '?';
                            if (p.isComplete) {
                                stopped = true;
                                clearActiveJob(logId);
                                setStatusLine(logId,
                                    `✅ Sent: ${sent} | ❌ Failed: ${failed} | Total: ${total}`);
                                if (showToasts) {
                                    if (failed > 0) toastWarning(`${sent} sent, ${failed} failed`);
                                    else if (sent > 0) toastSuccess(`${sent} SMS sent successfully!`);
                                }
                                resolve(p);
                                return;
                            }
                            setStatusLine(logId,
                                `⏳ Processing ${processed}/${totalLabel} | ✅ Sent: ${sent} | ❌ Failed: ${failed}`);
                        }
                    } catch (e) { /* network blip — keep polling */ }
                    if (!stopped) setTimeout(tick, 1500);
                };
                setTimeout(tick, 250);
            });
            const stop = () => { stopped = true; };
            stop.done = run;
            return stop;
        }

        // On page load: if any SMS job is marked active in localStorage,
        // resume polling it so the status textarea keeps updating even
        // after a full browser reload.
        function resumeActiveSmsJobs() {
            const jobs = getActiveJobs();
            Object.keys(jobs).forEach(logId => {
                const entry = jobs[logId];
                if (!entry || !entry.jobId) { clearActiveJob(logId); return; }
                if ($(`#${logId}`).length === 0) return; // log element not on this page
                setStatusLine(logId, `🔄 Resuming active job... (${entry.label || entry.jobId})`);
                startProgressPoll(entry.jobId, logId);
            });
        }

        // ── GENERIC SEND ──────────────────────────────────────────────
        async function sendSmsViaApi(recipients, message, messageType, logId, countId) {
            if (!recipients||recipients.length===0) { toastWarning('No recipients found'); return; }
            if (!message) { toastWarning('Please enter a message'); return; }
            const jobId = newJobId();
            logSMS(logId, countId, `📤 Sending to ${recipients.length} recipient(s)...`);
            // Persist immediately so a reload mid-send can still resume.
            saveActiveJob(logId, jobId, `Bulk SMS (${recipients.length})`);
            try {
                const r=await fetch(`${API_BASE}/Sms/send`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({recipients,message,messageType,jobId})});
                if(!r.ok){
                    const e=await r.json().catch(()=>({message:'Send failed'}));
                    toastError(e.message||'Failed');
                    clearActiveJob(logId);
                    return;
                }
                // Server returned 202 Accepted — send continues in background.
                toastInfo('Sending started in background...');
                startProgressPoll(jobId, logId);
            } catch(ex){
                console.error(ex);
                toastError('Network error');
                clearActiveJob(logId);
            }
        }

