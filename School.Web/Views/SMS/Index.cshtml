                                <div class="d-flex gap-2"><button type="button" class="btn btn-primary" onclick="sendFromToSMS()"><i class="bi bi-send me-1"></i>Send</button><button type="button" class="btn btn-secondary" onclick="clearFromToForm()"><i class="bi bi-x-lg me-1"></i>Clear</button></div>
