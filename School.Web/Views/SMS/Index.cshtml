<!-- WHATSAPP (FREE) DISCONNECTED MODAL                              -->
<!-- Shown before a free-routed send starts, and whenever a running   -->
<!-- job has messages parked waiting for WAHA.                        -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="modal fade" id="wahaGateModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:14px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-danger" id="wahaGateTitle">
                    <i class="bi bi-plug me-2"></i>WhatsApp (free) is disconnected
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2" id="wahaGateMessage">
                    These messages are set up to go out free through WAHA, but the WAHA session
                    is not connected right now.
                </p>
                <div class="p-3 mb-3" style="background:#fff7ed;border:1px solid #fed7aa;border-radius:10px;font-size:13px;">
                    <div class="mb-1"><strong>Nothing has been sent and nothing is lost.</strong></div>
                    <div class="text-muted">
                        Open the WAHA server and connect the session (scan the QR if needed),
                        then come back and resume. If this cannot wait you can send through the
                        paid gateway — that one is charged per message — or reject the messages
                        so nothing goes out at all.
                    </div>
                </div>
                <div id="wahaGateStatus" class="text-muted" style="font-size:12px;"></div>
            </div>
            <!-- Buttons are built per situation by openWahaGate(). -->
            <div class="modal-footer border-0 flex-wrap gap-2" id="wahaGateActions"></div>
        </div>
    </div>
</div>

