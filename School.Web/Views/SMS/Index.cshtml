                                <div class="mb-3" id="rcardSectionField"><label class="form-label">Section</label><select class="form-select" id="rcardSectionId" onchange="loadRcardStudents()"><option value="">-- Select Section --</option></select></div>
                                <div class="mb-3" id="rcardStudentField"><label class="form-label">Student</label><select class="form-select" id="rcardStudentId"><option value="">-- Select Student --</option></select></div>
