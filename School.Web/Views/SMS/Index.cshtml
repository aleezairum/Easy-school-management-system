        // ── EXCEL SMS ─────────────────────────────────────────────────
        function previewExcelFile() {
            const fi=$('#excelFile')[0]; if(!fi.files||!fi.files[0]) return;
            const reader=new FileReader();
            reader.onload=function(e){
                try {
                    const wb=XLSX.read(new Uint8Array(e.target.result),{type:'array'});
                    const sh=wb.Sheets[wb.SheetNames[0]];
                    excelParsedData=XLSX.utils.sheet_to_json(sh,{defval:''});
                    excelHeaders=excelParsedData.length>0?Object.keys(excelParsedData[0]):[];
                    if(!excelParsedData.length){toastWarning('Excel file is empty');clearExcelForm();return;}
                    $('#excelFileName').text(fi.files[0].name);
                    $('#excelRowCount').text(excelParsedData.length+' rows');
                    $('#excelPreviewSection').show();
                    const ps=$('#excelPhoneColumn'),ms=$('#excelMessageColumn');
                    ps.find('option:not(:first)').remove(); ms.find('option:not(:first)').remove();
                    excelHeaders.forEach(c=>{ps.append(`<option value="${c}">${c}</option>`);ms.append(`<option value="${c}">${c}</option>`);});
                    autoSelectColumn(ps,['phone','mobile','contact','number','mobileno']);
                    autoSelectColumn(ms,['message','msg','text','sms','content']);
                    $('#excelColumnsSection').show();
                    renderExcelPreviewTable();
                    toastSuccess(`File loaded: ${excelParsedData.length} rows`);
                } catch(err){console.error(err); toastError('Failed to read Excel file.');}
            };
            reader.readAsArrayBuffer(fi.files[0]);
        }

        function autoSelectColumn(sel,kw){sel.find('option').each(function(){if(kw.some(k=>$(this).val().toLowerCase().replace(/\s/g,'').includes(k))){sel.val($(this).val());return false;}});}

        function renderExcelPreviewTable(){
            $('#excelPreviewTable').remove();
            if(!excelParsedData.length) return;
            const rows=excelParsedData.slice(0,5);
            let h=`<div id="excelPreviewTable" class="mt-3"><label class="form-label fw-semibold">Preview (first 5 rows)</label><div class="table-responsive"><table class="table table-sm table-bordered" style="font-size:12px;"><thead style="background:#e2e8f0;"><tr>`;
            excelHeaders.forEach(x=>h+=`<th>${x}</th>`);
            h+=`</tr></thead><tbody>`;
            rows.forEach(r=>{h+='<tr>';excelHeaders.forEach(x=>{h+=`<td>${r[x]??''}</td>`;});h+='</tr>';});
            h+=`</tbody></table></div></div>`;
            $('#excelColumnsSection').after(h);
        }

        async function sendExcelSMS(){
            if(!$('#excelFile').val()){toastWarning('Please upload an Excel file');return;}
            const pc=$('#excelPhoneColumn').val(); const mc=$('#excelMessageColumn').val();
            if(!pc){toastWarning('Please select Phone column');return;}
            if(!mc){toastWarning('Please select Message column');return;}
            if(!excelParsedData.length){toastWarning('No data found');return;}
            const recipients=[]; const skipped=[];
            excelParsedData.forEach((row,i)=>{
                const rp=String(row[pc]??'').trim(); const rm=String(row[mc]??'').trim();
                const nm=String(row['Name']??row['name']??row['StudentName']??`Row ${i+2}`).trim();
                if(!rp){skipped.push(`Row ${i+2}: empty phone`);return;}
                if(!rm){skipped.push(`Row ${i+2}: empty message`);return;}
                const phone=normalizePhone(rp);
                if(!phone){skipped.push(`Row ${i+2}: invalid phone "${rp}"`);return;}
                recipients.push({phone,name:nm,message:rm});
            });
            if(!recipients.length){toastWarning('No valid recipients found');return;}
            if(skipped.length) logSMS('excelSendingLog','excelSentCount',`⚠️ Skipped ${skipped.length} rows`);
            logSMS('excelSendingLog','excelSentCount',`📤 Sending to ${recipients.length} recipients...`);
            const jobId = newJobId();
            saveActiveJob('excelSendingLog', jobId, `Excel SMS (${recipients.length})`);
            try {
                const r=await fetch(`${API_BASE}/Sms/send`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({recipients,message:'',messageType:8,jobId})});
                if(!r.ok){
                    const e=await r.json().catch(()=>({message:'Failed'}));
                    toastError(e.message||'Failed');
                    clearActiveJob('excelSendingLog');
                    return;
                }
                toastInfo('Excel SMS sending started in background...');
                startProgressPoll(jobId, 'excelSendingLog');
            } catch(ex){
                console.error(ex);
                toastError('Network error');
                clearActiveJob('excelSendingLog');
            }
        }

        function normalizePhone(raw){
            let d=raw.replace(/\D/g,''); if(!d) return null;
            if(d.startsWith('92')&&d.length===12) return d;
            if(d.startsWith('0')&&d.length===11) return '92'+d.substring(1);
            if(d.length===10&&d.startsWith('3')) return '92'+d;
            return d.length>=10?d:null;
        }

        function clearExcelForm(){$('#excelFile').val('');$('#excelPreviewSection,#excelColumnsSection').hide();$('#excelPreviewTable').remove();$('#excelSmsUrdu').prop('checked',false);$('#excelSendingLog').val('');$('#excelSentCount').text('0');excelParsedData=[];excelHeaders=[];}

