        // ── LIVE PROGRESS ─────────────────────────────────────────────
        function newJobId() {
            if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
            return 'job-' + Date.now() + '-' + Math.random().toString(36).slice(2, 10);
        }

        // Active jobs are persisted to localStorage so that closing the
        // browser/tab mid-send doesn't lose the reference. On page reload
        // resumeActiveSmsJobs() picks them back up.
        const SMS_JOBS_KEY = 'sms_active_jobs';
        function getActiveJobs() {
            try { return JSON.parse(localStorage.getItem(SMS_JOBS_KEY) || '{}'); }
            catch (e) { return {}; }
        }
        function saveActiveJob(logId, jobId, label) {
            const jobs = getActiveJobs();
            jobs[logId] = { jobId, label: label || '', startedAt: Date.now() };
            localStorage.setItem(SMS_JOBS_KEY, JSON.stringify(jobs));
        }
        function clearActiveJob(logId) {
            const jobs = getActiveJobs();
            if (jobs[logId]) {
                delete jobs[logId];
                localStorage.setItem(SMS_JOBS_KEY, JSON.stringify(jobs));
            }
        }

        // Global queue widget — polls /Sms/queue-status every 5 sec.
        let queueStatusTimer = null;
        async function refreshQueueStatus() {
            try {
                const r = await fetch(`${API_BASE}/Sms/queue-status`);
                if (!r.ok) return;
                const j = await r.json();
                const pending = j.pending || 0;
                const held = j.held || 0;
                $('#queuePendingBadge').text(pending + ' pending');
                if (pending > 0) {
                    $('#queuePendingBadge').removeClass('bg-success').addClass('bg-warning');
                    $('#queueStatusText').text('processing...');
                } else {
                    $('#queuePendingBadge').removeClass('bg-warning').addClass('bg-success');
                    $('#queueStatusText').text(held > 0 ? 'paused — waiting for WhatsApp (free)' : 'idle');
                }

                if (held > 0) $('#queueHeldBadge').text(held + ' held').show();
                else $('#queueHeldBadge').hide();
            } catch (e) { /* ignore */ }
        }
        function startQueueStatusPolling() {
            refreshQueueStatus();
            if (queueStatusTimer) clearInterval(queueStatusTimer);
            queueStatusTimer = setInterval(refreshQueueStatus, 5000);
        }

        // WAHA connection badge — polls /Sms/waha-status every 15 sec
        // (server-side response is itself cached ~20s, so this stays cheap).
        //
        // forceRefresh bypasses that server-side cache. Background polling must
        // NOT set it — the cache is what keeps polling cheap — but anything the
        // user triggers has to, otherwise "check again" right after they
        // reconnect WAHA just replays the stale "disconnected" answer.
        let wahaStatusTimer = null;
        async function refreshWahaStatus(forceRefresh) {
            const badge = $('#wahaStatusBadge');
            try {
                const r = await fetch(`${API_BASE}/Sms/waha-status${forceRefresh ? '?refresh=true' : ''}`);
                if (!r.ok) { badge.text('unknown').removeClass('bg-success bg-danger').addClass('bg-secondary'); return null; }
                const j = await r.json();
                if (j.gatewayUrl) wahaGatewayUrl = j.gatewayUrl;
                if (j.connected) {
                    badge.text('Connected').removeClass('bg-secondary bg-danger').addClass('bg-success');
                    badge.attr('title', 'Absent & Fee notifications are going out free through WAHA');
                    $('#wahaConnectBar').hide();
                } else {
                    badge.text('Disconnected').removeClass('bg-secondary bg-success').addClass('bg-danger');
                    badge.attr('title', `WAHA status: ${j.status}${j.error ? ' — ' + j.error : ''}. Free-routed messages are held until it is reconnected.`);
                    $('#wahaConnectBarStatus').text(j.status || 'disconnected');
                    $('#wahaConnectBar').show();
                }
                return j;
            } catch (e) {
                badge.text('unknown').removeClass('bg-success bg-danger').addClass('bg-secondary');
                return null;
            }
        }

        // The "Check again" button. Forces a real re-probe and always says what
        // it found — a silent re-check is indistinguishable from a dead button.
        async function checkWahaNow(btn) {
            const $btn = btn ? $(btn) : null;
            const original = $btn ? $btn.html() : null;
            if ($btn) $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Checking...');

            try {
                const j = await refreshWahaStatus(true);
                if (!j) { toastError('Could not reach the server to check WAHA.'); return null; }

                if (j.connected) toastSuccess('WhatsApp (free) is connected.');
                else toastWarning(`WAHA is still disconnected — status ${j.status}. Open it with "Connect to WAHA" and scan the QR if needed.`);

                return j;
            } finally {
                if ($btn) $btn.prop('disabled', false).html(original);
            }
        }

        function startWahaStatusPolling() {
            refreshWahaStatus();
            if (wahaStatusTimer) clearInterval(wahaStatusTimer);
            wahaStatusTimer = setInterval(refreshWahaStatus, 15000);
        }

        // Replaces the LAST line of the textarea (or appends one) so the
        // counter updates in place instead of spamming new lines.
        function setStatusLine(logId, message) {
            const log = $(`#${logId}`);
            const lines = (log.val() || '').split('\n');
            // strip trailing empty line
            if (lines.length && lines[lines.length - 1] === '') lines.pop();
            const ts = new Date().toLocaleTimeString();
            const newLine = `[${ts}] ${message}`;
            if (lines.length && /^\[\d{1,2}:\d{2}:\d{2}.*\] ⏳/.test(lines[lines.length - 1])) {
                lines[lines.length - 1] = newLine;
            } else {
                lines.push(newLine);
            }
            log.val(lines.join('\n') + '\n');
            log.scrollTop(log[0].scrollHeight);
        }

        // Polls /Sms/progress/{jobId} every 1500ms until the job reports
        // IsComplete (or the server returns 404 = expired/unknown). On
        // completion it clears localStorage, shows a final toast, and
        // resolves the returned promise. Caller can still call the
        // returned stop() handle to cancel manually.
        function startProgressPoll(jobId, logId, opts) {
            opts = opts || {};
            const showToasts = opts.showToasts !== false;
            const missing404Limit = opts.missing404Limit || 3;
            let stopped = false;
            let missing = 0;
            let heldWarned = false;
            $(`#${logId}`).data('polling', true);
            const run = new Promise((resolve) => {
                // Single exit point so the poller flag (read by resumeHeld to
                // decide whether to restart polling) is always cleared.
                const finish = (value) => {
                    stopped = true;
                    $(`#${logId}`).data('polling', false);
                    resolve(value);
                };
                const tick = async () => {
                    if (stopped) { finish(null); return; }
                    try {
                        const r = await fetch(`${API_BASE}/Sms/progress/${jobId}`);
                        if (r.status === 404) {
                            // Not registered yet (first polls) or already purged.
                            if (++missing >= missing404Limit) {
                                clearActiveJob(logId);
                                setStatusLine(logId, `⚠️ Job not found (expired or never started).`);
                                finish(null);
                                return;
                            }
                        } else if (r.ok) {
                            missing = 0;
                            const p = await r.json();
                            const total = p.total || 0;
                            const processed = p.processed || 0;
                            const sent = p.sent || 0;
                            const failed = p.failed || 0;
                            const held = p.held || 0;
                            const pending = p.pending || 0;
                            const totalLabel = total > 0 ? total : '?';

                            // Held rows keep the hold panel (and its two resume
                            // buttons) on screen; it clears itself once they go.
                            renderHoldPanel(logId, jobId, held);

                            if (p.isComplete) {
                                clearActiveJob(logId);
                                setStatusLine(logId,
                                    `✅ Sent: ${sent} | ❌ Failed: ${failed} | Total: ${total}`);
                                if (showToasts) {
                                    if (failed > 0) toastWarning(`${sent} sent, ${failed} failed`);
                                    else if (sent > 0) toastSuccess(`${sent} SMS sent successfully!`);
                                }
                                finish(p);
                                return;
                            }

                            // Everything left is parked: stop polling and wait
                            // for the user to resume from the hold panel. The
                            // job stays in localStorage so a reload comes back
                            // to the same paused state.
                            if (held > 0 && pending === 0) {
                                setStatusLine(logId,
                                    `⏸️ Paused — ${held} waiting for WhatsApp (free) | ✅ Sent: ${sent} | ❌ Failed: ${failed}`);
                                if (showToasts && !heldWarned) {
                                    heldWarned = true;
                                    toastWarning(`${held} message(s) are on hold — WhatsApp (free) is disconnected.`);
                                }
                                finish(p);
                                return;
                            }

                            setStatusLine(logId,
                                `⏳ Processing ${processed}/${totalLabel} | ✅ Sent: ${sent} | ❌ Failed: ${failed}` +
                                (held > 0 ? ` | ⏸️ Held: ${held}` : ''));
                        }
                    } catch (e) { /* network blip — keep polling */ }
                    if (!stopped) setTimeout(tick, 1500);
                };
                setTimeout(tick, 250);
            });
            const stop = () => { stopped = true; };
            stop.done = run;
            return stop;
        }

        // On page load: if any SMS job is marked active in localStorage,
        // resume polling it so the status textarea keeps updating even
        // after a full browser reload.
        function resumeActiveSmsJobs() {
            const jobs = getActiveJobs();
            Object.keys(jobs).forEach(logId => {
                const entry = jobs[logId];
                if (!entry || !entry.jobId) { clearActiveJob(logId); return; }
                if ($(`#${logId}`).length === 0) return; // log element not on this page
                setStatusLine(logId, `🔄 Resuming active job... (${entry.label || entry.jobId})`);
                startProgressPoll(entry.jobId, logId);
            });
        }

        // ══════════════════════════════════════════════════════════════
        // ROUTE GATE — free (WAHA) vs paid (Meta)
        // ══════════════════════════════════════════════════════════════
        // Mirrors SmsMessageType on the API.
        const SMS_TYPE = {
            Staff: 1, General: 2, Absent: 3, Late: 4,
            Fee: 5, Result: 6, FromTo: 7, Excel: 8, Rcard: 9
        };

        // Asks the API where a message of this type would go right now.
        // routesFree=false means the type is configured for the paid gateway
        // anyway, so a disconnected WAHA is irrelevant and nothing is prompted.
        async function checkRoute(messageType) {
            try {
                const r = await fetch(`${API_BASE}/Sms/waha-status?refresh=true&messageType=${messageType}`);
                if (!r.ok) return { connected: false, routesFree: false, status: 'UNKNOWN' };
                return await r.json();
            } catch (e) {
                return { connected: false, routesFree: false, status: 'UNREACHABLE' };
            }
        }

        // The WAHA server's own address, so "Connect to WAHA" can open it.
        // Filled from /Sms/waha-status; the page never hardcodes it.
        let wahaGatewayUrl = '';

        function openWahaServer() {
            if (!wahaGatewayUrl) { toastWarning('The WAHA server address is not configured.'); return; }
            window.open(wahaGatewayUrl, '_blank', 'noopener');
            toastInfo('Connect the WhatsApp session in the new tab, then come back and resume.');
        }

        // Opens the "WhatsApp (free) is disconnected" alert and resolves with
        // the id of the action the user took (or null if they closed it).
        //
        // opts.actions is a list of { id, label, icon, cls, handler }. A handler
        // returning false keeps the modal open — used when the user asks to
        // resume free but WAHA is still down, so they can read why and pick
        // another option. Handlers may also be omitted for a plain close.
        function openWahaGate(opts) {
            const modalEl = document.getElementById('wahaGateModal');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);

            $('#wahaGateTitle').html('<i class="bi bi-plug me-2"></i>' + (opts.title || 'WhatsApp (free) is disconnected'));
            $('#wahaGateMessage').text(opts.message ||
                'These messages are set up to go out free through WAHA, but the WAHA session is not connected right now.');
            $('#wahaGateStatus').text(opts.status ? `WAHA session status: ${opts.status}` : '');

            // "Connect to WAHA" and a Cancel are offered in every situation.
            const actions = [
                { id: 'connect', label: 'Connect to WAHA', icon: 'bi-box-arrow-up-right',
                  cls: 'btn-primary', keepOpen: true, handler: () => { openWahaServer(); return false; } },
                ...(opts.actions || [])
            ];

            const $bar = $('#wahaGateActions').empty();
            $bar.append(`<button type="button" class="btn btn-outline-secondary me-auto" data-bs-dismiss="modal">${
                opts.cancelLabel || 'Cancel'}</button>`);

            actions.forEach((a, i) => {
                $bar.append(`<button type="button" class="btn ${a.cls || 'btn-secondary'}" data-gate-index="${i}">
                    <i class="bi ${a.icon || 'bi-check2'} me-1"></i>${a.label}</button>`);
            });

            return new Promise((resolve) => {
                let settled = false;
                const finish = (value) => {
                    if (settled) return;
                    settled = true;
                    $bar.off('click.gate');
                    $(modalEl).off('hidden.bs.modal.gate');
                    resolve(value);
                };

                $bar.off('click.gate').on('click.gate', 'button[data-gate-index]', async function () {
                    const btn = $(this);
                    const action = actions[parseInt(btn.attr('data-gate-index'), 10)];
                    if (!action) return;

                    const original = btn.html();
                    $bar.find('button').prop('disabled', true);
                    btn.html('<span class="spinner-border spinner-border-sm me-1"></span>Working...');

                    let close = true;
                    try { close = action.handler ? await action.handler() : true; }
                    catch (e) { console.error(e); close = false; }
                    finally {
                        $bar.find('button').prop('disabled', false);
                        btn.html(original);
                    }

                    if (close) { modal.hide(); finish(action.id); }
                });

                // Cancel / X / Esc.
                $(modalEl).off('hidden.bs.modal.gate').on('hidden.bs.modal.gate', () => finish(null));

                modal.show();
            });
        }

        // Rejects every unsent message (Pending + Held) after confirming the
        // count. Returns true when something was rejected.
        async function rejectAllUnsent(jobId) {
            let unsent = 0;
            try {
                const q = jobId ? `?jobId=${encodeURIComponent(jobId)}` : '';
                const r = await fetch(`${API_BASE}/Sms/unsent${q}`);
                if (r.ok) unsent = (await r.json()).unsent || 0;
            } catch (e) { /* fall through — confirm without a count */ }

            if (unsent === 0) {
                toastInfo('There are no unsent messages to reject.');
                refreshQueueStatus();
                return false;
            }

            if (!confirm(
                `Reject ${unsent} unsent message${unsent === 1 ? '' : 's'}?\n\n` +
                `They will be cancelled immediately and will NOT be sent. ` +
                `Messages already sent are not affected. This cannot be undone.`))
                return false;

            try {
                const r = await fetch(`${API_BASE}/Sms/reject`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ jobId: jobId || null })
                });
                const j = await r.json().catch(() => ({}));
                if (!r.ok) { toastError(j.message || 'Could not reject the messages'); return false; }

                toastSuccess(`${j.rejected || 0} message(s) rejected — nothing further will be sent.`);
                $('[id$=HoldPanel]').remove();
                refreshQueueStatus();
                return true;
            } catch (e) {
                console.error(e);
                toastError('Network error while rejecting');
                return false;
            }
        }

        // Call before queueing a batch. Resolves to { proceed, forcePaid }.
        // proceed=false means the user cancelled and nothing should be sent.
        async function ensureRoute(messageType) {
            const route = await checkRoute(messageType);

            // Not a free-routed type, or WAHA is up — nothing to ask.
            if (!route.routesFree || route.connected)
                return { proceed: true, forcePaid: false };

            const choice = await openWahaGate({
                status: route.status,
                actions: [
                    {
                        id: 'free', label: 'Send free (WAHA)', icon: 'bi-arrow-repeat', cls: 'btn-success',
                        handler: async () => {
                            // Re-probe. The user was told to connect WAHA first,
                            // so if it is still down the modal stays open.
                            const again = await checkRoute(messageType);
                            if (!again.connected) {
                                toastWarning('WAHA is still disconnected — connect the WhatsApp session first, then try again.');
                                $('#wahaGateStatus').text(`WAHA session status: ${again.status} (checked ${new Date().toLocaleTimeString()})`);
                                return false;   // keep the modal open
                            }
                            return true;
                        }
                    },
                    { id: 'paid', label: 'Send via paid gateway', icon: 'bi-credit-card', cls: 'btn-warning' },
                    // Nothing is queued yet at this point, so this clears
                    // whatever is already waiting in the queue.
                    { id: 'reject', label: 'Reject all queued', icon: 'bi-x-octagon', cls: 'btn-outline-danger',
                      handler: () => rejectAllUnsent(null) }
                ]
            });

            if (choice === 'free') return { proceed: true, forcePaid: false };
            if (choice === 'paid') return { proceed: true, forcePaid: true };
            return { proceed: false, forcePaid: false };   // cancelled or rejected
        }

        // ══════════════════════════════════════════════════════════════
        // HELD JOBS — messages parked because WAHA went down
        // ══════════════════════════════════════════════════════════════
        // Rendered under the tab's sending log while a job has held rows.
        function renderHoldPanel(logId, jobId, held) {
            const panelId = `${logId}HoldPanel`;
            let panel = $(`#${panelId}`);

            if (!held) { panel.remove(); return; }

            if (panel.length === 0) {
                $(`#${logId}`).after(`
                    <div id="${panelId}" class="mt-3 p-3"
                         style="background:#fff7ed;border:1px solid #fed7aa;border-radius:10px;">
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-pause-circle-fill text-warning me-2"></i>
                            <span class="fw-semibold text-dark">Sending paused</span>
                            <span class="badge bg-warning text-dark ms-2" id="${panelId}Count">0 waiting</span>
                        </div>
                        <div class="text-muted mb-3" style="font-size:12.5px;">
                            WhatsApp (free) is disconnected, so these messages are on hold — none of
                            them have been sent and none are lost. Connect WAHA and resume free, or
                            release them through the paid gateway.
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-sm btn-primary" id="${panelId}Connect">
                                <i class="bi bi-box-arrow-up-right me-1"></i>Connect to WAHA
                            </button>
                            <button type="button" class="btn btn-sm btn-success" id="${panelId}Free">
                                <i class="bi bi-arrow-repeat me-1"></i>Resume free (WAHA)
                            </button>
                            <button type="button" class="btn btn-sm btn-warning" id="${panelId}Paid">
                                <i class="bi bi-credit-card me-1"></i>Send via paid gateway
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger" id="${panelId}Reject">
                                <i class="bi bi-x-octagon me-1"></i>Reject all
                            </button>
                        </div>
                    </div>`);

                $(`#${panelId}Connect`).on('click', openWahaServer);
                $(`#${panelId}Free`).on('click', () => resumeHeld(logId, jobId, 'free'));
                $(`#${panelId}Paid`).on('click', () => resumeHeld(logId, jobId, 'paid'));
                $(`#${panelId}Reject`).on('click', async () => {
                    if (await rejectAllUnsent(null)) {
                        clearActiveJob(logId);
                        setStatusLine(logId, '🚫 Rejected — the remaining messages were cancelled and will not be sent.');
                    }
                });
            }

            $(`#${panelId}Count`).text(`${held} waiting`);
        }

        // route: 'free' | 'paid'. The free endpoint refuses (409) while WAHA is
        // still disconnected, which is exactly the "connect the WAHA first"
        // case — surfaced as an alert rather than a silent no-op.
        async function resumeHeld(logId, jobId, route) {
            const panelId = `${logId}HoldPanel`;
            const btn = $(`#${panelId}${route === 'free' ? 'Free' : 'Paid'}`);
            const original = btn.html();
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Working...');

            try {
                const r = await fetch(`${API_BASE}/Sms/resume-${route}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ jobId })
                });
                const j = await r.json().catch(() => ({}));

                if (r.status === 409) {
                    // Free resume refused — WAHA is still down.
                    toastError(j.message || 'WAHA is still disconnected. Connect the WhatsApp session first.');
                    setStatusLine(logId, `⚠️ ${j.message || 'WAHA is still disconnected — connect it, then resume.'}`);
                    return;
                }
                if (!r.ok) { toastError(j.message || 'Could not resume the held messages'); return; }

                const resumed = j.resumed || 0;
                if (resumed === 0) { toastInfo('There are no held messages left to resume.'); }
                else if (route === 'free') { toastSuccess(`${resumed} message(s) resumed on the free WhatsApp route.`); }
                else { toastWarning(`${resumed} message(s) released through the paid gateway.`); }

                setStatusLine(logId, `▶️ Resumed ${resumed} held message(s) on the ${route} route.`);
                $(`#${panelId}`).remove();

                // The job is running again, so make sure the poller is live —
                // it stops itself once a job is fully held.
                if (jobId && !$(`#${logId}`).data('polling')) {
                    saveActiveJob(logId, jobId, 'Resumed');
                    startProgressPoll(jobId, logId);
                }
                // The user just reconnected WAHA, so the cached status is stale.
                refreshWahaStatus(true);
            } catch (e) {
                console.error(e);
                toastError('Network error while resuming');
            } finally {
                btn.prop('disabled', false).html(original);
            }
        }

        // Resume EVERY held message, whichever tab or session queued it —
        // reached from the "N held" badge in the queue bar. Useful after a
        // reload, or when the job was started from another machine.
        async function openGlobalResume() {
            const info = await fetch(`${API_BASE}/Sms/held`).then(r => r.ok ? r.json() : null).catch(() => null);
            const held = info ? info.held : 0;
            if (!held) { toastInfo('There are no held messages.'); refreshQueueStatus(); return; }

            const resumeAll = async (route) => {
                const r = await fetch(`${API_BASE}/Sms/resume-${route}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({})          // no jobId = every held row
                });
                const j = await r.json().catch(() => ({}));

                if (r.status === 409) {
                    toastError(j.message || 'WAHA is still disconnected. Connect the WhatsApp session first.');
                    $('#wahaGateStatus').text(`WAHA session status: ${j.freeStatus || 'disconnected'} (checked ${new Date().toLocaleTimeString()})`);
                    return false;                      // keep the modal open
                }
                if (!r.ok) { toastError(j.message || 'Could not resume'); return false; }

                const n = j.resumed || 0;
                if (route === 'free') toastSuccess(`${n} message(s) resumed on the free WhatsApp route.`);
                else toastWarning(`${n} message(s) released through the paid gateway.`);

                refreshQueueStatus();
                resumeActiveSmsJobs();
                return true;
            };

            await openWahaGate({
                message: `${held} message(s) are on hold because WhatsApp (free) is disconnected. ` +
                         'None of them have been sent.',
                status: info.freeStatus,
                cancelLabel: 'Close',
                actions: [
                    { id: 'free', label: 'Resume free (WAHA)', icon: 'bi-arrow-repeat', cls: 'btn-success',
                      handler: () => resumeAll('free') },
                    { id: 'paid', label: 'Release via paid gateway', icon: 'bi-credit-card', cls: 'btn-warning',
                      handler: () => resumeAll('paid') },
                    { id: 'reject', label: 'Reject all', icon: 'bi-x-octagon', cls: 'btn-outline-danger',
                      handler: () => rejectAllUnsent(null) }
                ]
            });
        }

        // ══════════════════════════════════════════════════════════════
        // PREVIEW LIST ("Show List")
        // ══════════════════════════════════════════════════════════════
        // POSTs the same filter payload the send would use to a /preview/*
        // endpoint and shows what would go out. onConfirm runs the real send.
        async function showPreview(url, payload, onConfirm) {
            const modalEl = document.getElementById('smsPreviewModal');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);

            $('#previewBody').html('<tr><td colspan="6" class="text-center text-muted py-4">' +
                '<span class="spinner-border spinner-border-sm me-2"></span>Building the list...</td></tr>');
            $('#previewSummary, #previewFooterNote').empty();
            $('#previewCountBadge, #previewSendCount').text('0');
            $('#previewEmpty').hide();
            $('#previewTableWrap').show();
            $('#previewSendBtn').prop('disabled', true);
            modal.show();

            let data;
            try {
                const r = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (!r.ok) {
                    const e = await r.json().catch(() => ({ message: 'Could not build the list' }));
                    toastError(e.message || 'Could not build the list');
                    modal.hide();
                    return;
                }
                data = await r.json();
            } catch (ex) {
                console.error(ex);
                toastError('Network error while building the list');
                modal.hide();
                return;
            }

            renderPreview(data);

            $('#previewSendBtn').off('click.preview').on('click.preview', () => {
                // Wait for this modal to finish closing before running the send:
                // it may open the WAHA gate modal, and two Bootstrap modals
                // overlapping leaves a stuck backdrop.
                $(modalEl).one('hidden.bs.modal', () => onConfirm());
                modal.hide();
            });
        }

        function renderPreview(data) {
            const items = data.items || [];
            const total = data.total || 0;

            $('#previewCountBadge').text(total);
            $('#previewSendCount').text(total);
            $('#previewSendBtn').prop('disabled', total === 0);

            // Summary chips: how many, how many dropped, which gateway.
            const chips = [];
            chips.push(`<span class="badge bg-primary" style="font-size:12px;">${total} message${total === 1 ? '' : 's'}</span>`);
            if (data.skippedNoPhone > 0)
                chips.push(`<span class="badge bg-secondary" style="font-size:12px;">${data.skippedNoPhone} skipped — no phone number</span>`);

            if (data.route === 'free')
                chips.push('<span class="badge bg-success" style="font-size:12px;"><i class="bi bi-whatsapp me-1"></i>Free (WAHA)</span>');
            else if (data.route === 'hold')
                chips.push(`<span class="badge bg-danger" style="font-size:12px;"><i class="bi bi-plug me-1"></i>WAHA disconnected (${data.freeStatus || 'unknown'})</span>`);
            else
                chips.push('<span class="badge bg-warning text-dark" style="font-size:12px;"><i class="bi bi-credit-card me-1"></i>Paid gateway</span>');

            const amounts = items.filter(i => i.amount != null);
            if (amounts.length)
                chips.push(`<span class="badge bg-dark" style="font-size:12px;">Total dues Rs. ${
                    amounts.reduce((s, i) => s + i.amount, 0).toLocaleString()}</span>`);

            $('#previewSummary').html(chips.join(''));

            if (data.route === 'hold') {
                $('#previewFooterNote').html(
                    '<i class="bi bi-info-circle me-1"></i>WAHA is disconnected — you will be asked how to send when you continue.');
            } else {
                $('#previewFooterNote').text('Nothing has been queued yet.');
            }

            if (total === 0) {
                $('#previewTableWrap').hide();
                $('#previewEmpty').show();
                $('#previewBody').empty();
                return;
            }

            $('#previewEmpty').hide();
            $('#previewTableWrap').show();

            const rows = items.map((it, i) => `
                <tr>
                    <td class="text-muted">${i + 1}</td>
                    <td>${escapeHtml(it.name || '-')}</td>
                    <td>${escapeHtml(it.className || '-')}</td>
                    <td><code>${escapeHtml(it.phone || '')}</code></td>
                    <td class="text-end">${it.amount != null ? 'Rs. ' + it.amount.toLocaleString() : '-'}</td>
                    <td style="max-width:420px;">
                        <div style="white-space:pre-wrap;font-size:12px;color:#475569;">${escapeHtml(it.message || '')}</div>
                    </td>
                </tr>`).join('');

            $('#previewBody').html(rows);
        }

        function escapeHtml(s) {
            return String(s ?? '').replace(/[&<>"']/g, c => (
                { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }

        // ── GENERIC SEND / PREVIEW ────────────────────────────────────
        // mode 'preview' shows the list modal (queueing nothing) and wires its
        // Send button back to mode 'send', so what the user approves is exactly
        // what goes out.
        async function sendSmsViaApi(recipients, message, messageType, logId, countId, mode) {
            if (!recipients||recipients.length===0) { toastWarning('No recipients found'); return; }
            if (!message && !recipients.every(r => r.message)) { toastWarning('Please enter a message'); return; }

            if (mode === 'preview') {
                return showPreview(
                    `${API_BASE}/Sms/preview/send`,
                    { recipients, message, messageType },
                    () => sendSmsViaApi(recipients, message, messageType, logId, countId, 'send'));
            }

            const route = await ensureRoute(messageType);
            if (!route.proceed) { toastInfo('Sending cancelled — nothing was queued.'); return; }

            const jobId = newJobId();
            logSMS(logId, countId, `📤 Sending to ${recipients.length} recipient(s)...`);
            // Persist immediately so a reload mid-send can still resume.
            saveActiveJob(logId, jobId, `Bulk SMS (${recipients.length})`);
            try {
                const r=await fetch(`${API_BASE}/Sms/send`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({recipients,message,messageType,jobId,forcePaid:route.forcePaid})});
                if(!r.ok){
                    const e=await r.json().catch(()=>({message:'Send failed'}));
                    toastError(e.message||'Failed');
                    clearActiveJob(logId);
                    return;
                }
                // Server returned 202 Accepted — send continues in background.
                toastInfo(route.forcePaid
                    ? 'Sending started in background through the paid gateway...'
                    : 'Sending started in background...');
                startProgressPoll(jobId, logId);
            } catch(ex){
                console.error(ex);
                toastError('Network error');
                clearActiveJob(logId);
            }
        }

        // ── SEND FUNCTIONS ────────────────────────────────────────────
        // Every tab exposes the same pair: previewXxxSMS() opens the list
        // modal, sendXxxSMS() queues. Both funnel through one runXxx(mode) so
        // the two can never disagree about which recipients are in scope.

        async function runStaff(mode) {
            const msg=$('#staffMessage').val(); if(!msg){toastWarning('Please enter a message');return;}
            const phone=$('#staffContactNo').val(); if(!phone){toastWarning('Please select staff or enter number');return;}
            await sendSmsViaApi([{phone,name:$('#staffTo option:selected').text()}],msg,SMS_TYPE.Staff,'staffSendingLog','staffSentCount',mode);
        }
        function sendStaffSMS()    { return runStaff('send'); }
        function previewStaffSMS() { return runStaff('preview'); }

        async function runGeneral(mode) {
            const msg=$('#generalMessage').val(); if(!msg){toastWarning('Please enter a message');return;}
            const phone=$('#generalStudentId option:selected').data('phone'); if(!phone){toastWarning('Please select a student with a phone number');return;}
            await sendSmsViaApi([{phone,name:$('#generalStudentId option:selected').text()}],msg,SMS_TYPE.General,'generalSendingLog','generalSentCount',mode);
        }
        function sendGeneralSMS()    { return runGeneral('send'); }
        function previewGeneralSMS() { return runGeneral('preview'); }

        async function runAbsent(mode) {
            const date=$('#absentDate').val(); if(!date){toastWarning('Please select a date');return;}
            const msg='Dear Parent, your child was marked absent on '+date+'. Please contact the school.';
            try {
                const resp=await fetch(`${API_BASE}/Sms/absent-students?date=${date}`);
                const students=await resp.json();
                if(!students||students.length===0){toastWarning('No absent students found for this date');return;}
                await sendSmsViaApi(students,msg,SMS_TYPE.Absent,'absentSendingLog','absentSentCount',mode);
            } catch(ex){console.error(ex); toastError('Failed to fetch absent students');}
        }
        function sendAbsentSMS()    { return runAbsent('send'); }
        function previewAbsentSMS() { return runAbsent('preview'); }

        async function runLate(mode) {
            const date=$('#lateDate').val(); if(!date){toastWarning('Please select a date');return;}
            const msg='Dear Parent, your child was marked late on '+date+'. Please ensure punctuality.';
            try {
                const resp=await fetch(`${API_BASE}/Sms/late-students?date=${date}`);
                const students=await resp.json();
                if(!students||students.length===0){toastWarning('No late students found for this date');return;}
                await sendSmsViaApi(students,msg,SMS_TYPE.Late,'lateSendingLog','lateSentCount',mode);
            } catch(ex){console.error(ex); toastError('Failed to fetch late students');}
        }
        function sendLateSMS()    { return runLate('send'); }
        function previewLateSMS() { return runLate('preview'); }

        async function runAgain(mode) {
            const date=$('#againDate').val(); if(!date){toastWarning('Please select a date');return;}
            const msg='Dear Parent, your child was marked absent on '+date+'. This is a reminder.';
            try {
                const resp=await fetch(`${API_BASE}/Sms/absent-students?date=${date}`);
                const students=await resp.json();
                if(!students||students.length===0){toastWarning('No absent students found for this date');return;}
                await sendSmsViaApi(students,msg,SMS_TYPE.Absent,'againSendingLog','againSentCount',mode);
            } catch(ex){console.error(ex); toastError('Failed to fetch absent students');}
        }
        function sendAgainSMS()    { return runAgain('send'); }
        function previewAgainSMS() { return runAgain('preview'); }

        // ── FEE SMS ───────────────────────────────────────────────────
        // tillDate picks WHO is reminded (students still carrying a due dated
        // on or before it); each of them is then billed for ALL their pending
        // dues up to today — so a March/April defaulter also gets May onwards
        // in the same message.
        function buildFeePayload() {
            const dueDate=$('#feeDueDate').val();
            if(!dueDate){toastWarning('Please select a due date');return null;}

            const feeChoice=$('input[name="feeChoose"]:checked').val();
            const classId   = (feeChoice==='class'||feeChoice==='section'||feeChoice==='student') ? ($('#feeClassId').val()||null)   : null;
            const sectionId = (feeChoice==='section'||feeChoice==='student') ? ($('#feeSectionId').val()||null) : null;
            const studentId = feeChoice==='student' ? ($('#feeStudentId').val()||null) : null;
            const tillDate  = $('#feeTillDate').val() || null;

            return {
                dueDate:   dueDate,
                tillDate:  tillDate,
                studentId: studentId ? parseInt(studentId) : null,
                classId:   classId   ? parseInt(classId)   : null,
                sectionId: sectionId ? parseInt(sectionId) : null,
                sessionId: null
            };
        }

        async function runFee(mode) {
            const payload = buildFeePayload();
            if (!payload) return;

            if (mode === 'preview') {
                return showPreview(`${API_BASE}/Sms/preview/fee-reminder`, payload, () => runFee('send'));
            }

            const route = await ensureRoute(SMS_TYPE.Fee);
            if (!route.proceed) { toastInfo('Sending cancelled — nothing was queued.'); return; }

            logSMS('feeSendingLog','feeSentCount','📤 Fetching pending fee data...');

            const jobId = newJobId();
            saveActiveJob('feeSendingLog', jobId, 'Fee Reminder');
            try {
                const response=await fetch(`${API_BASE}/Sms/fee-reminder`,{
                    method:'POST',
                    headers:{'Content-Type':'application/json'},
                    body:JSON.stringify({ ...payload, jobId, forcePaid: route.forcePaid })
                });
                if(!response.ok){
                    const e=await response.json().catch(()=>({message:'Failed'}));
                    toastError(e.message||'Failed to send fee SMS');
                    clearActiveJob('feeSendingLog');
                    return;
                }
                toastInfo(route.forcePaid
                    ? 'Fee reminders queued through the paid gateway...'
                    : 'Fee reminder sending started in background...');
                startProgressPoll(jobId, 'feeSendingLog');
            } catch(ex){
                console.error(ex);
                toastError('Network error sending fee SMS');
                clearActiveJob('feeSendingLog');
            }
        }
        function sendFeeSMS()    { return runFee('send'); }
        function previewFeeSMS() { return runFee('preview'); }

        // Result: sends each matched student's result as a WhatsApp TEXT summary.
        // The API resolves recipients (Father→Guardian→Student) and the background
        // queue composes + sends each result text (works without WAHA Plus).
        async function runResult(mode) {
            const examId = $('#resultExamId').val();
            if (!examId) { toastWarning('Please select an exam'); return; }

            const scope = $('input[name="resultChoose"]:checked').val(); // student|section|class|all
            const classId   = $('#resultClassId').val();
            const sectionId = $('#resultSectionId').val();
            const studentId = $('#resultStudentId').val();

            if ((scope === 'class' || scope === 'section' || scope === 'student') && !classId) { toastWarning('Please select a Class'); return; }
            if ((scope === 'section' || scope === 'student') && !sectionId) { toastWarning('Please select a Section'); return; }
            if (scope === 'student' && !studentId) { toastWarning('Please select a Student'); return; }

            const logId = 'resultSendingLog', countId = 'resultSentCount';
            const payload = {
                examId: parseInt(examId),
                examName: $('#resultExamId option:selected').text(),
                scope,
                classId:   classId   ? parseInt(classId)   : null,
                sectionId: sectionId ? parseInt(sectionId) : null,
                studentId: studentId ? parseInt(studentId) : null,
                message: $('#resultMessage').val() || ''
            };

            if (mode === 'preview') {
                return showPreview(`${API_BASE}/Sms/preview/result`, payload, () => runResult('send'));
            }

            const route = await ensureRoute(SMS_TYPE.Result);
            if (!route.proceed) { toastInfo('Sending cancelled — nothing was queued.'); return; }

            const jobId = newJobId();
            logSMS(logId, countId, `📤 Preparing result texts (${scope})...`);
            saveActiveJob(logId, jobId, `Result Text (${scope})`);
            try {
                const r = await fetch(`${API_BASE}/Sms/result`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ...payload, jobId, forcePaid: route.forcePaid })
                });
                if (!r.ok) {
                    const e = await r.json().catch(() => ({ message: 'Send failed' }));
                    toastError(e.message || 'Failed');
                    clearActiveJob(logId);
                    return;
                }
                toastInfo('Results are being sent in background...');
                startProgressPoll(jobId, logId);
            } catch (ex) {
                console.error(ex);
                toastError('Network error');
                clearActiveJob(logId);
            }
        }
        function sendResultSMS()    { return runResult('send'); }
        function previewResultSMS() { return runResult('preview'); }

        async function runFromTo(mode) {
            const f=$('#fromtoFromDate').val(); const t=$('#fromtoToDate').val();
            if(!f||!t){toastWarning('Please select date range');return;}
            const msg=$('#fromtoMessage').val()||'Dear Parent, attendance notification for period '+f+' to '+t+'.';
            const phone=$('#fromtoStudentId option:selected').data('phone'); if(!phone){toastWarning('Please select a student with a phone number');return;}
            await sendSmsViaApi([{phone,name:$('#fromtoStudentId option:selected').text()}],msg,SMS_TYPE.FromTo,'fromtoSendingLog','fromtoSentCount',mode);
        }
        function sendFromToSMS()    { return runFromTo('send'); }
        function previewFromToSMS() { return runFromTo('preview'); }

        // Result Card: generates a PDF per matched student and sends it as a
        // WhatsApp document. The API resolves recipients (Father→Guardian→Student)
        // and the background queue builds+sends each PDF (throttled).
        async function runRcard(mode) {
            const examId = $('#rcardExamId').val();
            if (!examId) { toastWarning('Please select an exam'); return; }

            const scope = $('input[name="rcardChoose"]:checked').val(); // student|section|class|all
            const classId   = $('#rcardClassId').val();
            const sectionId = $('#rcardSectionId').val();
            const studentId = $('#rcardStudentId').val();

            if ((scope === 'class' || scope === 'section' || scope === 'student') && !classId) { toastWarning('Please select a Class'); return; }
            if ((scope === 'section' || scope === 'student') && !sectionId) { toastWarning('Please select a Section'); return; }
            if (scope === 'student' && !studentId) { toastWarning('Please select a Student'); return; }

            const logId = 'rcardSendingLog', countId = 'rcardSentCount';
            const payload = {
                examId: parseInt(examId),
                examName: $('#rcardExamId option:selected').text(),
                scope,
                classId:   classId   ? parseInt(classId)   : null,
                sectionId: sectionId ? parseInt(sectionId) : null,
                studentId: studentId ? parseInt(studentId) : null,
                message: $('#rcardMessage').val() || ''
            };

            if (mode === 'preview') {
                return showPreview(`${API_BASE}/Sms/preview/rcard`, payload, () => runRcard('send'));
            }

            const route = await ensureRoute(SMS_TYPE.Rcard);
            if (!route.proceed) { toastInfo('Sending cancelled — nothing was queued.'); return; }

            const jobId = newJobId();
            logSMS(logId, countId, `📤 Preparing result-card PDFs (${scope})...`);
            saveActiveJob(logId, jobId, `Result Cards (${scope})`);
            try {
                const r = await fetch(`${API_BASE}/Sms/rcard`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ...payload, jobId, forcePaid: route.forcePaid })
                });
                if (!r.ok) {
                    const e = await r.json().catch(() => ({ message: 'Send failed' }));
                    toastError(e.message || 'Failed');
                    clearActiveJob(logId);
                    return;
                }
                toastInfo('Result cards are being generated & sent in background...');
                startProgressPoll(jobId, logId);
            } catch (ex) {
                console.error(ex);
                toastError('Network error');
                clearActiveJob(logId);
            }
        }
        function sendRcardSMS()    { return runRcard('send'); }
        function previewRcardSMS() { return runRcard('preview'); }

        // ── EXCEL SMS ─────────────────────────────────────────────────
        function previewExcelFile() {
            const fi=$('#excelFile')[0]; if(!fi.files||!fi.files[0]) return;
            const reader=new FileReader();
            reader.onload=function(e){
                try {
                    const wb=XLSX.read(new Uint8Array(e.target.result),{type:'array'});
                    const sh=wb.Sheets[wb.SheetNames[0]];
                    excelParsedData=XLSX.utils.sheet_to_json(sh,{defval:''});
                    excelHeaders=excelParsedData.length>0?Object.keys(excelParsedData[0]):[];
                    if(!excelParsedData.length){toastWarning('Excel file is empty');clearExcelForm();return;}
                    $('#excelFileName').text(fi.files[0].name);
                    $('#excelRowCount').text(excelParsedData.length+' rows');
                    $('#excelPreviewSection').show();
                    const ps=$('#excelPhoneColumn'),ms=$('#excelMessageColumn');
                    ps.find('option:not(:first)').remove(); ms.find('option:not(:first)').remove();
                    excelHeaders.forEach(c=>{ps.append(`<option value="${c}">${c}</option>`);ms.append(`<option value="${c}">${c}</option>`);});
                    autoSelectColumn(ps,['phone','mobile','contact','number','mobileno']);
                    autoSelectColumn(ms,['message','msg','text','sms','content']);
                    $('#excelColumnsSection').show();
                    renderExcelPreviewTable();
                    toastSuccess(`File loaded: ${excelParsedData.length} rows`);
                } catch(err){console.error(err); toastError('Failed to read Excel file.');}
            };
            reader.readAsArrayBuffer(fi.files[0]);
        }

        function autoSelectColumn(sel,kw){sel.find('option').each(function(){if(kw.some(k=>$(this).val().toLowerCase().replace(/\s/g,'').includes(k))){sel.val($(this).val());return false;}});}

        function renderExcelPreviewTable(){
            $('#excelPreviewTable').remove();
            if(!excelParsedData.length) return;
            const rows=excelParsedData.slice(0,5);
            let h=`<div id="excelPreviewTable" class="mt-3"><label class="form-label fw-semibold">Preview (first 5 rows)</label><div class="table-responsive"><table class="table table-sm table-bordered" style="font-size:12px;"><thead style="background:#e2e8f0;"><tr>`;
            excelHeaders.forEach(x=>h+=`<th>${x}</th>`);
            h+=`</tr></thead><tbody>`;
            rows.forEach(r=>{h+='<tr>';excelHeaders.forEach(x=>{h+=`<td>${r[x]??''}</td>`;});h+='</tr>';});
            h+=`</tbody></table></div></div>`;
            $('#excelColumnsSection').after(h);
        }

        // Turns the parsed sheet into recipients, reporting the rows it had to
        // drop. Shared by the preview and the send so both see the same list.
        function buildExcelRecipients(){
            if(!$('#excelFile').val()){toastWarning('Please upload an Excel file');return null;}
            const pc=$('#excelPhoneColumn').val(); const mc=$('#excelMessageColumn').val();
            if(!pc){toastWarning('Please select Phone column');return null;}
            if(!mc){toastWarning('Please select Message column');return null;}
            if(!excelParsedData.length){toastWarning('No data found');return null;}
            const recipients=[]; const skipped=[];
            excelParsedData.forEach((row,i)=>{
                const rp=String(row[pc]??'').trim(); const rm=String(row[mc]??'').trim();
                const nm=String(row['Name']??row['name']??row['StudentName']??`Row ${i+2}`).trim();
                if(!rp){skipped.push(`Row ${i+2}: empty phone`);return;}
                if(!rm){skipped.push(`Row ${i+2}: empty message`);return;}
                const phone=normalizePhone(rp);
                if(!phone){skipped.push(`Row ${i+2}: invalid phone "${rp}"`);return;}
                recipients.push({phone,name:nm,message:rm});
            });
            if(!recipients.length){toastWarning('No valid recipients found');return null;}
            return { recipients, skipped };
        }

        async function runExcel(mode){
            const built = buildExcelRecipients();
            if (!built) return;
            const { recipients, skipped } = built;

            if (mode === 'preview') {
                return showPreview(
                    `${API_BASE}/Sms/preview/send`,
                    { recipients, message: '', messageType: SMS_TYPE.Excel },
                    () => runExcel('send'));
            }

            const route = await ensureRoute(SMS_TYPE.Excel);
            if (!route.proceed) { toastInfo('Sending cancelled — nothing was queued.'); return; }

            if(skipped.length) logSMS('excelSendingLog','excelSentCount',`⚠️ Skipped ${skipped.length} rows`);
            logSMS('excelSendingLog','excelSentCount',`📤 Sending to ${recipients.length} recipients...`);
            const jobId = newJobId();
            saveActiveJob('excelSendingLog', jobId, `Excel SMS (${recipients.length})`);
            try {
                const r=await fetch(`${API_BASE}/Sms/send`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({recipients,message:'',messageType:SMS_TYPE.Excel,jobId,forcePaid:route.forcePaid})});
                if(!r.ok){
                    const e=await r.json().catch(()=>({message:'Failed'}));
                    toastError(e.message||'Failed');
                    clearActiveJob('excelSendingLog');
                    return;
                }
                toastInfo('Excel SMS sending started in background...');
                startProgressPoll(jobId, 'excelSendingLog');
            } catch(ex){
                console.error(ex);
                toastError('Network error');
                clearActiveJob('excelSendingLog');
            }
        }
        function sendExcelSMS()    { return runExcel('send'); }
        function previewExcelSMS() { return runExcel('preview'); }

        function normalizePhone(raw){
            let d=raw.replace(/\D/g,''); if(!d) return null;
            if(d.startsWith('92')&&d.length===12) return d;
            if(d.startsWith('0')&&d.length===11) return '92'+d.substring(1);
            if(d.length===10&&d.startsWith('3')) return '92'+d;
            return d.length>=10?d:null;
        }

        function clearExcelForm(){$('#excelFile').val('');$('#excelPreviewSection,#excelColumnsSection').hide();$('#excelPreviewTable').remove();$('#excelSmsUrdu').prop('checked',false);$('#excelSendingLog').val('');$('#excelSentCount').text('0');excelParsedData=[];excelHeaders=[];}

        // ── CLEAR FORMS ───────────────────────────────────────────────
        function clearStaffForm()   { $('#staffType,#staffTo,#staffContactNo,#staffMessage').val(''); $('#staffCharCount').text('0'); $('#staffSmsUrdu').prop('checked',false); }
        function clearGeneralForm() { $('#generalClassId,#generalSectionId,#generalStudentId,#generalMessage').val(''); $('#generalCharCount').text('0'); $('#generalSmsUrdu').prop('checked',false); }
        function clearFeeForm()     {
            $('#feeClassId,#feeSectionId,#feeStudentId,#feeTillDate').val('');
            const due=new Date(); due.setDate(due.getDate()+10);
            $('#feeDueDate').val(toInputDate(due));
            $('#feeSmsUrdu').prop('checked',false);
            $('input[name="feeChoose"][value="student"]').prop('checked',true); toggleFeeFields();
        }
        function clearResultForm()  { $('#resultExamId,#resultClassId,#resultSectionId,#resultStudentId,#resultMessage').val(''); $('#resultCharCount').text('0'); $('#resultSmsUrdu').prop('checked',false); }
        function clearFromToForm()  { $('#fromtoFromDate,#fromtoToDate,#fromtoFilterType,#fromtoClassId,#fromtoSectionId,#fromtoStudentId,#fromtoMessage').val(''); $('#fromtoCharCount').text('0'); $('#fromtoSmsUrdu').prop('checked',false); }
        function clearRcardForm()   { $('#rcardExamId,#rcardClassId,#rcardSectionId,#rcardStudentId,#rcardMessage').val(''); $('#rcardIncludeLink').prop('checked',false); $('#rcardCharCount').text('0'); $('#rcardSmsUrdu').prop('checked',false); }

        function filterHistory()  { toastInfo('Filtering SMS history...'); }
        function refreshHistory() { toastInfo('Refreshing SMS history...'); }
        function exportHistory()  { toastInfo('Exporting SMS history...'); }
    </script>
}
