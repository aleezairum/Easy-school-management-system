@{
    ViewData["Title"] = "Attendance";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@section Styles {
<style>
    :root {
        --as-green: #008649;
        --as-green-dark: #006c3a;
        --as-ink: #1e293b;
        --as-muted: #64748b;
        --as-line: #e2e8f0;
        --as-bg: #f8fafc;
    }

    /* ---------- Page header / toolbar ---------- */
    .page-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 20px; }
    .page-toolbar .pt-title { display: flex; align-items: center; gap: 14px; }
    .page-toolbar .pt-icon { width: 46px; height: 46px; border-radius: 12px; flex: 0 0 46px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, var(--as-green), var(--as-green-dark)); color: #fff; font-size: 22px; box-shadow: 0 6px 16px rgba(0,134,73,0.30); }
    .page-toolbar h4 { margin: 0; font-weight: 700; color: var(--as-ink); font-size: 20px; }
    .page-toolbar .pt-sub { margin: 2px 0 0; font-size: 13px; color: var(--as-muted); }
    .page-toolbar .pt-actions { display: flex; gap: 10px; flex-wrap: wrap; }

    /* ---------- Buttons ---------- */
    .btn-as-primary { background: var(--as-green); border: none; color: #fff; border-radius: 10px; padding: 8px 16px; font-weight: 600; font-size: 14px; white-space: nowrap; display: inline-flex; align-items: center; }
    .btn-as-primary:hover { background: var(--as-green-dark); color: #fff; }
    .btn-as-ghost { border: 1.5px solid #cbd5e1; background: #fff; color: #334155; border-radius: 10px; padding: 8px 16px; font-weight: 600; font-size: 14px; white-space: nowrap; box-shadow: 0 1px 2px rgba(15,23,42,0.06); text-decoration: none; display: inline-flex; align-items: center; }
    .btn-as-ghost:hover { border-color: var(--as-green); color: var(--as-green); background: #f0fdf4; }

    /* ---------- Cards / sections ---------- */
    .card { border: 1px solid var(--as-line); border-radius: 16px; box-shadow: 0 4px 24px rgba(15,23,42,0.05); }
    .filter-card { background: var(--as-bg); border: 1px solid var(--as-line); border-radius: 14px; padding: 18px 20px; margin-bottom: 22px; }
    .section-label { font-size: 12px; font-weight: 700; color: var(--as-muted); text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 14px; display: flex; align-items: center; gap: 8px; }
    .form-label { font-size: 13px; font-weight: 600; color: #475569; margin-bottom: 5px; }
    .form-select, .form-control { border-radius: 10px; border: 1.5px solid var(--as-line); font-size: 14px; padding: 9px 12px; }
    .form-select:focus, .form-control:focus { border-color: var(--as-green); box-shadow: 0 0 0 3px rgba(0,134,73,0.12); }
    .input-icon { position: relative; }
    .input-icon > i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 15px; }
    .input-icon > .form-control { padding-left: 36px; }

    /* ---------- Summary stat chips ---------- */
    .stats-bar { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
    .stat-chip { flex: 1 1 120px; min-width: 110px; border-radius: 14px; padding: 14px 16px; border: 1px solid var(--as-line); background: #fff; display: flex; align-items: center; gap: 12px; transition: transform .15s, box-shadow .15s; }
    .stat-chip:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(15,23,42,0.08); }
    .stat-chip .sc-dot { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 18px; flex: 0 0 38px; }
    .stat-chip .sc-meta { line-height: 1.1; }
    .stat-chip .sc-num { font-size: 22px; font-weight: 700; color: var(--as-ink); }
    .stat-chip .sc-label { font-size: 12px; font-weight: 600; color: var(--as-muted); text-transform: uppercase; letter-spacing: .4px; }
    .sc-total .sc-dot { background: #eef2ff; color: #4f46e5; }
    .sc-present .sc-dot { background: #dcfce7; color: #16a34a; }
    .sc-absent  .sc-dot { background: #fee2e2; color: #dc2626; }
    .sc-late    .sc-dot { background: #ffedd5; color: #ea580c; }
    .sc-leave   .sc-dot { background: #dbeafe; color: #2563eb; }

    /* ---------- Table ---------- */
    .grid-section-title { font-size: 12px; font-weight: 700; color: var(--as-muted); text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 14px; display: flex; align-items: center; gap: 8px; }
    .count-pill { background: #eef2ff; color: #4338ca; border-radius: 999px; padding: 1px 10px; font-size: 12px; font-weight: 700; }
    .table-responsive { border: 1px solid var(--as-line); border-radius: 14px; overflow: hidden; }
    #attendanceTable { margin: 0; }
    #attendanceTable thead th { background: #f1f5f9; color: #334155; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .4px; padding: 12px 14px; border-bottom: 2px solid var(--as-line); white-space: nowrap; position: sticky; top: 0; z-index: 2; }
    #attendanceTable tbody td { padding: 10px 14px; vertical-align: middle; font-size: 14px; color: var(--as-ink); border-top: 1px solid #eef2f6; }
    #attendanceTable tbody tr:hover td { background: #f8fafc; }
    .roll-badge { display: inline-block; min-width: 30px; text-align: center; background: #eef2ff; color: #4338ca; font-weight: 700; border-radius: 8px; padding: 2px 8px; font-size: 13px; }
    .student-name { font-weight: 600; }

    /* ---------- Status badges ---------- */
    .status-badge { display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 999px; font-size: 12px; font-weight: 700; }
    .status-present { background: #dcfce7; color: #16a34a; }
    .status-absent  { background: #fee2e2; color: #dc2626; }
    .status-late    { background: #ffedd5; color: #ea580c; }
    .status-leave   { background: #dbeafe; color: #2563eb; }

    .btn-row-delete { border: 1.5px solid #fecaca; background: #fff; color: #dc2626; border-radius: 8px; padding: 5px 10px; font-size: 13px; line-height: 1; }
    .btn-row-delete:hover { background: #dc2626; color: #fff; border-color: #dc2626; }

    .empty-state { text-align: center; padding: 48px 20px; color: var(--as-muted); }
    .empty-state i { font-size: 42px; color: #cbd5e1; display: block; margin-bottom: 12px; }
    .empty-state .es-title { font-weight: 600; color: #475569; margin-bottom: 4px; }

    /* Loading overlay */
    .loading-overlay { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(255,255,255,0.8); display: flex; align-items: center; justify-content: center; z-index: 100; border-radius: 16px; }
    .spinner-border { width: 3rem; height: 3rem; border-width: 0.3rem; }
</style>
}

<div class="container-fluid">
    <!-- Alert Messages -->
    <div id="alertContainer"></div>

    <!-- Page toolbar -->
    <div class="page-toolbar">
        <div class="pt-title">
            <div class="pt-icon"><i class="bi bi-card-checklist"></i></div>
            <div>
                <h4>Attendance Records</h4>
                <p class="pt-sub">View, filter &amp; manage marked attendance</p>
            </div>
        </div>
        <div class="pt-actions">
            <a href="/attendance/bulk" class="btn-as-primary">
                <i class="bi bi-people me-1"></i> Bulk Entry
            </a>
        </div>
    </div>

    <!-- Attendance Card -->
    <div class="card">
        <div class="card-body position-relative">
            <div id="loadingOverlay" class="loading-overlay" style="display: none;">
                <div class="spinner-border text-success" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>

            <!-- Filter Card -->
            <div class="filter-card">
                <div class="section-label"><i class="bi bi-funnel-fill"></i> Filter Attendance</div>
                <div class="row g-3 align-items-end">
                    <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                        <label for="filterSession" class="form-label">Session</label>
                        <select class="form-select" id="filterSession">
                            <option value="">All Sessions</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                        <label for="filterClass" class="form-label">Class</label>
                        <select class="form-select" id="filterClass" onchange="loadSections()">
                            <option value="">All Classes</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                        <label for="filterSection" class="form-label">Section</label>
                        <select class="form-select" id="filterSection">
                            <option value="">All Sections</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                        <label for="filterDate" class="form-label">Date</label>
                        <input type="date" class="form-control" id="filterDate" />
                    </div>
                    <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                        <label for="filterStatus" class="form-label">Status</label>
                        <select class="form-select" id="filterStatus" onchange="applyFilters()">
                            <option value="">All Status</option>
                            <option value="Present">Present</option>
                            <option value="Absent">Absent</option>
                            <option value="Late">Late</option>
                            <option value="Leave">Leave</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                        <label class="form-label">&nbsp;</label>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn-as-primary" onclick="loadAttendance()">
                                <i class="bi bi-search me-1"></i> Search
                            </button>
                            <button type="button" class="btn-as-ghost" onclick="clearFilters()">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <hr style="border-color:var(--as-line); margin:18px 0 16px;">

                <div class="row g-3 align-items-end">
                    <div class="col-lg-5 col-md-7 col-sm-12 col-12">
                        <label for="searchBox" class="form-label">Quick search (loaded records)</label>
                        <div class="input-icon">
                            <i class="bi bi-search"></i>
                            <input type="text" class="form-control" id="searchBox" oninput="applyFilters()"
                                   placeholder="Roll #, Student Name or Section...">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Summary stat chips -->
            <div class="stats-bar" id="statsBar" style="display:none;">
                <div class="stat-chip sc-total">
                    <div class="sc-dot"><i class="bi bi-people-fill"></i></div>
                    <div class="sc-meta"><div class="sc-num" id="statTotal">0</div><div class="sc-label">Total</div></div>
                </div>
                <div class="stat-chip sc-present">
                    <div class="sc-dot"><i class="bi bi-check-circle-fill"></i></div>
                    <div class="sc-meta"><div class="sc-num" id="statPresent">0</div><div class="sc-label">Present</div></div>
                </div>
                <div class="stat-chip sc-absent">
                    <div class="sc-dot"><i class="bi bi-x-circle-fill"></i></div>
                    <div class="sc-meta"><div class="sc-num" id="statAbsent">0</div><div class="sc-label">Absent</div></div>
                </div>
                <div class="stat-chip sc-late">
                    <div class="sc-dot"><i class="bi bi-alarm-fill"></i></div>
                    <div class="sc-meta"><div class="sc-num" id="statLate">0</div><div class="sc-label">Late</div></div>
                </div>
                <div class="stat-chip sc-leave">
                    <div class="sc-dot"><i class="bi bi-clock-fill"></i></div>
                    <div class="sc-meta"><div class="sc-num" id="statLeave">0</div><div class="sc-label">Leave</div></div>
                </div>
            </div>

            <!-- Grid Section -->
            <div class="grid-section">
                <div class="grid-section-title">
                    <i class="bi bi-table"></i> Attendance Records
                    <span class="count-pill" id="recordCount" style="display:none;">0</span>
                </div>
                <div class="table-responsive">
                    <table class="table" id="attendanceTable">
                        <thead>
                            <tr>
                                <th style="width: 60px;">Sr#</th>
                                <th style="width: 80px;">Roll #</th>
                                <th>Student Name</th>
                                <th>Class</th>
                                <th>Section</th>
                                <th>Date</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Time In</th>
                                <th class="text-center">Time Out</th>
                                <th class="text-center" style="width: 90px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="attendanceBody">
                            <tr>
                                <td colspan="10">
                                    <div class="empty-state">
                                        <i class="bi bi-clipboard"></i>
                                        <div class="es-title">No records loaded</div>
                                        <div>Set the filters above and click <strong>Search</strong>.</div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        let allRecords = [];

        $(document).ready(function () {
            loadDropdowns();
            $('#filterDate').val(new Date().toISOString().split('T')[0]);
        });

        async function loadDropdowns() {
            try {
                const [sessions, classes] = await Promise.all([
                    fetch(`${API_BASE}/AcademicSessionYear`).then(r => r.json()).catch(() => []),
                    fetch(`${API_BASE}/class`).then(r => r.json()).catch(() => [])
                ]);

                const filterSession = $('#filterSession');
                sessions.forEach(item => {
                    filterSession.append(`<option value="${item.vid}">${item.vName}</option>`);
                });

                const filterClass = $('#filterClass');
                classes.forEach(item => {
                    filterClass.append(`<option value="${item.vid}">${item.vName}</option>`);
                });

            } catch (error) {
                showAlert('Error loading dropdowns', 'danger');
            }
        }

        async function loadSections() {
            const classId = $('#filterClass').val();
            const sectionSelect = $('#filterSection');
            sectionSelect.find('option:not(:first)').remove();
            sectionSelect.prop('disabled', true);

            if (!classId) return;

            try {
                const response = await fetch(`${API_BASE}/section/byClass/${classId}`);
                if (response.ok) {
                    const sections = await response.json();
                    sections.forEach(s => {
                        sectionSelect.append(`<option value="${s.vid}">${s.vName}</option>`);
                    });
                    sectionSelect.prop('disabled', false);
                }
            } catch (error) {
                toastError('Failed to load sections');
            }
        }

        async function loadAttendance() {
            showLoading();
            try {
                // Build query string from filters — matches StdAttendenceFilterDto
                const params = new URLSearchParams();

                const sessionId  = $('#filterSession').val();
                const sectionId  = $('#filterSection').val();
                const dateVal    = $('#filterDate').val();

                if (sessionId)  params.append('SessionID', sessionId);
                if (sectionId)  params.append('SectionID', sectionId);
                if (dateVal) {
                    params.append('DateFrom', dateVal);
                    params.append('DateTo',   dateVal);
                }

                const url = `${API_BASE}/StdAttendence?${params.toString()}`;
                const response = await fetch(url);

                if (response.ok) {
                    // Keep the full loaded set; Status + Quick search are applied live (client-side)
                    allRecords = await response.json();
                    renderList(allRecords);
                } else {
                    showAlert('Failed to load attendance records', 'danger');
                }
            } catch (error) {
                showAlert('Error: ' + error.message, 'danger');
            } finally {
                hideLoading();
            }
        }

        function renderList(items) {
            const tbody = $('#attendanceBody');
            tbody.empty();

            const countPill = $('#recordCount');
            if (items.length === 0) {
                countPill.hide();
                $('#statsBar').hide();
                tbody.html(`
                    <tr><td colspan="10">
                        <div class="empty-state">
                            <i class="bi bi-search"></i>
                            <div class="es-title">No attendance records found</div>
                            <div>Try adjusting the filters above.</div>
                        </div>
                    </td></tr>`);
                return;
            }

            countPill.text(items.length).show();

            items.forEach((item, index) => {
                const status = statusOf(item);
                const statusClass = 'status-' + status.toLowerCase();

                const searchText = `${item.studentID || ''} ${item.studentName || ''} ${item.sectionName || ''} ${item.sessionName || ''}`.replace(/"/g, '');
                const row = `
                    <tr data-id="${item.vid}" data-search="${searchText}" data-status="${status}">
                        <td>${index + 1}</td>
                        <td><span class="roll-badge">${item.studentID || '-'}</span></td>
                        <td class="student-name">${item.studentName || '-'}</td>
                        <td>${item.sessionName || '-'}</td>
                        <td>${item.sectionName || '-'}</td>
                        <td>${formatDate(item.vDate)}</td>
                        <td class="text-center">
                            <span class="status-badge ${statusClass}">${status}</span>
                        </td>
                        <td class="text-center">${item.isLate ? '<i class="bi bi-check-circle-fill text-warning"></i>' : '-'}</td>
                        <td class="text-center">${item.isAgain ? '<i class="bi bi-check-circle-fill text-info"></i>' : '-'}</td>
                        <td class="text-center">
                            <button type="button" class="btn-row-delete"
                                onclick="deleteAttendance(${item.vid})" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                `;
                tbody.append(row);
            });

            updateCounts();
            applyFilters();
        }

        // Map a record to its display status: Present / Late / Absent / Leave
        // (Attendence: 1 = Present, 0 = Absent, 2 = Leave; IsLate marks a late Present)
        function statusOf(item) {
            if (item.attendence === 2) return 'Leave';
            if (item.attendence === 1 && item.isLate) return 'Late';
            if (item.attendence === 1) return 'Present';
            return 'Absent';
        }

        // Status breakdown chips — computed from the full loaded set
        function updateCounts() {
            if (!allRecords || allRecords.length === 0) { $('#statsBar').hide(); return; }
            let present = 0, absent = 0, late = 0, leave = 0;
            allRecords.forEach(r => {
                const s = statusOf(r);
                if (s === 'Present') present++;
                else if (s === 'Absent') absent++;
                else if (s === 'Late') late++;
                else if (s === 'Leave') leave++;
            });
            $('#statTotal').text(allRecords.length);
            $('#statPresent').text(present);
            $('#statAbsent').text(absent);
            $('#statLate').text(late);
            $('#statLeave').text(leave);
            $('#statsBar').css('display', 'flex');
        }

        // Live filter over loaded rows: Status dropdown + Quick search (Roll #, Name, Section, Session)
        function applyFilters() {
            const q = ($('#searchBox').val() || '').toLowerCase().trim();
            const status = $('#filterStatus').val();
            let visible = 0;
            $('#attendanceBody tr').each(function () {
                const $row = $(this);
                const search = $row.attr('data-search');
                if (search === undefined) return; // skip placeholder rows
                const matchSearch = !q || String(search).toLowerCase().indexOf(q) !== -1;
                const matchStatus = !status || $row.attr('data-status') === status;
                const show = matchSearch && matchStatus;
                $row.toggle(show);
                if (show) visible++;
            });
            $('#recordCount').text(visible).show();
        }

        function formatDate(dateString) {
            if (!dateString) return '-';
            const date = new Date(dateString);
            return date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
        }

        async function deleteAttendance(id) {
            const confirmed = await confirmDelete({
                title: 'Delete record?',
                html:  'This attendance record will be permanently deleted.<br><span style="color:#94a3b8;font-size:13px;">This action cannot be undone.</span>'
            });

            if (!confirmed) return;

            showLoading();
            try {
                const response = await fetch(`${API_BASE}/StdAttendence/${id}`, {
                    method: 'DELETE'
                });

                if (response.ok) {
                    showAlert('Deleted successfully!', 'success');
                    await loadAttendance();
                } else {
                    showAlert('Failed to delete', 'danger');
                }
            } catch (error) {
                showAlert('Error: ' + error.message, 'danger');
            } finally {
                hideLoading();
            }
        }

        function clearFilters() {
            $('#filterSession').val('');
            $('#filterClass').val('');
            $('#filterSection').val('').prop('disabled', true);
            $('#filterDate').val(new Date().toISOString().split('T')[0]);
            $('#filterStatus').val('');
            $('#searchBox').val('');
            loadAttendance();
        }

        function showLoading() { $('#loadingOverlay').show(); }
        function hideLoading() { $('#loadingOverlay').hide(); }

        function showAlert(message, type) {
            if (type === 'success') toastSuccess(message);
            else if (type === 'danger') toastError(message);
            else if (type === 'warning') toastWarning(message);
            else toastInfo(message);
        }
    </script>
}
