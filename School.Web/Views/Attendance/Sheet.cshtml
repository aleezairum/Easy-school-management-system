@{
    ViewData["Title"] = "Attendance Sheet";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@section Styles {
<style>
    :root {
        --as-green: #008649;
        --as-green-dark: #006c3a;
        --as-ink: #1e293b;
        --as-muted: #64748b;
        --as-line: #e2e8f0;
        --as-bg: #f8fafc;
    }

    /* ---------- Page header / toolbar ---------- */
    .page-toolbar {
        display: flex; align-items: center; justify-content: space-between;
        gap: 16px; flex-wrap: wrap; margin-bottom: 20px;
    }
    .page-toolbar .pt-title { display: flex; align-items: center; gap: 14px; }
    .page-toolbar .pt-icon {
        width: 46px; height: 46px; border-radius: 12px; flex: 0 0 46px;
        display: flex; align-items: center; justify-content: center;
        background: linear-gradient(135deg, var(--as-green), var(--as-green-dark));
        color: #fff; font-size: 22px; box-shadow: 0 6px 16px rgba(0,134,73,0.30);
    }
    .page-toolbar h4 { margin: 0; font-weight: 700; color: var(--as-ink); font-size: 20px; }
    .page-toolbar .pt-sub { margin: 2px 0 0; font-size: 13px; color: var(--as-muted); }
    .page-toolbar .pt-actions { display: flex; gap: 10px; flex-wrap: wrap; }

    /* ---------- Buttons ---------- */
    .btn-as-primary { background: var(--as-green); border: none; color: #fff; border-radius: 10px; padding: 8px 16px; font-weight: 600; font-size: 14px; white-space: nowrap; }
    .btn-as-primary:hover { background: var(--as-green-dark); color: #fff; }
    .btn-as-ghost { border: 1.5px solid #cbd5e1; background: #fff; color: #334155; border-radius: 10px; padding: 8px 16px; font-weight: 600; font-size: 14px; white-space: nowrap; box-shadow: 0 1px 2px rgba(15,23,42,0.06); }
    .btn-as-ghost:hover { border-color: var(--as-green); color: var(--as-green); background: #f0fdf4; }

    /* Toolbar print/summer buttons — make them clearly visible */
    .pt-actions .btn-as-ghost { border-color: var(--as-green); color: var(--as-green); background: #f0fdf4; }
    .pt-actions .btn-as-ghost:hover { background: var(--as-green); color: #fff; }

    /* ---------- Cards / sections ---------- */
    .card { border: 1px solid var(--as-line); border-radius: 16px; box-shadow: 0 4px 24px rgba(15,23,42,0.05); }

    .filter-card {
        background: var(--as-bg); border: 1px solid var(--as-line);
        border-radius: 14px; padding: 18px 20px; margin-bottom: 22px;
    }
    .section-label {
        font-size: 12px; font-weight: 700; color: var(--as-muted);
        text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 14px;
        display: flex; align-items: center; gap: 8px;
    }
    .form-label { font-size: 13px; font-weight: 600; color: #475569; margin-bottom: 5px; }
    .form-select, .form-control { border-radius: 10px; border: 1.5px solid var(--as-line); font-size: 14px; padding: 9px 12px; }
    .form-select:focus, .form-control:focus { border-color: var(--as-green); box-shadow: 0 0 0 3px rgba(0,134,73,0.12); }
    .input-icon { position: relative; }
    .input-icon > i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 15px; }
    .input-icon > .form-control { padding-left: 36px; }

    /* ---------- Summary stat chips ---------- */
    .stats-bar { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
    .stat-chip {
        flex: 1 1 140px; min-width: 130px; border-radius: 14px; padding: 14px 16px;
        border: 1px solid var(--as-line); background: #fff; display: flex;
        align-items: center; gap: 12px; transition: transform .15s, box-shadow .15s;
    }
    .stat-chip:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(15,23,42,0.08); }
    .stat-chip .sc-dot { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 18px; flex: 0 0 38px; }
    .stat-chip .sc-meta { line-height: 1.1; }
    .stat-chip .sc-num { font-size: 22px; font-weight: 700; color: var(--as-ink); }
    .stat-chip .sc-label { font-size: 12px; font-weight: 600; color: var(--as-muted); text-transform: uppercase; letter-spacing: .4px; }
    .sc-total .sc-dot { background: #eef2ff; color: #4f46e5; }
    .sc-present .sc-dot { background: #dcfce7; color: #16a34a; }
    .sc-absent  .sc-dot { background: #fee2e2; color: #dc2626; }
    .sc-leave   .sc-dot { background: #dbeafe; color: #2563eb; }

    /* ---------- Table ---------- */
    .grid-section-title { font-size: 12px; font-weight: 700; color: var(--as-muted); text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 14px; display: flex; align-items: center; gap: 8px; }
    .table-responsive { border: 1px solid var(--as-line); border-radius: 14px; overflow: hidden; }
    #attendanceTable { margin: 0; }
    #attendanceTable thead th {
        background: #f1f5f9; color: #334155; font-size: 12px; font-weight: 700;
        text-transform: uppercase; letter-spacing: .4px; padding: 12px 14px;
        border-bottom: 2px solid var(--as-line); white-space: nowrap; position: sticky; top: 0; z-index: 2;
    }
    #attendanceTable tbody td { padding: 10px 14px; vertical-align: middle; font-size: 14px; color: var(--as-ink); border-top: 1px solid #eef2f6; }
    #attendanceTable tbody tr:hover td { background: #f8fafc; }
    .roll-badge { display: inline-block; min-width: 30px; text-align: center; background: #eef2ff; color: #4338ca; font-weight: 700; border-radius: 8px; padding: 2px 8px; font-size: 13px; }
    .student-name { font-weight: 600; }
    .contact-cell { color: var(--as-muted); font-variant-numeric: tabular-nums; }

    /* Row highlight by attendance status */
    #attendanceBody tr.row-present td { background-color: #f0fdf4 !important; }
    #attendanceBody tr.row-absent  td { background-color: #fef2f2 !important; }
    #attendanceBody tr.row-leave   td { background-color: #eff6ff !important; }

    /* Attendance pill toggle */
    .attendance-radio-group { display: inline-flex; gap: 6px; background: #fff; padding: 4px; border-radius: 10px; border: 1px solid var(--as-line); }
    .attendance-radio-group label { cursor: pointer; margin: 0; }
    .attendance-radio-group input[type="radio"] { display: none; }
    .radio-label { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 28px; border-radius: 7px; font-weight: 700; font-size: 13px; color: #94a3b8; transition: all 0.15s; }
    .attendance-radio-group input[value="P"]:checked + .radio-label { background: #16a34a; color: #fff; }
    .attendance-radio-group input[value="A"]:checked + .radio-label { background: #dc2626; color: #fff; }
    .attendance-radio-group input[value="L"]:checked + .radio-label { background: #2563eb; color: #fff; }

    .cell-input { border: 1.5px solid var(--as-line); border-radius: 8px; font-size: 13px; padding: 6px 10px; min-width: 120px; }
    .cell-input:focus { border-color: var(--as-green); box-shadow: 0 0 0 3px rgba(0,134,73,0.10); }

    .empty-state { text-align: center; padding: 48px 20px; color: var(--as-muted); }
    .empty-state i { font-size: 42px; color: #cbd5e1; display: block; margin-bottom: 12px; }
    .empty-state .es-title { font-weight: 600; color: #475569; margin-bottom: 4px; }

    /* Loading overlay */
    .loading-overlay { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(255,255,255,0.8); display: flex; align-items: center; justify-content: center; z-index: 100; border-radius: 16px; }
    .spinner-border { width: 3rem; height: 3rem; border-width: 0.3rem; }

    /* Print spans (hidden on screen) */
    .print-value { display: none; }
    .print-header { display: none; }
    .summer-only { display: none; }

    /* ============ Print CSS ============ */
    @@media print {
        .no-print, .sidebar, .top-header, .topbar, .top-nav, .navbar,
        .hamburger-btn, .header-actions, .header-search, .header-user-wrapper,
        .toast-container, #toastContainer, .breadcrumb, .page-title,
        .page-toolbar, .filter-card, .stats-bar, .grid-section-title, .loading-overlay { display: none !important; }

        .print-header {
            display: block !important; text-align: center; margin-bottom: 6px; padding: 0;
        }
        .print-header .school-name { font-size: 20px; font-weight: 700; margin: 0; padding: 4px 8px 2px 8px; line-height: 1.2; border-top: 2px solid black; border-left: 2px solid black; border-right: 2px solid black; }
        .print-header .school-address { font-size: 12px; margin: 0; padding: 2px 8px 4px 8px; font-weight: 400; border-bottom: 2px solid black; border-left: 2px solid black; border-right: 2px solid black; }
        .print-header .sheet-title { font-size: 15px; font-weight: 700; margin: 6px 0 0 0; padding: 5px 16px; background-color: black !important; color: white !important; text-align: center; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .print-header .date-line { text-align: right; font-size: 13px; font-weight: 500; margin: 6px 0; }

        body { margin: 0 !important; padding: 0 !important; min-height: 0 !important; height: auto !important; }
        /* Flex wrappers clip multi-page content to ONE page in Chrome print — turn them into
           plain blocks so the table paginates across as many pages as needed. */
        .wrapper { display: block !important; min-height: 0 !important; height: auto !important; }
        .main-content, .main-content.expanded { display: block !important; margin: 0 !important; min-height: 0 !important; height: auto !important; }
        .content-area { display: block !important; overflow: visible !important; }
        .main-content, .content-area, .container-fluid { margin: 0 !important; padding: 0 !important; width: 100% !important; max-width: 100% !important; }
        .card { box-shadow: none !important; border-radius: 0 !important; border: none !important; margin: 0 !important; }
        .card-body { padding: 0 !important; }
        .grid-section { margin: 0 !important; }

        .table-responsive { overflow: visible !important; border: none !important; border-radius: 0 !important; }
        table, th, td { border: 1px solid black !important; border-collapse: collapse !important; }
        .table { font-size: 12px !important; width: 100% !important; border: 1px solid black !important; border-collapse: collapse !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        #attendanceTable thead th { padding: 6px 6px !important; font-size: 11px !important; font-weight: 700 !important; background: none !important; border: 1px solid black !important; text-transform: none !important; letter-spacing: 0 !important; color: #000 !important; position: static !important; }
        #attendanceTable tbody td { padding: 5px 6px !important; border: 1px solid black !important; color: #000 !important; font-size: 12px !important; }
        #attendanceTable tbody tr:hover td { background: none !important; }

        /* Force table to fit the page width — percentage columns, no horizontal cutting */
        #attendanceTable { table-layout: fixed !important; width: 100% !important; }
        #attendanceTable th, #attendanceTable td { word-wrap: break-word !important; overflow: hidden !important; }
        /* Keep each row whole across page breaks and repeat the header on every page */
        #attendanceTable tr { page-break-inside: avoid !important; }
        #attendanceTable thead { display: table-header-group !important; }
        #attendanceTable thead th:nth-child(1), #attendanceTable tbody td:nth-child(1) { width: 5% !important; text-align: center; }   /* Sr.# */
        #attendanceTable thead th:nth-child(2), #attendanceTable tbody td:nth-child(2) { width: 7% !important; text-align: center; }   /* Roll */
        #attendanceTable thead th:nth-child(3), #attendanceTable tbody td:nth-child(3) { width: 23% !important; }                      /* Name */
        #attendanceTable thead th:nth-child(4), #attendanceTable tbody td:nth-child(4) { width: 23% !important; }                      /* Father */
        #attendanceTable thead th:nth-child(5), #attendanceTable tbody td:nth-child(5) { width: 13% !important; }                      /* Contact */
        #attendanceTable thead th:nth-child(6), #attendanceTable tbody td:nth-child(6) { width: 9% !important; }                       /* Attendance */
        #attendanceTable thead th:nth-child(7), #attendanceTable tbody td:nth-child(7) { width: 10% !important; }                      /* Informed */
        #attendanceTable thead th:nth-child(8), #attendanceTable tbody td:nth-child(8) { width: 10% !important; }                      /* Remarks */

        /* Strip screen decoration when printing */
        .roll-badge { background: none !important; color: #000 !important; padding: 0 !important; }
        #attendanceBody tr.row-present td, #attendanceBody tr.row-absent td, #attendanceBody tr.row-leave td { background-color: transparent !important; }

        .attendance-radio-group { display: none !important; }
        .screen-input { display: none !important; }
        .print-value { display: inline !important; }

        /* Attendance column — leave blank for handwriting */
        .att-cell .print-value { display: none !important; }

        #summerSheetArea { display: none; }
        body.summer-printing .print-header, body.summer-printing .card { display: none !important; }
        body.summer-printing #summerSheetArea { display: block !important; }
        body.summer-printing #summerSheetArea .print-header { display: block !important; }
        body.summer-printing #summerTable { width: 100% !important; table-layout: fixed !important; border-collapse: collapse !important; }
        body.summer-printing #summerTable th, body.summer-printing #summerTable td { word-wrap: break-word !important; overflow: hidden !important; font-size: 10px !important; padding: 3px 4px !important; color: #000 !important; }
        body.summer-printing { min-height: 0 !important; height: auto !important; margin: 0 !important; padding: 0 !important; overflow: visible !important; }
        body.summer-printing .wrapper, body.summer-printing .main-content, body.summer-printing .main-content.expanded, body.summer-printing .content-area, body.summer-printing .container-fluid { display: contents !important; }
        body.summer-printing #summerSheetArea, body.summer-printing .table-responsive { margin: 0 !important; padding: 0 !important; overflow: hidden !important; }
        body.summer-printing #summerTable { margin-bottom: 0 !important; }
        body.summer-printing #summerTable tr { page-break-inside: avoid !important; }
        body.summer-printing #summerTable thead { display: table-header-group !important; }
        .summer-box { padding: 5px 2px !important; text-align: center !important; }

        @@page { size: portrait; margin: 8mm 10mm; }
    }
</style>
}

<div class="container-fluid">
    <!-- Print Header (visible only when printing) -->
    <div class="print-header">
        <div class="school-name">SIR SYED MODEL HIGH SCHOOL (Boys&amp;Girls) Hasilpur</div>
        <div class="sheet-title" id="printSheetTitle">Attendance Sheet</div>
    </div>

    <!-- Page toolbar -->
    <div class="page-toolbar no-print">
        <div class="pt-title">
            <div class="pt-icon"><i class="bi bi-clipboard-check"></i></div>
            <div>
                <h4>Attendance Sheet</h4>
                <p class="pt-sub">Mark, search and print daily class attendance</p>
            </div>
        </div>
        <div class="pt-actions">
            <button type="button" class="btn-as-ghost" onclick="printSheet()">
                <i class="bi bi-printer me-1"></i> Print
            </button>
            <button type="button" class="btn-as-ghost" onclick="printSummerSheet()">
                <i class="bi bi-sun me-1"></i> Summer Sheet
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body position-relative">

            <!-- Loading overlay -->
            <div id="loadingOverlay" class="loading-overlay" style="display: none;">
                <div class="spinner-border text-success" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>

            <input type="hidden" id="sessionName" value="0" />

            <!-- Filter Card -->
            <div class="filter-card no-print">
                <div class="section-label"><i class="bi bi-funnel-fill"></i> Filters</div>
                <div class="row g-3 align-items-end">
                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                        <label for="filterClass" class="form-label">Class</label>
                        <select class="form-select" id="filterClass" onchange="loadSections()">
                            <option value="">-- Select Class --</option>
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                        <label for="filterSection" class="form-label">Section</label>
                        <select class="form-select" id="filterSection" disabled>
                            <option value="">-- Select Section --</option>
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                        <label class="form-label">&nbsp;</label>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn-as-primary" onclick="loadStudents()">
                                <i class="bi bi-search me-1"></i> Search
                            </button>
                            <button type="button" class="btn-as-ghost" onclick="clearFilters()">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> Clear
                            </button>
                        </div>
                    </div>
                </div>

                <hr style="border-color:var(--as-line); margin:18px 0 16px;">

                <div class="row g-3 align-items-end">
                    <div class="col-lg-5 col-md-7 col-sm-12 col-12">
                        <label for="searchBox" class="form-label">Search students</label>
                        <div class="input-icon">
                            <i class="bi bi-search"></i>
                            <input type="text" class="form-control" id="searchBox" oninput="applySearchFilter()"
                                   placeholder="Roll No, Name, Father Name or Contact...">
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-5 col-sm-6 col-12">
                        <label for="statusFilter" class="form-label">Status</label>
                        <select class="form-select" id="statusFilter" onchange="applySearchFilter()">
                            <option value="">All statuses</option>
                            <option value="P">Present</option>
                            <option value="A">Absent</option>
                            <option value="L">Leave</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Summary stat chips -->
            <div class="stats-bar no-print" id="statsBar" style="display:none;">
                <div class="stat-chip sc-total">
                    <div class="sc-dot"><i class="bi bi-people-fill"></i></div>
                    <div class="sc-meta"><div class="sc-num" id="statTotal">0</div><div class="sc-label">Total</div></div>
                </div>
                <div class="stat-chip sc-present">
                    <div class="sc-dot"><i class="bi bi-check-circle-fill"></i></div>
                    <div class="sc-meta"><div class="sc-num" id="statPresent">0</div><div class="sc-label">Present</div></div>
                </div>
                <div class="stat-chip sc-absent">
                    <div class="sc-dot"><i class="bi bi-x-circle-fill"></i></div>
                    <div class="sc-meta"><div class="sc-num" id="statAbsent">0</div><div class="sc-label">Absent</div></div>
                </div>
                <div class="stat-chip sc-leave">
                    <div class="sc-dot"><i class="bi bi-clock-fill"></i></div>
                    <div class="sc-meta"><div class="sc-num" id="statLeave">0</div><div class="sc-label">Leave</div></div>
                </div>
            </div>

            <!-- Grid Section -->
            <div class="grid-section">
                <div class="grid-section-title no-print"><i class="bi bi-table"></i> Students</div>
                <div class="table-responsive">
                    <table class="table" id="attendanceTable">
                        <thead>
                            <tr>
                                <th style="width: 50px;">Sr.#</th>
                                <th style="width: 70px;">Roll No.</th>
                                <th>Student Name</th>
                                <th>Father's Name</th>
                                <th style="width: 130px;">Contact</th>
                                <th class="text-center" style="width: 130px;">Attendance</th>
                                <th style="width: 150px;">Informed</th>
                                <th style="width: 180px;">Remarks</th>
                            </tr>
                        </thead>
                        <tbody id="attendanceBody">
                            <tr>
                                <td colspan="8">
                                    <div class="empty-state">
                                        <i class="bi bi-clipboard"></i>
                                        <div class="es-title">No students loaded</div>
                                        <div>Select a Class and Section, then click <strong>Search</strong>.</div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>

    <!-- Summer Attendance print area (visible only when printing Summer sheet) -->
    <div id="summerSheetArea" class="summer-only">
        <div class="print-header summer-header">
            <div class="school-name">SIR SYED MODEL HIGH SCHOOL (Boys&amp;Girls) Hasilpur</div>
            <div class="sheet-title" id="summerSheetTitle">Summer Attendance</div>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered" id="summerTable">
                <thead id="summerHead"></thead>
                <tbody id="summerBody"></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let allStudents = [];

    $(document).ready(function () {
        loadClasses();
    });

    async function loadClasses() {
        try {
            const response = await fetch(`${API_BASE}/class`);
            if (response.ok) {
                const classes = await response.json();
                const select = $('#filterClass');
                classes.forEach(c => {
                    select.append(`<option value="${c.vid}">${c.vName}</option>`);
                });
            }
        } catch (error) {
            toastError('Failed to load classes');
        }
    }

    async function loadSections() {
        const classId = $('#filterClass').val();
        const sectionSelect = $('#filterSection');
        sectionSelect.find('option:not(:first)').remove();
        sectionSelect.prop('disabled', true);

        if (!classId) return;

        try {
            const response = await fetch(`${API_BASE}/section/byClass/${classId}`);
            if (response.ok) {
                const sections = await response.json();
                sections.forEach(s => {
                    sectionSelect.append(`<option value="${s.vid}">${s.vName}</option>`);
                });
                sectionSelect.prop('disabled', false);
            }
        } catch (error) {
            toastError('Failed to load sections');
        }
    }

    async function loadStudents() {
        const classId = $('#filterClass').val();
        const sectionId = $('#filterSection').val();

        if (!classId) {
            toastWarning('Please select a Class');
            return;
        }

        showLoading();
        try {
            const response = await fetch(`${API_BASE}/Student`);
            if (response.ok) {
                const students = await response.json();
                // Client-side filter by class, section, and active status only
                allStudents = students.filter(s => {
                    const matchClass = String(s.classID || s.classId || '') === String(classId);
                    const matchSection = !sectionId || String(s.sectionID || s.sectionId || '') === String(sectionId);
                    const statusID = s.statusID === 1;
                    const isActive = s.isActive === true;

                    return matchClass && matchSection && statusID && isActive;
                });
                // Sort by roll number
                allStudents.sort((a, b) => {
                    const rollA = parseInt(a.rollNo || a.rollNumber) || 0;
                    const rollB = parseInt(b.rollNo || b.rollNumber) || 0;
                    return rollA - rollB;
                });
                renderGrid(allStudents);
                if (allStudents.length === 0) {
                    toastInfo('No students found for selected filters');
                } else {
                    toastSuccess(`${allStudents.length} student(s) loaded`);
                }
            } else {
                toastError('Failed to fetch students');
            }
        } catch (error) {
            toastError('Error: ' + error.message);
        } finally {
            hideLoading();
        }
    }

    function renderGrid(items) {
        const tbody = $('#attendanceBody');
        tbody.empty();

        if (items.length === 0) {
            $('#statsBar').hide();
            tbody.html(`
                <tr><td colspan="8">
                    <div class="empty-state">
                        <i class="bi bi-search"></i>
                        <div class="es-title">No students found</div>
                        <div>Try adjusting the class, section or search filters.</div>
                    </div>
                </td></tr>`);
            return;
        }

        items.forEach((item, index) => {
            const sessionName = item.sessionName || '-';
            const name = item.name || item.nameOfStudent || item.studentName || '-';
            const fathername = item.fatherName || '-';
            const rollNo = item.rollNo || item.rollNumber || '-';
            const contact = item.mobileNo || item.fatherMobile || '-';
            const sr = index + 1;
            const uid = item.id || index;

            $('#sessionName').val(sessionName);

            const searchText = `${rollNo} ${name} ${fathername} ${contact}`.replace(/"/g, '');
            const row = `
                <tr data-uid="${uid}" data-search="${searchText}">
                    <td>${sr}</td>
                    <td><span class="roll-badge">${rollNo}</span></td>
                    <td class="student-name">${name}</td>
                    <td>${fathername}</td>
                    <td class="contact-cell">${contact}</td>
                    <td class="text-center att-cell">
                        <div class="attendance-radio-group">
                            <label>
                                <input type="radio" name="att_${uid}" value="P" checked>
                                <span class="radio-label">P</span>
                            </label>
                            <label>
                                <input type="radio" name="att_${uid}" value="A">
                                <span class="radio-label">A</span>
                            </label>
                            <label>
                                <input type="radio" name="att_${uid}" value="L">
                                <span class="radio-label">L</span>
                            </label>
                        </div>
                        <span class="print-value" id="pv_att_${uid}">P</span>
                    </td>
                    <td>
                        <input type="text" class="cell-input screen-input" id="informed_${uid}" placeholder="—">
                        <span class="print-value" id="pv_informed_${uid}"></span>
                    </td>
                    <td>
                        <input type="text" class="cell-input screen-input" id="remarks_${uid}" placeholder="—">
                        <span class="print-value" id="pv_remarks_${uid}"></span>
                    </td>
                </tr>
            `;
            tbody.append(row);
        });

        // Bind radio change to update print spans, row color, summary and active filter
        $('input[type="radio"][name^="att_"]').on('change', function () {
            const name = $(this).attr('name');
            const val = $(this).val();
            $(`#pv_${name}`).text(val);
            updateRowColor($(this).closest('tr'));
            updateSummary();
            applySearchFilter();
        });

        // Apply initial row colors (default selection is Present)
        $('#attendanceBody tr').each(function () { updateRowColor($(this)); });
        updateSummary();
        applySearchFilter();
    }

    // Highlight the full row based on its selected attendance status
    function updateRowColor($row) {
        const val = $row.find('input[type="radio"]:checked').val();
        $row.removeClass('row-present row-absent row-leave');
        if (val === 'P') $row.addClass('row-present');
        else if (val === 'A') $row.addClass('row-absent');
        else if (val === 'L') $row.addClass('row-leave');
    }

    // Update the Total / Present / Absent / Leave summary chips
    function updateSummary() {
        if (allStudents.length === 0) { $('#statsBar').hide(); return; }
        let p = 0, a = 0, l = 0;
        $('#attendanceBody tr').each(function () {
            const val = $(this).find('input[type="radio"]:checked').val();
            if (val === 'P') p++;
            else if (val === 'A') a++;
            else if (val === 'L') l++;
        });
        $('#statTotal').text(p + a + l);
        $('#statPresent').text(p);
        $('#statAbsent').text(a);
        $('#statLeave').text(l);
        $('#statsBar').css('display', 'flex');
    }

    // Filter loaded rows by search text (roll/name/father/contact) and status
    function applySearchFilter() {
        const q = ($('#searchBox').val() || '').toLowerCase().trim();
        const status = $('#statusFilter').val();
        $('#attendanceBody tr').each(function () {
            const $row = $(this);
            const search = $row.attr('data-search');
            if (search === undefined) return; // skip placeholder rows
            const text = String(search).toLowerCase();
            const rowStatus = $row.find('input[type="radio"]:checked').val();
            const matchSearch = !q || text.indexOf(q) !== -1;
            const matchStatus = !status || rowStatus === status;
            $row.toggle(matchSearch && matchStatus);
        });
    }

    function printSheet() {
        if (allStudents.length === 0) {
            toastWarning('No students loaded. Please search first.');
            return;
        }

        // Set class name in title
        const className = $('#filterClass option:selected').text();
        const classDisplay = className !== '-- Select Class --' ? className : '';
        const sectionName = $('#filterSection option:selected').text();
        const sectionDisplay = sectionName !== '-- Select Class --' ? sectionName : '';
        const sessionName = $('#sessionName').val();
        $('#printSheetTitle').html(
            `Attendance Sheet (${classDisplay} - ${sectionDisplay})
            <span style="float:right;">${sessionName}</span>`
        );
        // Copy input values to print spans
        allStudents.forEach((item, index) => {
            const uid = item.id || index;
            const attVal = $(`input[name="att_${uid}"]:checked`).val() || 'P';
            $(`#pv_att_${uid}`).text(attVal);
            $(`#pv_informed_${uid}`).text($(`#informed_${uid}`).val() || '');
            $(`#pv_remarks_${uid}`).text($(`#remarks_${uid}`).val() || '');
        });

        window.print();
    }

    function printSummerSheet() {
        if (allStudents.length === 0) {
            toastWarning('No students loaded. Please search first.');
            return;
        }

        const className = $('#filterClass option:selected').text();
        const classDisplay = className !== '-- Select Class --' ? className : '';
        const sectionName = $('#filterSection option:selected').text();
        const sectionDisplay = sectionName !== '-- Select Section --' ? sectionName : '';
        const sessionName = $('#sessionName').val();

        $('#summerSheetTitle').html(
            `Attendance (${classDisplay} - ${sectionDisplay}) Summer camp
            <span style="float:right;">${sessionName}</span>`
        );

        // Header: Sr.#, Roll No., Student Name, Father's Name (no Contact) + 16 blank boxes
        // Widths as % so the table always fits the page width (table-layout: fixed)
        let boxHeaders = '';
        for (let i = 1; i <= 16; i++) boxHeaders += `<th class="summer-box" style="width: 3.6%;"></th>`;
        $('#summerHead').html(
            `<tr>
                <th style="width: 4%;">Sr.#</th>
                <th style="width: 5%;">Roll No.</th>
                <th style="width: 15%;">Student Name</th>
                <th style="width: 14%;">Father's Name</th>
                ${boxHeaders}
            </tr>`
        );

        // Body rows with 16 blank boxes each
        let blankBoxes = '';
        for (let i = 1; i <= 16; i++) blankBoxes += '<td class="summer-box"></td>';
        let rows = '';
        allStudents.forEach((item, index) => {
            const name = item.name || item.nameOfStudent || item.studentName || '-';
            const fathername = item.fatherName || '-';
            const rollNo = item.rollNo || item.rollNumber || '-';
            const sr = index + 1;
            rows += `
                <tr>
                    <td>${sr}</td>
                    <td><strong>${rollNo}</strong></td>
                    <td>${name}</td>
                    <td>${fathername}</td>
                    ${blankBoxes}
                </tr>`;
        });
        $('#summerBody').html(rows);

        document.body.classList.add('summer-printing');
        window.print();
    }

    // Remove summer print mode after printing/cancel
    window.addEventListener('afterprint', function () {
        document.body.classList.remove('summer-printing');
    });

    function clearFilters() {
        $('#filterClass').val('').trigger('change');
        $('#filterSection').find('option:not(:first)').remove();
        $('#filterSection').prop('disabled', true);
        $('#searchBox').val('');
        $('#statusFilter').val('');
        allStudents = [];
        $('#statsBar').hide();
        $('#attendanceBody').html(`
            <tr><td colspan="8">
                <div class="empty-state">
                    <i class="bi bi-clipboard"></i>
                    <div class="es-title">No students loaded</div>
                    <div>Select a Class and Section, then click <strong>Search</strong>.</div>
                </div>
            </td></tr>`);
    }

    function showLoading() { $('#loadingOverlay').css('display', 'flex'); }
    function hideLoading() { $('#loadingOverlay').css('display', 'none'); }
</script>
}
