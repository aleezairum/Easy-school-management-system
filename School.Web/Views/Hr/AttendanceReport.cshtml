@{
    ViewData["Title"] = "Staff Attendance Report";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@*
    Staff attendance over a date range, by campus, designation or one employee.
    Late arrival, early leaving and time out of school are shown in minutes
    and in rupees - the deduction is what payroll charges for those minutes,
    priced by the same rules (see HrReportsService). Excused lateness is shown
    and not charged.
*@

@section Styles {
<style>
    #repTable th, #repTable td { font-size: 12.5px; vertical-align: middle; }
    #repTable .ctr { text-align: center; }
    #repTable .num { text-align: right; white-space: nowrap; }
</style>
}

<div class="container-fluid">
    <div id="alertContainer"></div>

    <div class="card mb-3"><div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-2"><label class="form-label">Report</label>
                <select class="form-select" id="repType">
                    <option value="daily">Daily Attendance</option>
                    <option value="summary">Summary (per employee)</option>
                    <option value="late">Late Comers</option>
                    <option value="early">Early Leavers</option>
                    <option value="outing">Out of School (Short Leave)</option>
                    <option value="absent">Absentees</option>
                </select>
            </div>
            <div class="col-md-2"><label class="form-label">From</label><input type="date" class="form-control" id="fFrom" /></div>
            <div class="col-md-2"><label class="form-label">To</label><input type="date" class="form-control" id="fTo" /></div>
            <div class="col-md-2"><label class="form-label">Campus</label>
                <select class="form-select" id="fCampus"><option value="">All campuses</option></select></div>
            <div class="col-md-2"><label class="form-label">Designation</label>
                <select class="form-select" id="fDesignation"><option value="">All designations</option></select></div>
            <div class="col-md-2"><label class="form-label">Employee</label>
                <select class="form-select" id="fEmployee"><option value="">All employees</option></select></div>
        </div>
        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-primary" onclick="runReport()"><i class="bi bi-search"></i> Run</button>
            <button class="btn btn-outline-dark" onclick="printReport()"><i class="bi bi-printer"></i> Print</button>
            <span id="repInfo" class="text-muted small align-self-center ms-2"></span>
        </div>
    </div></div>

    <div class="card"><div class="card-body">
        <div class="table-responsive"><table class="table table-sm table-hover table-bordered" id="repTable">
            <thead id="repHead"></thead><tbody id="repBody"></tbody><tfoot id="repFoot"></tfoot>
        </table></div>
    </div></div>
</div>

@section Scripts {
<script src="~/js/hrFilters.js" asp-append-version="true"></script>
<script>
    const STATUS = {1:'Present',2:'Absent',3:'Leave',4:'Half Day',5:'Holiday',6:'Weekly Off',7:'Short Leave',8:'Exempt'};
    const TITLES = {
        daily: 'Daily Attendance', summary: 'Attendance Summary', late: 'Late Comers',
        early: 'Early Leavers', outing: 'Out of School (Short Leave)', absent: 'Absentees'
    };
    let _last = null;   // { type, rows, from, to } of the last run, for printing

    // Columns per report: heading, value, alignment, and the field a total adds up.
    const who = [
        { h: 'Code', v: r => hrEsc(r.employeeCode) },
        { h: 'Employee', v: r => hrEsc(r.employeeName) },
        { h: 'Designation', v: r => hrEsc(r.designationName || '-') },
        { h: 'Campus', v: r => hrEsc(r.campusName || '-') }
    ];
    const date = { h: 'Date', v: r => fmtDate(r.attDate), c: 'ctr' };
    const mins = (h, f) => ({ h, v: r => r[f] || '', c: 'ctr', sum: f });
    // Staff with no salary structure cannot be priced (payroll skips them too) - say so.
    const rs = (h, f) => ({ h, v: r => r.noSalaryRecord ? '<span class="text-danger small" title="No salary structure: nothing to deduct from">No salary</span>' : hrMoney(r[f], true), c: 'num', sum: f, money: true });
    const COLS = {
        daily: [date, ...who,
            { h: 'Status', v: r => STATUS[r.status] || '-', c: 'ctr' },
            { h: 'In', v: r => hrTime(r.timeIn), c: 'ctr' }, { h: 'Out', v: r => hrTime(r.timeOut), c: 'ctr' },
            { h: 'Late (min)', v: r => r.lateMinutes ? r.lateMinutes + (r.ignoreLate ? ' (excused)' : '') : '', c: 'ctr', sum: 'lateMinutes' },
            rs('Late Ded.', 'lateDeduction'), mins('Early (min)', 'earlyMinutes'), rs('Early Ded.', 'earlyDeduction'),
            mins('Out (min)', 'outingMinutes'), rs('Out Ded.', 'outingDeduction'), rs('Total Ded.', 'totalDeduction')],
        late: [date, ...who,
            { h: 'Time In', v: r => hrTime(r.timeIn), c: 'ctr' }, mins('Late (min)', 'lateMinutes'),
            { h: 'Excused', v: r => r.ignoreLate ? 'Yes' : '', c: 'ctr' }, rs('Deduction (Rs)', 'lateDeduction')],
        early: [date, ...who,
            { h: 'Time Out', v: r => hrTime(r.timeOut), c: 'ctr' }, mins('Early (min)', 'earlyMinutes'), rs('Deduction (Rs)', 'earlyDeduction')],
        outing: [date, ...who, mins('Out of School (min)', 'outingMinutes'), rs('Deduction (Rs)', 'outingDeduction'),
            { h: 'Remarks', v: r => hrEsc(r.remarks || '') }],
        absent: [date, ...who, { h: 'Remarks', v: r => hrEsc(r.remarks || '') }],
        summary: [...who,
            mins('Present', 'presentDays'), mins('Absent', 'absentDays'), mins('Leave', 'leaveDays'),
            mins('Half Day', 'halfDays'), mins('Short Lv', 'shortLeaveDays'), mins('Exempt', 'exemptDays'),
            mins('Late Days', 'lateCount'), mins('Late (min)', 'lateMinutes'), rs('Late Ded.', 'lateDeduction'),
            mins('Early Days', 'earlyCount'), mins('Early (min)', 'earlyMinutes'), rs('Early Ded.', 'earlyDeduction'),
            mins('Out Days', 'outingCount'), mins('Out (min)', 'outingMinutes'), rs('Out Ded.', 'outingDeduction'),
            rs('Total Ded.', 'totalDeduction')]
    };

    $(document).ready(function () {
        const now = new Date();
        $('#fFrom').val(toInputDate(new Date(now.getFullYear(), now.getMonth(), 1)));
        $('#fTo').val(toInputDate(now));
        hrInitFilters();
    });

    async function runReport() {
        const type = $('#repType').val(), from = $('#fFrom').val(), to = $('#fTo').val();
        if (!from || !to) { toastWarning('Choose From and To dates'); return; }
        const res = await fetch(`${API_BASE}/hr/reports/attendance?type=${type}&from=${from}&to=${to}${hrFilterQuery()}`);
        if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            toastError(err.message || 'Failed to load report'); return;
        }
        const rows = await res.json();
        _last = { type, rows, from, to };
        const t = tableParts(type, rows);
        $('#repHead').html(t.head); $('#repBody').html(t.body); $('#repFoot').html(t.foot);
        $('#repInfo').text(`${rows.length} row(s)`);
    }

    function tableParts(type, rows) {
        const cols = COLS[type];
        const head = '<tr><th class="ctr">Sr.</th>' + cols.map(c => `<th class="${c.c || ''}">${c.h}</th>`).join('') + '</tr>';
        if (!rows.length)
            return { head, body: `<tr><td colspan="${cols.length + 1}" class="text-center text-muted py-3">No data.</td></tr>`, foot: '' };
        const body = rows.map((r, i) => '<tr><td class="ctr">' + (i + 1) + '</td>'
            + cols.map(c => `<td class="${c.c || ''}">${c.v(r)}</td>`).join('') + '</tr>').join('');
        const foot = cols.some(c => c.sum)
            ? '<tr><td></td>' + cols.map((c, i) => {
                if (!c.sum) return i === 0 ? '<td><strong>Total</strong></td>' : '<td></td>';
                const s = rows.reduce((t, r) => t + (Number(r[c.sum]) || 0), 0);
                return `<td class="${c.c || ''}"><strong>${c.money ? hrMoney(s) : s}</strong></td>`;
            }).join('') + '</tr>'
            : '';
        return { head, body, foot };
    }

    function printReport() {
        if (!_last) { toastWarning('Run the report first'); return; }
        const t = tableParts(_last.type, _last.rows);
        const caption = [hrPeriodCaption(_last.from, _last.to), hrFilterCaption()].filter(Boolean).join('   |   ');
        hrPrintWindow(`Staff ${TITLES[_last.type]}`, caption,
            `<table><thead>${t.head}</thead><tbody>${t.body}</tbody><tfoot>${t.foot}</tfoot></table>`,
            { landscape: _last.type === 'daily' || _last.type === 'summary', css: 'th,td{font-size:10px}' });
    }
</script>
}
