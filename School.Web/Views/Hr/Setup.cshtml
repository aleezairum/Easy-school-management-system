@{
    ViewData["Title"] = "Payroll Setup";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    .nav-tabs { border-bottom: 2px solid #e2e8f0; margin-bottom: 16px; }
    .nav-tabs .nav-link { border: none; color: #64748b; font-weight: 500; }
    .nav-tabs .nav-link.active { color: #008649; border-bottom: 3px solid #008649; background: transparent; }
    .form-section { background: #f8fafc; border-radius: 12px; padding: 20px; margin-bottom: 20px; }
    .section-title { font-size: 12px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 16px; padding-bottom: 8px; border-bottom: 2px solid #e2e8f0; }
    .preview-box { background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; padding: 12px 16px; margin-top: 10px; }
    .empty-row td { text-align: center; color: #94a3b8; padding: 24px 0; }
</style>

<div class="container-fluid">
    <div id="alertContainer"></div>

    <ul class="nav nav-tabs">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabDesignations" type="button">Designations</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabGrades" type="button">Grades</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabHolidays" type="button">Holidays</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabLeaveTypes" type="button">Leave Types</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabComponents" type="button">Pay Components</button></li>
    </ul>

    <div class="tab-content">
        <!-- DESIGNATIONS -->
        <div class="tab-pane fade show active" id="tabDesignations">
            <div class="card"><div class="card-body">
                <div class="form-section">
                    <div class="section-title"><i class="bi bi-person-badge me-2"></i><span id="desigFormTitle">Add Designation</span></div>
                    <input type="hidden" id="desigId" value="0" />
                    <div class="row g-3 align-items-end">
                        <div class="col-md-2"><label class="form-label">Code <span class="text-danger">*</span></label><input class="form-control" id="desigCode" placeholder="e.g. PRIN" /></div>
                        <div class="col-md-3"><label class="form-label">Name <span class="text-danger">*</span></label><input class="form-control" id="desigName" placeholder="e.g. Principal" /></div>
                        <div class="col-md-3"><label class="form-label">Description</label><input class="form-control" id="desigDescription" placeholder="Optional" /></div>
                        <div class="col-md-1"><label class="form-label">Sort</label><input type="number" class="form-control" id="desigSort" value="0" /></div>
                        <div class="col-md-1"><div class="form-check"><input class="form-check-input" type="checkbox" id="desigActive" checked /><label class="form-check-label">Active</label></div></div>
                        <div class="col-md-2 d-flex gap-2">
                            <button class="btn btn-primary" onclick="saveDesignation()"><i class="bi bi-check-lg"></i> Save</button>
                            <button class="btn btn-secondary" onclick="resetDesignationForm()"><i class="bi bi-x-lg"></i> Clear</button>
                        </div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead><tr><th>Code</th><th>Name</th><th>Description</th><th>Sort</th><th>Employees</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
                        <tbody id="designationsBody"></tbody>
                    </table>
                </div>
            </div></div>
        </div>

        <!-- GRADES -->
        <div class="tab-pane fade" id="tabGrades">
            <div class="card"><div class="card-body">
                <div class="form-section">
                    <div class="section-title"><i class="bi bi-bar-chart-steps me-2"></i><span id="gradeFormTitle">Add Grade</span></div>
                    <input type="hidden" id="gradeId" value="0" />
                    <div class="row g-3 align-items-end">
                        <div class="col-md-2"><label class="form-label">Code <span class="text-danger">*</span></label><input class="form-control" id="gradeCode" placeholder="e.g. BPS-17" /></div>
                        <div class="col-md-3"><label class="form-label">Name <span class="text-danger">*</span></label><input class="form-control" id="gradeName" placeholder="e.g. Senior Teacher" /></div>
                        <div class="col-md-3"><label class="form-label">Description</label><input class="form-control" id="gradeDescription" placeholder="Optional" /></div>
                        <div class="col-md-2"><label class="form-label">Min Salary</label><input type="number" step="0.01" class="form-control" id="gradeMinSalary" /></div>
                        <div class="col-md-2"><label class="form-label">Max Salary</label><input type="number" step="0.01" class="form-control" id="gradeMaxSalary" /></div>
                        <div class="col-md-1"><label class="form-label">Sort</label><input type="number" class="form-control" id="gradeSort" value="0" /></div>
                        <div class="col-md-1"><div class="form-check"><input class="form-check-input" type="checkbox" id="gradeActive" checked /><label class="form-check-label">Active</label></div></div>
                        <div class="col-md-3 d-flex gap-2">
                            <button class="btn btn-primary" onclick="saveGrade()"><i class="bi bi-check-lg"></i> Save</button>
                            <button class="btn btn-secondary" onclick="resetGradeForm()"><i class="bi bi-x-lg"></i> Clear</button>
                        </div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead><tr><th>Code</th><th>Name</th><th class="text-end">Min Salary</th><th class="text-end">Max Salary</th><th>Sort</th><th>Employees</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
                        <tbody id="gradesBody"></tbody>
                    </table>
                </div>
            </div></div>
        </div>

        <!-- HOLIDAYS -->
        <div class="tab-pane fade" id="tabHolidays">
            <div class="card"><div class="card-body">
                <div class="form-section">
                    <div class="section-title"><i class="bi bi-calendar-x me-2"></i><span id="holidayFormTitle">Add Holiday</span></div>
                    <input type="hidden" id="holidayId" value="0" />
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3"><label class="form-label">Date</label><input type="date" class="form-control" id="holidayDate" /></div>
                        <div class="col-md-4"><label class="form-label">Name</label><input class="form-control" id="holidayName" /></div>
                        <div class="col-md-2"><label class="form-label">Type</label>
                            <select class="form-select" id="holidayType">
                                <option value="1">Gazetted</option>
                                <option value="2">Vacation</option>
                                <option value="3">Half Day</option>
                            </select>
                        </div>
                        <div class="col-md-3 d-flex gap-2">
                            <button class="btn btn-primary" onclick="saveHoliday()"><i class="bi bi-check-lg"></i> Save</button>
                            <button class="btn btn-secondary" onclick="resetHolidayForm()">Clear</button>
                        </div>
                    </div>
                    <div class="row g-2 align-items-end mt-2">
                        <div class="col-md-2"><label class="form-label">Copy from year</label><input type="number" class="form-control" id="copyFromYear" placeholder="2025" /></div>
                        <div class="col-md-2"><label class="form-label">To year</label><input type="number" class="form-control" id="copyToYear" placeholder="2026" /></div>
                        <div class="col-md-3"><button class="btn btn-outline-success" onclick="copyHolidayYear()"><i class="bi bi-copy"></i> Copy Year</button></div>
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-md-2"><input type="number" class="form-control" id="holidayFilterYear" placeholder="Year filter" /></div>
                    <div class="col-md-2"><button class="btn btn-outline-secondary" onclick="loadHolidays()">Filter</button></div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead><tr><th>Date</th><th>Name</th><th>Type</th><th class="text-end">Actions</th></tr></thead>
                        <tbody id="holidaysBody"></tbody>
                    </table>
                </div>
            </div></div>
        </div>

        <!-- LEAVE TYPES -->
        <div class="tab-pane fade" id="tabLeaveTypes">
            <div class="card"><div class="card-body">
                <div class="form-section">
                    <div class="section-title"><i class="bi bi-calendar-check me-2"></i><span id="leaveTypeFormTitle">Add Leave Type</span></div>
                    <input type="hidden" id="ltId" value="0" />
                    <div class="row g-3 align-items-end">
                        <div class="col-md-2"><label class="form-label">Code <span class="text-danger">*</span></label><input class="form-control" id="ltCode" placeholder="e.g. CL" /></div>
                        <div class="col-md-3"><label class="form-label">Name <span class="text-danger">*</span></label><input class="form-control" id="ltName" placeholder="e.g. Casual Leave" /></div>
                        <div class="col-md-2"><label class="form-label">Deduct Days</label><input type="number" step="0.25" min="0" class="form-control" id="ltDeductDays" value="0" /></div>
                        <div class="col-md-2"><label class="form-label">Max / Year</label><input type="number" min="0" class="form-control" id="ltMaxPerYear" placeholder="Unlimited" /></div>
                        <div class="col-md-1"><div class="form-check"><input class="form-check-input" type="checkbox" id="ltIsPaid" checked /><label class="form-check-label">Paid</label></div></div>
                        <div class="col-md-1"><div class="form-check"><input class="form-check-input" type="checkbox" id="ltActive" checked /><label class="form-check-label">Active</label></div></div>
                        <div class="col-md-3 d-flex gap-2">
                            <button class="btn btn-primary" onclick="saveLeaveType()"><i class="bi bi-check-lg"></i> Save</button>
                            <button class="btn btn-secondary" onclick="resetLeaveTypeForm()"><i class="bi bi-x-lg"></i> Clear</button>
                        </div>
                    </div>
                    <div class="form-text mt-2">Deduct days is how much unpaid salary one day of this leave costs &mdash; 0 for fully paid leave, 1 for fully unpaid, 0.5 for half.</div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead><tr><th>Code</th><th>Name</th><th>Paid</th><th>Deduct Days</th><th>Max/Year</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
                        <tbody id="leaveTypesBody"></tbody>
                    </table>
                </div>
            </div></div>
        </div>

        <!-- PAY COMPONENTS -->
        <div class="tab-pane fade" id="tabComponents">
            <div class="card"><div class="card-body">
                <div class="form-section">
                    <div class="section-title"><i class="bi bi-calculator me-2"></i><span id="compFormTitle">Add Pay Component</span></div>
                    <input type="hidden" id="compId" value="0" />
                    <div class="row g-3">
                        <div class="col-md-2"><label class="form-label">Code</label><input class="form-control" id="compCode" /></div>
                        <div class="col-md-3"><label class="form-label">Name</label><input class="form-control" id="compName" /></div>
                        <div class="col-md-2"><label class="form-label">Kind</label>
                            <select class="form-select" id="compKind"><option value="1">Earning</option><option value="2">Deduction</option></select>
                        </div>
                        <div class="col-md-2"><label class="form-label">Calc Type</label>
                            <select class="form-select" id="compCalcType" onchange="toggleCalcFields()">
                                <option value="1">Fixed</option>
                                <option value="2">Percent Of</option>
                                <option value="3">Per Late Minute</option>
                                <option value="4">Per Absent Day</option>
                                <option value="5">Per Overtime Hour</option>
                                <option value="6">Slab</option>
                                <option value="7">Formula</option>
                                @* The attendance-minute rules. Without these three the
                                   list could not show them, and saving one turned it into
                                   "Per Late Minute" - it then charged late minutes again
                                   and stopped charging what it was meant to. *@
                                <option value="8">Per Out-of-School Minute</option>
                                <option value="9">Per Early Leaving Minute</option>
                                <option value="10">Per Duty Minute (short - extra)</option>
                                @* Leave priced like an absent day; each day by its leave
                                   type's Paid / Deduct Days, Free Units = paid leaves a month. *@
                                <option value="11">Per Leave Day</option>
                            </select>
                        </div>
                        <div class="col-md-3"><label class="form-label">Scope</label>
                            <div class="d-flex gap-2">
                                <select class="form-select" id="compScopeType" onchange="toggleScopeFields()">
                                    <option value="1">Global</option>
                                    <option value="2">Grade</option>
                                    <option value="3">Designation</option>
                                    <option value="4">Employee</option>
                                </select>
                                <select class="form-select" id="compScopeRef" style="display:none;"></select>
                                <input type="number" class="form-control" id="compScopeId" placeholder="Employee Id" style="max-width:130px; display:none;" />
                            </div>
                        </div>

                        <div class="col-md-2" id="fldRate"><label class="form-label">Rate</label><input type="number" step="0.0001" class="form-control" id="compRate" /></div>
                        <div class="col-md-2" id="fldRateSource"><label class="form-label">Rate Source</label>
                            <select class="form-select" id="compRateSource"><option value="1">Fixed</option><option value="2">Derived from Salary</option></select>
                        </div>
                        <div class="col-md-2" id="fldBaseOn"><label class="form-label">Base On</label>
                            <select class="form-select" id="compBaseOn"><option value="1">Basic</option><option value="2">Gross</option></select>
                        </div>
                        <div class="col-md-2" id="fldDivisorDays"><label class="form-label">Divisor Days</label>
                            <select class="form-select" id="compDivisorDays"><option value="30">Fixed 30</option><option value="0">Calendar</option><option value="255">Working Days</option></select>
                        </div>
                        <div class="col-md-2" id="fldGrace"><label class="form-label">Grace Minutes</label><input type="number" class="form-control" id="compGrace" value="0" /></div>
                        <div class="col-md-2"><label class="form-label">Free Units/Month</label><input type="number" step="0.5" class="form-control" id="compFreeUnits" /></div>
                        <div class="col-12" id="leaveRuleHint" style="display:none;">
                            <div class="form-text">
                                <b>Per Leave Day:</b> each day marked <i>Leave</i> is charged at one day's pay (like an absent day).
                                A day with a Leave Type costs that type's <i>Deduct Days</i> (Leave Types tab: 0 paid, 1 unpaid, 0.5 half);
                                a day with no type costs a full day. <b>Free Units/Month</b> = leave days a month that are still paid.
                                Turn this rule off (Active unticked) and all leave is paid.
                            </div>
                        </div>
                        <div class="col-md-2"><label class="form-label">Cap / Day</label><input type="number" class="form-control" id="compCapDay" /></div>
                        <div class="col-md-2"><label class="form-label">Cap / Month</label><input type="number" class="form-control" id="compCapMonth" /></div>
                        <div class="col-md-2"><label class="form-label">Priority</label><input type="number" class="form-control" id="compPriority" value="0" /></div>
                        <div class="col-md-4" id="fldFormula" style="display:none;"><label class="form-label">Formula (NCalc)</label><input class="form-control" id="compFormula" placeholder="if(LateCount > 3, PerDayRate * 0.5, LateMinutes * PerMinuteRate)" /></div>
                        <div class="col-md-6" id="fldSlabs" style="display:none;">
                            <label class="form-label">Slabs (one per line: from,to,amount|days|percent)</label>
                            <textarea class="form-control" id="compSlabsText" rows="2" placeholder="0,2,,0,\n3,,,0.5,"></textarea>
                            <div class="form-text">Format: from,to,amount,days,percent &mdash; leave a field blank if unused. Example: 3,, , 0.5, means "3 and above -> 0.5 days".</div>
                        </div>
                        <div class="col-md-2"><label class="form-label">Effective From</label><input type="date" class="form-control" id="compEffFrom" /></div>
                        <div class="col-md-2"><label class="form-label">Effective To</label><input type="date" class="form-control" id="compEffTo" /></div>
                        <div class="col-md-2 d-flex align-items-end"><div class="form-check"><input class="form-check-input" type="checkbox" id="compShowSlip" checked /><label class="form-check-label">Show on payslip</label></div></div>
                        <div class="col-md-2 d-flex align-items-end"><div class="form-check"><input class="form-check-input" type="checkbox" id="compActive" checked /><label class="form-check-label">Active</label></div></div>
                        <div class="col-md-3 d-flex align-items-end gap-2">
                            <button class="btn btn-primary" onclick="saveComponent()"><i class="bi bi-check-lg"></i> Save</button>
                            <button class="btn btn-secondary" onclick="resetComponentForm()">Clear</button>
                        </div>
                    </div>

                    <div class="section-title mt-4"><i class="bi bi-eye me-2"></i>Live Preview</div>
                    <div class="row g-2 align-items-end">
                        <div class="col-md-2"><label class="form-label">Basic</label><input type="number" class="form-control" id="prevBasic" value="20000" /></div>
                        <div class="col-md-2"><label class="form-label">Gross</label><input type="number" class="form-control" id="prevGross" value="20000" /></div>
                        <div class="col-md-2"><label class="form-label">Late Min/day</label><input type="number" class="form-control" id="prevLateMin" value="25" /></div>
                        <div class="col-md-2"><label class="form-label">Late Count</label><input type="number" class="form-control" id="prevLateCount" value="1" /></div>
                        <div class="col-md-2"><label class="form-label">Absent Days</label><input type="number" class="form-control" id="prevAbsent" value="0" /></div>
                        <div class="col-md-2"><button class="btn btn-outline-success" onclick="runPreview()"><i class="bi bi-play-fill"></i> Preview</button></div>
                    </div>
                    <div class="preview-box" id="previewResult" style="display:none;"></div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead><tr><th>Code</th><th>Name</th><th>Kind</th><th>Calc</th><th>Scope</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
                        <tbody id="componentsBody"></tbody>
                    </table>
                </div>
            </div></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const KIND_NAMES = {1:'Earning',2:'Deduction'};
    const CALC_NAMES = {1:'Fixed',2:'Percent Of',3:'Per Late Minute',4:'Per Absent Day',5:'Per Overtime Hour',6:'Slab',7:'Formula',
                        8:'Per Out-of-School Minute',9:'Per Early Leaving Minute',10:'Per Duty Minute (short - extra)',11:'Per Leave Day'};
    const SCOPE_NAMES = {1:'Global',2:'Grade',3:'Designation',4:'Employee'};
    const HOLIDAY_TYPE_NAMES = {1:'Gazetted',2:'Vacation',3:'Half Day'};
    const WEEKDAYS = [{v:1,n:'Sunday'},{v:2,n:'Monday'},{v:3,n:'Tuesday'},{v:4,n:'Wednesday'},{v:5,n:'Thursday'},{v:6,n:'Friday'},{v:7,n:'Saturday'}];

    // Rows are built as HTML strings, so anything coming back from the API has to be escaped.
    function esc(v) {
        if (v === null || v === undefined) return '';
        return String(v).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }
    function statusBadge(isActive) {
        return `<span class="badge ${isActive ? 'bg-success' : 'bg-secondary'}">${isActive ? 'Active' : 'Inactive'}</span>`;
    }
    function rowActions(editFn, deleteFn, id) {
        return `<td class="text-end">
            <button class="btn btn-sm btn-info me-1" onclick="${editFn}(${id})" title="Edit"><i class="bi bi-pencil"></i></button>
            <button class="btn btn-sm btn-danger" onclick="${deleteFn}(${id})" title="Delete"><i class="bi bi-trash"></i></button>
        </td>`;
    }
    function emptyRow(body, colspan, text) {
        body.append(`<tr class="empty-row"><td colspan="${colspan}">${text}</td></tr>`);
    }
    function money(v) {
        return (v === null || v === undefined) ? '-' : Number(v).toLocaleString(undefined, { minimumFractionDigits: 0 });
    }
    // API validation failures come back as { message } — show that rather than a generic error.
    async function apiError(res, fallback) {
        try {
            const body = await res.json();
            if (body && body.message) return body.message;
        } catch (e) { }
        return fallback;
    }

    $(document).ready(function () {
        
        // Designations and grades load first — the pay-component scope picker reads them.
        Promise.all([loadDesignations(), loadGrades()]).then(loadComponents);
        loadHolidays(); loadLeaveTypes();
        toggleCalcFields();
        toggleScopeFields();
    });

    // ---- Designations ----
    async function loadDesignations() {
        const res = await fetch(`${API_BASE}/Designation`);
        const data = res.ok ? await res.json() : [];
        window._designations = data;
        const body = $('#designationsBody'); body.empty();
        if (!data.length) { emptyRow(body, 7, 'No designations yet.'); return; }
        data.forEach(d => {
            body.append(`<tr>
                <td>${esc(d.code)}</td><td>${esc(d.name)}</td><td>${esc(d.description) || '-'}</td>
                <td>${d.sortOrder ?? 0}</td><td>${d.employeeCount ?? 0}</td>
                <td>${statusBadge(d.isActive)}</td>
                ${rowActions('editDesignation', 'deleteDesignation', d.id)}
            </tr>`);
        });
        refreshScopeRefOptions();
    }
    function editDesignation(id) {
        const d = (window._designations || []).find(x => x.id === id);
        if (!d) return;
        $('#desigFormTitle').text('Edit Designation');
        $('#desigId').val(d.id); $('#desigCode').val(d.code); $('#desigName').val(d.name);
        $('#desigDescription').val(d.description || ''); $('#desigSort').val(d.sortOrder ?? 0);
        $('#desigActive').prop('checked', d.isActive);
    }
    function resetDesignationForm() {
        $('#desigFormTitle').text('Add Designation');
        $('#desigId').val(0); $('#desigCode,#desigName,#desigDescription').val('');
        $('#desigSort').val(0); $('#desigActive').prop('checked', true);
    }
    async function saveDesignation() {
        const id = parseInt($('#desigId').val()) || 0;
        const dto = {
            Code: $('#desigCode').val().trim(), Name: $('#desigName').val().trim(),
            Description: $('#desigDescription').val().trim() || null,
            SortOrder: parseInt($('#desigSort').val()) || 0,
            IsActive: $('#desigActive').is(':checked')
        };
        if (!dto.Code || !dto.Name) { toastError('Code and name are required'); return; }
        const res = await fetch(`${API_BASE}/Designation${id ? '/' + id : ''}`, { method: id ? 'PUT' : 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(dto) });
        if (res.ok) { toastSuccess('Designation saved'); resetDesignationForm(); loadDesignations(); }
        else toastError(await apiError(res, 'Failed to save designation'));
    }
    async function deleteDesignation(id) {
        const d = (window._designations || []).find(x => x.id === id);
        if (!await confirmDelete(`Delete designation "${d ? esc(d.name) : id}"?`)) return;
        const res = await fetch(`${API_BASE}/Designation/${id}`, { method: 'DELETE' });
        if (res.ok) { toastSuccess('Designation deleted'); resetDesignationForm(); loadDesignations(); }
        else toastError(await apiError(res, 'Failed to delete designation'));
    }

    // ---- Grades ----
    async function loadGrades() {
        const res = await fetch(`${API_BASE}/HRGrade`);
        const data = res.ok ? await res.json() : [];
        window._grades = data;
        const body = $('#gradesBody'); body.empty();
        if (!data.length) { emptyRow(body, 8, 'No grades yet.'); return; }
        data.forEach(g => {
            body.append(`<tr>
                <td>${esc(g.code)}</td><td>${esc(g.name)}</td>
                <td class="text-end">${money(g.minSalary)}</td><td class="text-end">${money(g.maxSalary)}</td>
                <td>${g.sortOrder ?? 0}</td><td>${g.employeeCount ?? 0}</td>
                <td>${statusBadge(g.isActive)}</td>
                ${rowActions('editGrade', 'deleteGrade', g.id)}
            </tr>`);
        });
        refreshScopeRefOptions();
    }
    async function editGrade(id) {
        const g = (window._grades || []).find(x => x.id === id);
        if (!g) return;
        // The list DTO leaves out Description, so pull the full record for editing.
        const res = await fetch(`${API_BASE}/HRGrade/${id}`);
        const full = res.ok ? await res.json() : g;
        $('#gradeFormTitle').text('Edit Grade');
        $('#gradeId').val(full.id); $('#gradeCode').val(full.code); $('#gradeName').val(full.name);
        $('#gradeDescription').val(full.description || '');
        $('#gradeMinSalary').val(full.minSalary ?? ''); $('#gradeMaxSalary').val(full.maxSalary ?? '');
        $('#gradeSort').val(full.sortOrder ?? 0); $('#gradeActive').prop('checked', full.isActive);
    }
    function resetGradeForm() {
        $('#gradeFormTitle').text('Add Grade');
        $('#gradeId').val(0); $('#gradeCode,#gradeName,#gradeDescription,#gradeMinSalary,#gradeMaxSalary').val('');
        $('#gradeSort').val(0); $('#gradeActive').prop('checked', true);
    }
    async function saveGrade() {
        const id = parseInt($('#gradeId').val()) || 0;
        const min = $('#gradeMinSalary').val(), max = $('#gradeMaxSalary').val();
        const dto = {
            Code: $('#gradeCode').val().trim(), Name: $('#gradeName').val().trim(),
            Description: $('#gradeDescription').val().trim() || null,
            MinSalary: min !== '' ? parseFloat(min) : null,
            MaxSalary: max !== '' ? parseFloat(max) : null,
            SortOrder: parseInt($('#gradeSort').val()) || 0,
            IsActive: $('#gradeActive').is(':checked')
        };
        if (!dto.Code || !dto.Name) { toastError('Code and name are required'); return; }
        if (dto.MinSalary !== null && dto.MaxSalary !== null && dto.MinSalary > dto.MaxSalary) { toastError('Min salary cannot be greater than max salary'); return; }
        const res = await fetch(`${API_BASE}/HRGrade${id ? '/' + id : ''}`, { method: id ? 'PUT' : 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(dto) });
        if (res.ok) { toastSuccess('Grade saved'); resetGradeForm(); loadGrades(); }
        else toastError(await apiError(res, 'Failed to save grade'));
    }
    async function deleteGrade(id) {
        const g = (window._grades || []).find(x => x.id === id);
        if (!await confirmDelete(`Delete grade "${g ? esc(g.name) : id}"?`)) return;
        const res = await fetch(`${API_BASE}/HRGrade/${id}`, { method: 'DELETE' });
        if (res.ok) { toastSuccess('Grade deleted'); resetGradeForm(); loadGrades(); }
        else toastError(await apiError(res, 'Failed to delete grade'));
    }

    // ---- Holidays ----
    async function loadHolidays() {
        const year = $('#holidayFilterYear').val();
        const url = year ? `${API_BASE}/hr/holidays?year=${year}` : `${API_BASE}/hr/holidays`;
        const res = await fetch(url);
        const data = res.ok ? await res.json() : [];
        window._holidays = data;
        const body = $('#holidaysBody'); body.empty();
        if (!data.length) { emptyRow(body, 4, 'No holidays for this filter.'); return; }
        data.forEach(h => {
            body.append(`<tr>
                <td>${fmtDate(h.hDate)}</td><td>${esc(h.name)}</td>
                <td>${HOLIDAY_TYPE_NAMES[h.hType] || '-'}</td>
                ${rowActions('editHoliday', 'deleteHoliday', h.id)}
            </tr>`);
        });
    }
    function editHoliday(id) {
        const h = (window._holidays || []).find(x => x.id === id);
        if (!h) return;
        $('#holidayFormTitle').text('Edit Holiday');
        $('#holidayId').val(h.id); $('#holidayDate').val(h.hDate.split('T')[0]); $('#holidayName').val(h.name); $('#holidayType').val(h.hType);
    }
    function resetHolidayForm() {
        $('#holidayFormTitle').text('Add Holiday');
        $('#holidayId').val(0); $('#holidayDate,#holidayName').val(''); $('#holidayType').val(1);
    }
    async function saveHoliday() {
        const id = parseInt($('#holidayId').val()) || 0;
        const dto = { Id: id, HDate: $('#holidayDate').val(), Name: $('#holidayName').val().trim(), HType: parseInt($('#holidayType').val()), IsActive: true };
        if (!dto.HDate || !dto.Name) { toastError('Enter date and name'); return; }
        const res = await fetch(`${API_BASE}/hr/holidays${id ? '/'+id : ''}`, { method: id ? 'PUT' : 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(dto) });
        if (res.ok) { toastSuccess('Holiday saved'); resetHolidayForm(); loadHolidays(); }
        else toastError(await apiError(res, 'Failed to save holiday'));
    }
    async function deleteHoliday(id) {
        const h = (window._holidays || []).find(x => x.id === id);
        if (!await confirmDelete(`Delete holiday "${h ? esc(h.name) : id}"?`)) return;
        const res = await fetch(`${API_BASE}/hr/holidays/${id}`, { method: 'DELETE' });
        if (res.ok) { toastSuccess('Holiday deleted'); resetHolidayForm(); loadHolidays(); }
        else toastError(await apiError(res, 'Failed to delete holiday'));
    }
    async function copyHolidayYear() {
        const fromYear = parseInt($('#copyFromYear').val()), toYear = parseInt($('#copyToYear').val());
        if (!fromYear || !toYear) { toastError('Enter both years'); return; }
        const res = await fetch(`${API_BASE}/hr/holidays/copy-year`, { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({FromYear: fromYear, ToYear: toYear}) });
        if (res.ok) { const r = await res.json(); toastSuccess(`Copied ${r.copied} holiday(s)`); loadHolidays(); } else toastError('Copy failed');
    }

    // ---- Leave Types ----
    async function loadLeaveTypes() {
        const res = await fetch(`${API_BASE}/hr/leave-types?includeInactive=true`);
        const data = res.ok ? await res.json() : [];
        window._leaveTypes = data;
        const body = $('#leaveTypesBody'); body.empty();
        if (!data.length) { emptyRow(body, 7, 'No leave types yet.'); return; }
        data.forEach(l => {
            body.append(`<tr>
                <td>${esc(l.code)}</td><td>${esc(l.name)}</td><td>${l.isPaid ? 'Yes' : 'No'}</td>
                <td>${l.deductDays}</td><td>${l.maxPerYear ?? '-'}</td>
                <td>${statusBadge(l.isActive)}</td>
                ${rowActions('editLeaveType', 'deleteLeaveType', l.id)}
            </tr>`);
        });
    }
    function editLeaveType(id) {
        const l = (window._leaveTypes || []).find(x => x.id === id);
        if (!l) return;
        $('#leaveTypeFormTitle').text('Edit Leave Type');
        $('#ltId').val(l.id); $('#ltCode').val(l.code); $('#ltName').val(l.name);
        $('#ltDeductDays').val(l.deductDays); $('#ltMaxPerYear').val(l.maxPerYear ?? '');
        $('#ltIsPaid').prop('checked', l.isPaid); $('#ltActive').prop('checked', l.isActive);
    }
    function resetLeaveTypeForm() {
        $('#leaveTypeFormTitle').text('Add Leave Type');
        $('#ltId').val(0); $('#ltCode,#ltName,#ltMaxPerYear').val(''); $('#ltDeductDays').val(0);
        $('#ltIsPaid,#ltActive').prop('checked', true);
    }
    async function saveLeaveType() {
        const id = parseInt($('#ltId').val()) || 0;
        const maxPerYear = $('#ltMaxPerYear').val();
        const dto = {
            Code: $('#ltCode').val().trim(), Name: $('#ltName').val().trim(),
            IsPaid: $('#ltIsPaid').is(':checked'),
            DeductDays: parseFloat($('#ltDeductDays').val()) || 0,
            MaxPerYear: maxPerYear !== '' ? parseInt(maxPerYear) : null,
            IsActive: $('#ltActive').is(':checked')
        };
        if (!dto.Code || !dto.Name) { toastError('Code and name are required'); return; }
        const res = await fetch(`${API_BASE}/hr/leave-types${id ? '/' + id : ''}`, { method: id ? 'PUT' : 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(dto) });
        if (res.ok) { toastSuccess('Leave type saved'); resetLeaveTypeForm(); loadLeaveTypes(); }
        else toastError(await apiError(res, 'Failed to save leave type'));
    }
    async function deleteLeaveType(id) {
        const l = (window._leaveTypes || []).find(x => x.id === id);
        if (!await confirmDelete(`Delete leave type "${l ? esc(l.name) : id}"?`)) return;
        const res = await fetch(`${API_BASE}/hr/leave-types/${id}`, { method: 'DELETE' });
        if (res.ok) {
            // 204 = removed; 200 carries the "in use, deactivated instead" message.
            const note = res.status === 204 ? 'Leave type deleted' : await apiError(res, 'Leave type deleted');
            toastSuccess(note); resetLeaveTypeForm(); loadLeaveTypes();
        }
        else toastError(await apiError(res, 'Failed to delete leave type'));
    }

    // ---- Pay Components ----
    function toggleCalcFields() {
        const t = parseInt($('#compCalcType').val());
        $('#fldFormula').toggle(t === 7);
        $('#fldSlabs').toggle(t === 6);
        $('#fldRate').toggle(t !== 6);
        // 3, 8, 9 and 10 are all priced per minute of the salary; 4 and 11 per day.
        const perMinute = [3, 8, 9, 10].includes(t);
        const perDay = t === 4 || t === 11;
        $('#fldRateSource').toggle(perMinute || perDay);
        $('#fldBaseOn').toggle(t === 2 || perMinute || perDay || t === 6);
        $('#fldDivisorDays').toggle(perMinute || perDay);
        $('#leaveRuleHint').toggle(t === 11);
        $('#fldGrace').toggle(t === 3 || t === 8 || t === 9);
    }
    // Grade/Designation scopes pick from the lists on this page; Employee stays a raw id.
    function toggleScopeFields() {
        const s = parseInt($('#compScopeType').val());
        refreshScopeRefOptions();
        $('#compScopeRef').toggle(s === 2 || s === 3);
        $('#compScopeId').toggle(s === 4);
    }
    function refreshScopeRefOptions() {
        const s = parseInt($('#compScopeType').val());
        if (s !== 2 && s !== 3) return;
        const list = s === 2 ? (window._grades || []) : (window._designations || []);
        const current = $('#compScopeRef').val();
        const sel = $('#compScopeRef').empty().append('<option value="">-- select --</option>');
        list.forEach(x => sel.append(`<option value="${x.id}">${esc(x.code)} - ${esc(x.name)}</option>`));
        if (current) sel.val(current);
    }
    function scopeIdFromForm() {
        const s = parseInt($('#compScopeType').val());
        if (s === 2 || s === 3) return $('#compScopeRef').val() ? parseInt($('#compScopeRef').val()) : null;
        if (s === 4) return $('#compScopeId').val() ? parseInt($('#compScopeId').val()) : null;
        return null;
    }
    function scopeLabel(c) {
        const name = SCOPE_NAMES[c.scopeType] || '-';
        if (!c.scopeId) return name;
        const list = c.scopeType === 2 ? (window._grades || []) : c.scopeType === 3 ? (window._designations || []) : [];
        const match = list.find(x => x.id === c.scopeId);
        return match ? `${name}: ${esc(match.code)} - ${esc(match.name)}` : `${name} #${c.scopeId}`;
    }
    function parseSlabs() {
        const text = $('#compSlabsText').val().trim();
        if (!text) return [];
        return text.split('\n').filter(l => l.trim()).map(line => {
            const [from, to, amount, days, percent] = line.split(',').map(s => s.trim());
            return {
                FromValue: parseFloat(from) || 0,
                ToValue: to ? parseFloat(to) : null,
                Amount: amount ? parseFloat(amount) : null,
                Days: days ? parseFloat(days) : null,
                Percent: percent ? parseFloat(percent) : null
            };
        });
    }
    async function loadComponents() {
        const res = await fetch(`${API_BASE}/hr/pay-components`);
        const data = res.ok ? await res.json() : [];
        window._components = data;
        const body = $('#componentsBody'); body.empty();
        if (!data.length) { emptyRow(body, 7, 'No pay components yet.'); return; }
        data.forEach(c => {
            body.append(`<tr>
                <td>${esc(c.code)}</td><td>${esc(c.name)}</td><td>${KIND_NAMES[c.kind]}</td><td>${CALC_NAMES[c.calcType]}</td>
                <td>${scopeLabel(c)}</td>
                <td>${statusBadge(c.isActive)}</td>
                ${rowActions('editComponent', 'deleteComponent', c.id)}
            </tr>`);
        });
    }
    function editComponent(id) {
        const c = (window._components || []).find(x => x.id === id);
        if (!c) return;
        $('#compFormTitle').text('Edit Pay Component');
        $('#compId').val(c.id); $('#compCode').val(c.code); $('#compName').val(c.name);
        $('#compKind').val(c.kind); $('#compCalcType').val(c.calcType);
        $('#compScopeType').val(c.scopeType);
        toggleScopeFields();
        if (c.scopeType === 2 || c.scopeType === 3) $('#compScopeRef').val(c.scopeId || '');
        else $('#compScopeId').val(c.scopeId || '');
        $('#compRate').val(c.rate); $('#compRateSource').val(c.rateSource || 1); $('#compBaseOn').val(c.baseOn || 1);
        $('#compDivisorDays').val(c.divisorDays ?? 30); $('#compGrace').val(c.graceMinutes || 0);
        $('#compFreeUnits').val(c.freeUnitsPerMonth || ''); $('#compCapDay').val(c.capPerDay || '');
        $('#compCapMonth').val(c.capPerMonth || ''); $('#compPriority').val(c.priority || 0);
        $('#compFormula').val(c.formula || '');
        $('#compSlabsText').val((c.slabs || []).map(s => `${s.fromValue},${s.toValue ?? ''},${s.amount ?? ''},${s.days ?? ''},${s.percent ?? ''}`).join('\n'));
        $('#compEffFrom').val(c.effectiveFrom ? c.effectiveFrom.split('T')[0] : '');
        $('#compEffTo').val(c.effectiveTo ? c.effectiveTo.split('T')[0] : '');
        $('#compShowSlip').prop('checked', c.showOnPayslip); $('#compActive').prop('checked', c.isActive);
        toggleCalcFields();
    }
    function resetComponentForm() {
        $('#compFormTitle').text('Add Pay Component');
        $('#compId').val(0); $('#compCode,#compName,#compRate,#compFormula,#compSlabsText,#compScopeId,#compFreeUnits,#compCapDay,#compCapMonth').val('');
        $('#compKind,#compCalcType,#compScopeType,#compRateSource,#compBaseOn').val(1);
        $('#compScopeRef').val('');
        $('#compDivisorDays').val(30); $('#compGrace,#compPriority').val(0);
        $('#compEffFrom').val(toInputDate()); $('#compEffTo').val('');
        $('#compShowSlip,#compActive').prop('checked', true);
        toggleCalcFields();
        toggleScopeFields();
    }
    async function saveComponent() {
        const id = parseInt($('#compId').val()) || 0;
        const dto = {
            Id: id, Code: $('#compCode').val().trim(), Name: $('#compName').val().trim(),
            Kind: parseInt($('#compKind').val()), CalcType: parseInt($('#compCalcType').val()),
            Rate: $('#compRate').val() ? parseFloat($('#compRate').val()) : null,
            RateSource: parseInt($('#compRateSource').val()), BaseOn: parseInt($('#compBaseOn').val()),
            DivisorDays: parseInt($('#compDivisorDays').val()),
            GraceMinutes: $('#compGrace').val() ? parseInt($('#compGrace').val()) : null,
            FreeUnitsPerMonth: $('#compFreeUnits').val() ? parseFloat($('#compFreeUnits').val()) : null,
            CapPerDay: $('#compCapDay').val() ? parseFloat($('#compCapDay').val()) : null,
            CapPerMonth: $('#compCapMonth').val() ? parseFloat($('#compCapMonth').val()) : null,
            Slabs: parseSlabs(), Formula: $('#compFormula').val().trim() || null,
            ScopeType: parseInt($('#compScopeType').val()), ScopeId: scopeIdFromForm(),
            Priority: parseInt($('#compPriority').val()) || 0,
            ShowOnPayslip: $('#compShowSlip').is(':checked'),
            EffectiveFrom: $('#compEffFrom').val(), EffectiveTo: $('#compEffTo').val() || null,
            IsActive: $('#compActive').is(':checked')
        };
        if (!dto.Code || !dto.Name || !dto.EffectiveFrom) { toastError('Code, name and effective-from date are required'); return; }
        if (dto.ScopeType !== 1 && !dto.ScopeId) { toastError('Select what this component is scoped to'); return; }
        const res = await fetch(`${API_BASE}/hr/pay-components${id ? '/'+id : ''}`, { method: id ? 'PUT' : 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(dto) });
        if (res.ok) { toastSuccess('Pay component saved'); resetComponentForm(); loadComponents(); }
        else toastError(await apiError(res, 'Failed to save component'));
    }
    async function deleteComponent(id) {
        const c = (window._components || []).find(x => x.id === id);
        if (!await confirmDelete(`Delete pay component "${c ? esc(c.name) : id}"?`)) return;
        const res = await fetch(`${API_BASE}/hr/pay-components/${id}`, { method: 'DELETE' });
        if (res.ok) { toastSuccess('Pay component deleted'); resetComponentForm(); loadComponents(); }
        else toastError(await apiError(res, 'Failed to delete pay component'));
    }

    async function runPreview() {
        const id = parseInt($('#compId').val());
        if (!id) { toastError('Save (or select) the component first, then preview'); return; }
        const dto = {
            ComponentId: id,
            Basic: parseFloat($('#prevBasic').val()) || 0,
            Gross: parseFloat($('#prevGross').val()) || 0,
            LateMinutes: parseInt($('#prevLateMin').val()) || 0,
            LateCount: parseInt($('#prevLateCount').val()) || 0,
            AbsentDays: parseInt($('#prevAbsent').val()) || 0,
            OvertimeHours: 0,
            ShiftWorkHours: 8
        };
        const res = await fetch(`${API_BASE}/hr/pay-components/preview`, { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(dto) });
        if (res.ok) {
            const r = await res.json();
            $('#previewResult').show().html(`<strong>Amount: Rs ${Number(r.amount).toLocaleString(undefined,{minimumFractionDigits:2})}</strong><br/><span class="text-muted">${esc(r.explanation)}</span>`);
        } else toastError('Preview failed');
    }
</script>
}
