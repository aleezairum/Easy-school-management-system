@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    .select2-container--default .select2-selection--multiple {
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        padding: 6px 10px;
        min-height: 44px;
    }

    .select2-container--default.select2-container--focus .select2-selection--multiple {
        border-color: #008649;
        box-shadow: 0 0 0 4px rgba(0, 134, 73, 0.1);
    }

    .select2-container--default .select2-selection--multiple .select2-selection__choice {
        background: #008649;
        border: none;
        border-radius: 6px;
        color: white;
        padding: 4px 8px;
    }

    .select2-container--default .select2-selection--multiple .select2-selection__choice__remove {
        color: white;
        margin-right: 5px;
    }

    .password-masked {
        font-family: monospace;
        letter-spacing: 2px;
    }

    .badge-role {
        background: #e0f2fe;
        color: #0369a1;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 500;
        margin-right: 4px;
        margin-bottom: 4px;
        display: inline-block;
    }

    .loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255, 255, 255, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 100;
        border-radius: 16px;
    }

    .spinner-border {
        width: 3rem;
        height: 3rem;
        border-width: 0.3rem;
    }

    .form-section {
        background: #f8fafc;
        border-radius: 12px;
        padding: 24px;
    }

    .user-list-container {
        max-height: 400px;
        overflow-y: auto;
    }

        .user-list-container::-webkit-scrollbar {
            width: 8px;
        }

        .user-list-container::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 4px;
        }

        .user-list-container::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }

    .action-buttons {
        white-space: nowrap;
    }

        .action-buttons .btn {
            margin-right: 4px;
        }

            .action-buttons .btn:last-child {
                margin-right: 0;
            }

    .password-toggle {
        cursor: pointer;
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #64748b;
    }

        .password-toggle:hover {
            color: #1e293b;
        }

    .input-group-password {
        position: relative;
    }

        .input-group-password .form-control {
            padding-right: 40px;
        }
</style>

<!-- Include Select2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

<div class="container-fluid">
    <!-- Alert Messages -->
    <div id="alertContainer"></div>

    <!-- User Form Card -->
    <div class="card">
        <div class="card-body position-relative">
            <div id="loadingOverlay" class="loading-overlay" style="display: none;">
                <div class="spinner-border text-success" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>

            <!-- User Form -->
            <form id="userForm">
                <input type="hidden" id="userId" name="Id" value="0" />

                <div class="form-section mb-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="employeeId" class="form-label">Employee</label>
                            <select class="form-select" id="employeeId" name="EmployeeId">
                                <option value="">-- Select Employee (Optional) --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="userFullName" class="form-label">User Full Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="userFullName" name="UserFullName" placeholder="Enter full name" required />
                        </div>
                        <div class="col-md-6">
                            <label for="userLogin" class="form-label">User Login <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="userLogin" name="UserLogin" placeholder="Enter login username" required />
                        </div>
                        <div class="col-md-6">
                            <label for="userPassword" class="form-label">
                                User Password <span class="text-danger" id="passwordRequired">*</span>
                            </label>
                            <div class="input-group-password">
                                <input type="password" class="form-control" id="userPassword" name="Password" placeholder="Enter password" required />
                                <i class="bi bi-eye password-toggle" onclick="togglePassword()"></i>
                            </div>
                            <small class="text-muted" id="passwordHint" style="display: none;">Leave blank to keep existing password</small>
                        </div>
                        <div class="col-md-12">
                            <label for="userRoles" class="form-label">User Roles <span class="text-danger">*</span></label>
                            <select class="form-select" id="userRoles" name="RoleIds" multiple >
                            </select>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i> Submit
                        </button>
                        <button type="button" class="btn btn-secondary" onclick="cancelForm()">
                            <i class="bi bi-x-lg me-1"></i> Cancel
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- User List Card -->
    <div class="card">
        <div class="card-body">
            <div class="user-list-container">
                <div class="table-responsive">
                    <table class="table table-hover" id="usersTable">
                        <thead>
                            <tr>
                                <th>User Full Name</th>
                                <th>User Login</th>
                                <th>Password</th>
                                <th>User Role</th>
                                <th class="text-center" style="width: 150px;">Action</th>
                            </tr>
                        </thead>
                        <tbody id="usersBody">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Include Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>

        const USER_TYPE_LABELS = { 0: 'General', 1: 'Admin', 2: 'Teacher', 3: 'Accountant' };
        let editingUserId = 0;

        $(document).ready(function () {
            // Initialize Select2 for multi-select roles
            $('#userRoles').select2({
                theme: 'bootstrap-5',
                placeholder: 'Select roles...',
                allowClear: true,
                width: '100%'
            });

            loadRoles();
            loadUsers();
        });

        // ── Load roles into dropdown ──────────────────────────────────────────────
        async function loadRoles() {
            try {
                const response = await fetch(`${API_BASE}/RolesApi`);
                if (response.ok) {
                    const roles = await response.json();
                    const select = $('#userRoles');
                    select.empty();
                    roles.forEach(role => {
                        select.append(`<option value="${role.id}">${role.roleName}</option>`);
                    });
                    select.trigger('change');
                }
            } catch (error) {
                console.error('Error loading roles:', error);
            }
        }

        // ── Load all users ────────────────────────────────────────────────────────
        async function loadUsers() {
            showLoading();
            try {
                const response = await fetch(`${API_BASE}/SecUser`);
                if (response.ok) {
                    const users = await response.json();
                    renderUsersTable(users);
                } else {
                    showAlert('Failed to load users', 'danger');
                }
            } catch (error) {
                showAlert('Error loading users: ' + error.message, 'danger');
            } finally {
                hideLoading();
            }
        }

        // ── Render table ──────────────────────────────────────────────────────────
        function renderUsersTable(users) {
            const tbody = $('#usersBody');
            tbody.empty();

            if (users.length === 0) {
                tbody.html('<tr><td colspan="5" class="text-center text-muted py-4">No users found</td></tr>');
                return;
            }

            users.forEach(user => {
                const roleBadge = `<span class="badge-role">${USER_TYPE_LABELS[user.userType] ?? 'General'}</span>`;

                const row = `
                    <tr data-user-id="${user.vid}">
                        <td><strong>${user.userFullName}</strong></td>
                        <td>${user.userLogin}</td>
                        <td class="password-masked">••••••••</td>
                        <td>${roleBadge}</td>
                        <td class="text-center action-buttons">
                            <button type="button" class="btn btn-warning btn-sm" onclick="editUser(${user.vid})" title="Edit">
                                <i class="bi bi-pencil"></i> Edit
                            </button>
                            <button type="button" class="btn btn-danger btn-sm" onclick="deleteUser(${user.vid})" title="Delete">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </td>
                    </tr>`;
                tbody.append(row);
            });
        }

        // ── Edit user ─────────────────────────────────────────────────────────────
        async function editUser(id) {
            showLoading();
            try {
                const response = await fetch(`${API_BASE}/SecUser/${id}`);
                if (response.ok) {
                    const user = await response.json();
                    populateForm(user);
                    editingUserId = id;
                    setEditMode(true);
                    $('html, body').animate({ scrollTop: 0 }, 'slow');
                } else {
                    showAlert('Failed to load user details', 'danger');
                }
            } catch (error) {
                showAlert('Error loading user: ' + error.message, 'danger');
            } finally {
                hideLoading();
            }
        }

        // ── Delete user ───────────────────────────────────────────────────────────
        async function deleteUser(id) {
            if (!await confirmDelete('Are you sure you want to delete this user?')) return;

            showLoading();
            try {
                const response = await fetch(`${API_BASE}/SecUser/${id}`, { method: 'DELETE' });
                if (response.ok) {
                    const result = await response.json();
                    if (result.returnCode === 200) {
                        showAlert('User deleted successfully!', 'success');
                        await loadUsers();
                    } else {
                        showAlert(result.returnMessage || 'Failed to delete user', 'danger');
                    }
                } else {
                    showAlert('Failed to delete user', 'danger');
                }
            } catch (error) {
                showAlert('Error deleting user: ' + error.message, 'danger');
            } finally {
                hideLoading();
            }
        }

        // ── Populate form ─────────────────────────────────────────────────────────
        function populateForm(user) {
            $('#userId').val(user.vid);
            $('#employeeId').val(user.employeeID || '');
            $('#userFullName').val(user.userFullName);
            $('#userLogin').val(user.userLogin);
            $('#userPassword').val('');
            $('#userRoles').val([String(user.userType)]).trigger('change');
        }

        // ── Edit mode toggle ──────────────────────────────────────────────────────
        function setEditMode(isEdit) {
            if (isEdit) {
                $('#passwordRequired').hide();
                $('#passwordHint').show();
                $('#userPassword').prop('required', false);
            } else {
                $('#passwordRequired').show();
                $('#passwordHint').hide();
                $('#userPassword').prop('required', true);
            }
        }

        // ── Cancel / reset form ───────────────────────────────────────────────────
        function cancelForm() {
            $('#userId').val('0');
            $('#employeeId').val('');
            $('#userFullName').val('');
            $('#userLogin').val('');
            $('#userPassword').val('');
            $('#userRoles').val([]).trigger('change');
            editingUserId = 0;
            setEditMode(false);
        }

        // ── Form submit ───────────────────────────────────────────────────────────
        $('#userForm').on('submit', async function (e) {
            e.preventDefault();

            const id = parseInt($('#userId').val()) || 0;
            const password = $('#userPassword').val().trim();
            const selectedRoles = $('#userRoles').val();

            if (id === 0 && !password) {
                showAlert('Password is required for new users', 'danger');
                $('#userPassword').focus();
                return;
            }

            const userType = selectedRoles && selectedRoles.length > 0 ? parseInt(selectedRoles[0]) : 0;

            const data = {
                VID: id,
                EmployeeID: null,
                UserFullName: $('#userFullName').val().trim(),
                UserLogin: $('#userLogin').val().trim(),
                UserPassword: password || null,
                UserType: 0,
                IsAdmin: false,
                AllowAudit: false,
                AllowActual: false,
                IsIndividual: false,
                DefaultCompanyID: 1,
                DefaultFinancialYearID: 1,
                UserSecFlage: 0,
                MacAddress: null,
                ComputerName: null,
                WindowLoginName: null,
                IsActive: true
            };

            showLoading();
            try {
                const response = await fetch(`${API_BASE}/SecUser`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    const result = await response.json();
                    if (result.returnCode === 200) {
                        showAlert(id === 0 ? 'User created successfully!' : 'User updated successfully!', 'success');
                        cancelForm();
                        await loadUsers();
                    } else {
                        showAlert(result.returnMessage || 'Failed to save user', 'danger');
                    }
                } else {
                    const error = await response.json();
                    showAlert(error.message || 'Failed to save user', 'danger');
                }
            } catch (error) {
                showAlert('Error saving user: ' + error.message, 'danger');
            } finally {
                hideLoading();
            }
        });

        // ── Toggle password visibility ────────────────────────────────────────────
        function togglePassword() {
            const input = $('#userPassword');
            const icon = $('.password-toggle');
            if (input.attr('type') === 'password') {
                input.attr('type', 'text');
                icon.removeClass('bi-eye').addClass('bi-eye-slash');
            } else {
                input.attr('type', 'password');
                icon.removeClass('bi-eye-slash').addClass('bi-eye');
            }
        }

        // ── Helpers ───────────────────────────────────────────────────────────────
        function showLoading() { $('#loadingOverlay').show(); }
        function hideLoading() { $('#loadingOverlay').hide(); }

        function showAlert(message, type) {
            if (type === 'success') toastSuccess(message);
            else if (type === 'danger' || type === 'error') toastError(message);
            else if (type === 'warning') toastWarning(message);
            else toastInfo(message);
        }
    </script>
}
