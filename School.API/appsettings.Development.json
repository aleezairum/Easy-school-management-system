{
  // Local development only. This file is read when ASPNETCORE_ENVIRONMENT is
  // "Development" (which launchSettings.json sets for dotnet run / F5) and is
  // ignored in Production, so the live server keeps using appsettings.json.
  //
  // The connection string is here because appsettings.json holds the LIVE
  // server's sa password, which the local SQL Server rejects — the app still
  // starts and answers HTTP, then every data endpoint returns 500 with
  // "Login failed for user 'sa'" (SQL error 18456) in the log.
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=EasySchoolDB;User Id=sa;Password=786;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
