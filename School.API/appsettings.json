  // Binds every network interface rather than the loopback only, for when the
  // API is run directly (dotnet run / dotnet School.API.dll).
  // launchSettings.json says "http://localhost:5266", which listens on
  // 127.0.0.1 ONLY, so the API would answer http://localhost:5266 but refuse
  // http://<lan-ip>:5266 even from the same machine — and a browser reports that
  // refusal as a CORS error, because a request that got no response cannot carry
  // an Access-Control-Allow-Origin header.
  //
  // NOTE: under IIS this key is IGNORED — web.config uses hostingModel
  // "inprocess", so the address and port come from the IIS site bindings. On the
  // live server, change the port there, not here.
  "Urls": "http://0.0.0.0:5266",

  // Signs every API token: the mobile app's (AppTokenIssuer) and the web
  // portal's (School.Web signs one for the signed-in office user - the SAME
  // key must be in School.Web/appsettings.json). Changing it signs everyone out.
  // RequireForWebApi: the API refuses web-portal calls without that token.
  // false = the old open behaviour (emergency switch only).
  "Jwt": {
