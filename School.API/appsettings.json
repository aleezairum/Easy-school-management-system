  // Meta WhatsApp Business Cloud API (official).
  // PhoneNumberId + AccessToken come from Meta Business Manager. Use a System
  // User token — the default token expires after 24 hours.
  // Templates: map each SmsMessageType to the template name approved in Meta.
  // Leave a Name blank to keep that type on free-form text.
  "MetaWhatsApp": {
    "BaseUrl": "https://graph.facebook.com",
    "ApiVersion": "v21.0",
    "PhoneNumberId": "1190056957530326",
    "AccessToken": "EAAf7TPLFlRYBSKhqElFdNvGI9XLlyuUjFACgjIoU0wdPpQ33mCD2lLWa0ZCA7eQgIjw5jdjn7UbC5EVGYVidjvBrT4xTTlqqCK2wjvLD4kpRVkktqXLKmaf6FnJQtqap6NWxKin7DrtTLnHdMZA4XiGdUPLxRT69BtcII9It5VuUKgCrP4co6hTsRTVgZDZD",
    "CountryCode": "92",
    "DefaultLanguage": "en",
    "VerifyToken": "",
    // App Dashboard -> App settings -> Basic -> App Secret.
    // Verifies the X-Hub-Signature-256 on every incoming webhook, which is the
    // only thing proving a POST really came from Meta. While this is empty the
    // signature is NOT checked and anyone who knows the callback URL can inject
    // messages into parents' chat threads — and now trigger auto-replies too.
    "AppSecret": "",
    "Templates": {
      // {{1}} Student Name, {{2}} Class
      "Absent": { "Name": "absent_notification", "Language": "en" },
      // No approved template yet — keeps going out as free-form text.
      "Late": { "Name": "", "Language": "en" },
      // {{1}} Student Name, {{2}} Class, {{3}} Fee Detail, {{4}} Total, {{5}} Due Date
      "Fee": { "Name": "fee_reminder", "Language": "en" },
      // No approved template yet — keeps going out as free-form text.
      "Result": { "Name": "", "Language": "en" },
      // {{1}} Student Name, {{2}} Class — header is a Document (the PDF)
      "Rcard": { "Name": "result_card", "Language": "en" }
    }
  },
  // Self-service menu on incoming WhatsApp messages. A number registered
  // against a student is offered dues / voucher / ledger / result / attendance;
  // any other number gets the general enquiry menu. Set Enabled to false to
  // stop all automatic replies without removing the code.
  //
  // SchoolName is the school's COMPLETE name — it heads every reply, so an
  // abbreviation here shows up on every message a parent keeps or forwards.
  //
  // The fee schedule and the school timings are NOT configured here: they are
  // read live from SMSFeeStructure and the HR timing calendar, so they follow
  // whatever the office enters. Only what the database has no place for sits
  // below, and every key is optional — the defaults in WhatsAppBotService are
  // what ships if a key is missing.
  // The EasySchool mobile app (Controllers/MobileApp, Scripts/MobileApp.sql).
  // SchoolCode is what parents type on first launch; it must match this
  // school's entry in the EasySchool school directory.
  // PublicApiUrl is this API's address on the internet (https://... without
  // /api); a push notification shows the announcement's picture from it.
  // The Android app is given out as an APK (no Play Store): when a new one is
  // copied to the web server (School.Web MobileApp:ApkFile), raise
  // LatestVersion to its version and every phone offers the update from
  // DownloadUrl; raise MinVersion too to stop older ones working at all.
  "App": {
    "SchoolCode": "SSMHS",
    "TokenDays": 60,
    "MinVersion": "1.0.0",
    "LatestVersion": "1.0.2",
    "DownloadUrl": "https://school.easypos.com.pk/EasySchool/app",
    "LogoUrl": "",
    "PublicApiUrl": "https://school.easypos.com.pk"
  },
  // Push notifications to the app (Firebase Cloud Messaging). Every school's
  // API uses the ONE EasySchool Firebase project. ServiceAccountFile is the
  // JSON from Firebase console -> Project settings -> Service accounts ->
  // Generate new private key; a relative path is next to School.API.dll. Keep
  // that file out of git. Each announcement is pushed once, on its start day.
  "Firebase": {
    "Enabled": false,
    "ProjectId": "",
    "ServiceAccountFile": "firebase-service-account.json"
  },
  "WhatsAppBot": {
    // Off since October 2026: Meta now charges for service replies beyond the
    // first 1,000 a month. Parents' messages are still received and shown in
    // WhatsApp Chat; the office can still answer them by hand.
    "Enabled": false,
    "SchoolName": "SIR SYED MODEL HIGH SCHOOL (BOYS & GIRLS)",
    // Quoted only when the campus is not known — an enquiry from a number the
    // school has never seen. A registered parent is given their own campus's
    // number from the list below.
    "OfficePhone": "0301-7330101",
    "Address": "Chhonawala Road, Hasilpur",
    "WhatsAppNumber": "0301-6591766",
    "Email": "",
    "Website": "",
    // One line per campus. Id is SMSCampus.VID — the value Employees.CampusID
    // and SMSStudent.CampusID carry — and Name is here only so a human can
    // check the id is the right one. Confirm with:
    //     SELECT VID, VName FROM SMSCampus;
    "Campuses": [
      { "Id": 1, "Name": "Boys Campus", "Phone": "0301-7330101" },
      { "Id": 2, "Name": "Girls Campus", "Phone": "0301-6591766" }
    ],
    // Paste the school's own Google Maps share link here (Maps -> Share ->
    // Copy link). While it is empty the bot sends a Maps SEARCH for
    // "<SchoolName> <Address>", which opens the right place but is not a pin.
    "MapUrl": "",
    // Staff messaging from their own number (Employees.Mobile / Phone) get a
    // staff menu: attendance card and salary slip for this and last month, and
    // a teacher's latest term result, as PDF. A number that is both a parent's
    // and staff gets both menus (parents 1-8, staff 11-16).
    "Staff": {
      "Enabled": true,
      // true: staff also get the slip of a payroll still in Draft, marked
      // "PROOF READ ONLY" (a Draft is regenerated whenever attendance changes,
      // so it can still change). The mark goes once the run is LOCKED
      // (Generate Payroll -> Review -> Lock Run). false: only locked slips.
      "SendDraftSalarySlips": true
    },
    "Admission": {
      // Set to true when admissions reopen and the reply switches back to the
      // documents list.
      "Open": false,
      "OpensOn": "January 2027",
      "Highlights": [
        "From the next academic year a Computer class will also start for Pre-Ninth."
      ]
    },
    // Printed at the foot of the fee-structure PDF.
    "FeeNotes": [
      "Fee of newly admitted students from class 4 to 10 is charged according to the grade attained in the admission test. It is increased or reduced in sequel of average performance in all next internal terms.",
      "No concession will be given in admission fee.",
      "This schedule is for the current academic session only and is revised every year."
    ],
    // Shown under "Contact & About Us" — the publicity lines.
    "About": [
      "Separate Boys and Girls campuses, Play Group to Matric (10th)",
      "Merit-based monthly fee — a higher grade pays a lower fee",
      "Regular internal terms, result cards and parent-teacher meetings",
      "Qualified and experienced teaching staff",
      "Fee voucher, ledger, result and attendance available on WhatsApp"
    ]
  },
  // Face-attendance machines (Hikvision). Nothing happens until a machine is
  // added on Staff & Payroll -> Attendance Machines.
  "Hikvision": {
    // Read each machine's punches this often, in case a push was missed.
    "PullEnabled": true,
    "PullIntervalSeconds": 60,
    // A second staff punch this many minutes after the first is the time out;
    // sooner, it is the same arrival tapped twice.
    "OutGapMinutes": 30,
    // Keep the machines' clocks on the server's: every ClockCheckMinutes each
    // machine is read and, if more than ClockMaxDriftSeconds off, set right.
    "ClockAutoCorrect": true,
    "ClockCheckMinutes": 60,
    "ClockMaxDriftSeconds": 30
  },
  // Which SmsMessageType values go out free through WAHA vs Meta (paid).
  // Set Enabled=false to send everything through Meta only (old behavior).
  "SmsRouting": {
    "Enabled": true,
    "WahaMessageTypes": [ "Absent", "Fee" ]
  }
}
