<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules runAllManagedModulesForAllRequests="false">
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- stdoutLogEnabled is ON so a startup failure is readable. Without it IIS
           shows only "HTTP Error 500.30 - ASP.NET Core app failed to start" and
           the actual exception is lost. Logs land in .\logs\stdout_*.log next to
           the published app; create the logs folder if it is not there.
           Turn this back off once the app is starting cleanly — these files are
           never truncated and grow for as long as it is enabled. -->
      <aspNetCore processPath="dotnet" arguments=".\School.API.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
